{
  // Skeleton content pack. This document is the AI-open surface: everything a
  // generator may produce is expressible here, and everything here is validated
  // by `rts lint` before any simulation runs. JSON-with-comments in the skeleton;
  // YAML is a loader swap once external packages are in play.
  "meta": { "name": "skeleton-pack", "version": 1 },

  "damageTypes": ["cannon", "hmg", "rifle"],
  "armorClasses": ["infantry", "light_vehicle", "heavy_vehicle"],

  // The counter-matrix seed: damage type vs armor class multipliers.
  "damageVsArmor": {
    "cannon": { "infantry": 0.25, "light_vehicle": 1.25, "heavy_vehicle": 1.0 },
    "hmg":    { "infantry": 1.5,  "light_vehicle": 1.0,  "heavy_vehicle": 0.4 },
    "rifle":  { "infantry": 1.0,  "light_vehicle": 0.5,  "heavy_vehicle": 0.15 }
  },

  "weapons": {
    "crusader_cannon":     { "damageType": "cannon", "damage": 60, "range": 9.0, "cooldownTicks": 36, "spread": 0.1 },
    "battlemaster_cannon": { "damageType": "cannon", "damage": 65, "range": 9.5, "cooldownTicks": 40, "spread": 0.1 },
    "technical_hmg":       { "damageType": "hmg",    "damage": 14, "range": 8.5, "cooldownTicks": 9,  "spread": 0.1 },
    "ranger_rifle":        { "damageType": "rifle",  "damage": 10, "range": 8.0, "cooldownTicks": 15, "spread": 0.1 },
    "laser_cannon":        { "damageType": "cannon", "damage": 75, "range": 10.0, "cooldownTicks": 36, "spread": 0.02 }
  },

  // Veterancy: thresholds in XP (kills award victimCost/10), rank bundles are
  // cumulative lists of modifiers through the same algebra as upgrades/perks.
  "veterancyTracks": {
    "vehicle_default": {
      "thresholds": [100, 300],
      "ranks": [
        [ { "stat": "Damage", "op": "Mul", "value": 1.10 } ],
        [ { "stat": "Damage", "op": "Mul", "value": 1.15 },
          { "stat": "ArmorFactor", "op": "Mul", "value": 0.85 } ]
      ]
    },
    "infantry_default": {
      "thresholds": [60, 180],
      "ranks": [
        [ { "stat": "Damage", "op": "Mul", "value": 1.10 } ],
        [ { "stat": "CooldownScale", "op": "Mul", "value": 0.85 } ]
      ]
    }
  },

  // Tech DAG: lint checks acyclicity and reference integrity, and the nodes now
  // drive production — researching a node (cost, researchTicks) through a team's
  // research queue is what unlocks units that list it as a prerequisite.
  "tech": {
    "nodes": {
      "barracks":        { "requires": [],              "cost": 500,  "researchTicks": 600 },
      "war_factory":     { "requires": [],              "cost": 2000, "researchTicks": 1200 },
      "strategy_center": { "requires": ["war_factory"], "cost": 2500, "researchTicks": 1500 }
    }
  },

  "units": {
    "ranger": {
      "faction": "usa", "cost": 300, "buildTicks": 150, "prerequisites": ["barracks"],
      "components": {
        "Health": { "max": 120, "armorClass": "infantry" },
        "Mobile": { "speed": 5.0 },
        "WeaponBearer": { "weapon": "ranger_rifle" },
        "VeterancyCarrier": { "track": "infantry_default" }
      }
    },
    "technical": {
      "faction": "gla", "cost": 600, "buildTicks": 300, "prerequisites": [],
      "components": {
        "Health": { "max": 200, "armorClass": "light_vehicle" },
        "Mobile": { "speed": 7.5 },
        "WeaponBearer": { "weapon": "technical_hmg" },
        "VeterancyCarrier": { "track": "vehicle_default" }
      }
    },
    "crusader": {
      "faction": "usa", "cost": 900, "buildTicks": 450, "prerequisites": ["war_factory"],
      "components": {
        "Health": { "max": 480, "armorClass": "heavy_vehicle" },
        "Mobile": { "speed": 4.2 },
        "WeaponBearer": { "weapon": "crusader_cannon" },
        "VeterancyCarrier": { "track": "vehicle_default" }
      }
    },
    "battlemaster": {
      "faction": "china", "cost": 800, "buildTicks": 400, "prerequisites": ["war_factory"],
      "components": {
        "Health": { "max": 440, "armorClass": "heavy_vehicle" },
        "Mobile": { "speed": 3.8 },
        "WeaponBearer": { "weapon": "battlemaster_cannon" },
        "VeterancyCarrier": { "track": "vehicle_default" }
      }
    },
    // Authored as a full unit but absent from every base roster: it exists so the
    // laser general can swap it in. Units and rosters are separate concerns.
    "laser_crusader": {
      "faction": "usa", "cost": 1100, "buildTicks": 500, "prerequisites": ["strategy_center"],
      "components": {
        "Health": { "max": 460, "armorClass": "heavy_vehicle" },
        "Mobile": { "speed": 4.2 },
        "WeaponBearer": { "weapon": "laser_cannon" },
        "VeterancyCarrier": { "track": "vehicle_default" }
      }
    }
  },

  // Factions layer: a base faction lists a roster, a general extends one and applies
  // a patch. `add`/`remove` do roster surgery; `modify` produces a faction-local
  // variant of an inherited unit through the same modifier algebra as veterancy.
  // A general is therefore a readable diff against its parent, not a copied roster.
  "factions": {
    "usa":   { "units": ["ranger", "crusader"] },
    "gla":   { "units": ["technical"] },
    "china": { "units": ["battlemaster"] },

    // Roster surgery: drops the stock Crusader for the laser variant.
    "usa_laser": {
      "extends": "usa",
      "remove": ["crusader"],
      "add": ["laser_crusader"]
    },

    // Stat patch: same Battlemaster, cheaper and tougher. Produces the
    // faction-local prototype 'china_tank/battlemaster'.
    "china_tank": {
      "extends": "china",
      "modify": {
        "battlemaster": {
          "cost": 750,
          "buildTicks": 380,
          "modifiers": [
            { "stat": "ArmorFactor", "op": "Mul", "value": 0.85 },
            { "stat": "MaxHp",       "op": "Add", "value": 40 }
          ]
        }
      }
    }
  },

  // Bridge to the Zero Hour target. Our vocabulary is open where theirs is closed, so the
  // mapping is declared rather than guessed — and lint checks it before the engine does.
  //
  //   rts compile --target zh --out build/zh-mod
  //
  // Models are adopted from what the archives already ship. The measured claim is that
  // 2,928 of 9,000 (32.9%) are referenced by no INI at all — but "unreferenced" is a
  // double-edged property: free of conflicts AND free of guidance, because a mesh nobody
  // uses is a mesh with no contract to copy. Geometry, weapon bones, the muzzle-flash
  // sub-object and whether it has a turret must then all be guessed, and each fails
  // silently. `tools/zhasset artprofile` measures the 971 meshes retail DOES use; prefer
  // those, and `rts compile` will derive the whole contract for you.
  // Adopting art is a development accelerator, not a distribution plan — the mod ships only
  // OUR files, over the player's own install.
  "zh": {
    // Their DamageType is a closed 38-value C++ enum; an unknown name is a load error.
    "damageTypes": {
      "cannon": "ARMOR_PIERCING",
      "hmg":    "GATTLING",
      "rifle":  "SMALL_ARMS"
    },
    // Their world units run about 16x ours (a Crusader's 150 range against our 9).
    "worldScale": 16.0,
    "models": {
      "ranger":         "AVAmbulance",
      "technical":      "AVBATTLEDR",
      // AVLeopard is what the retail Crusader actually uses. "AVCrusader" exists as a FILE
      // but no object references it, so it has no measured profile — it was chosen by name,
      // which is exactly the trap.
      "crusader":       "AVLeopard",
      "battlemaster":   "AVLeopard",
      "laser_crusader": "AVAVNGER"
    }
  },

  "lint": { "dpsPer1000CostBand": [20, 200] }
}
