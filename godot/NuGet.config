<?xml version="1.0" encoding="utf-8"?>
<!--
  The repo root NuGet.config clears all package sources: the sim core must stay
  package-agnostic, and an empty source list makes an accidental PackageReference
  a build error rather than a silent dependency.

  Presentation is explicitly allowed to depend on things (see CLAUDE.md), and
  Godot.NET.Sdk is a package. NuGet merges configs nearest-first, so re-adding the
  source here restores restore for godot/ and nothing above it — the guard still
  holds for RtsSkeleton.csproj and everything the harness builds.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
