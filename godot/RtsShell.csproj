<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RootNamespace>RtsShell</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Presentation depends on the sim, never the reverse. The sim project stays
         package-agnostic; everything Godot-shaped lives on this side of the line. -->
