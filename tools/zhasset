        "WeaponSet": "unit.components.WeaponBearer.weapon",
        "Locomotor": "unit.components.Mobile.speed",
        "ExperienceValue": "veterancyTracks", "ExperienceRequired": "veterancyTracks.thresholds",
        "Side": "unit.faction",
        "KindOf": "unit.kindOf",                       # role flags, consulted by production+defeat
        "BuildCompletion": "unit.buildCompletion",     # structure vs unit
        "EnergyProduction": "unit.energyProduction",   # brownout halts production
        "MaxSimultaneousOfType": "unit.maxSimultaneousOfType",
        # Deliberately unmapped: no system consumes them yet, and a field that does
