TARGET_TABLES = {
    "Object": "ThingTemplate::s_objectFieldParseTable",
    "Weapon": "WeaponTemplate::TheWeaponTemplateFieldParseTable",
    "Locomotor": "TheFieldParse",
    "PlayerTemplate": "TheFieldParseTable",
}


CAMEL_RE = re.compile(r'[A-Z]+(?![a-z])|[A-Z][a-z0-9]*|[a-z0-9]+')


def words(name):
    """Split a CamelCase field name into lowercase words.

    Naive substring matching is wrong here and it was wrong in a way that FLATTERED us:
    "StartingBuilding", "StartMoney" and StartingUnit0-9 all contain the substring "art"
    (St-art-ing), so twelve of the most load-bearing PlayerTemplate fields were being
    classified as art and dropped from the sim denominator. A smaller denominator is a
    higher coverage percentage, so the bug inflated the only number we steer by.
    """
    return [w.lower() for w in CAMEL_RE.findall(name)]


def classify(name):
    ws = set(words(name))
    if ws & AUDIO_HINTS: return "audio"
    if ws & UI_HINTS: return "ui"
    if ws & ART_HINTS: return "art"
    return "sim"


def cmd_coverage(a):
    schema = json.load(open(os.path.join(a.out, "zh-schema.json")))
    tables = schema["tables"]

    def find(tname, filehint):
        for k, v in tables.items():
            if v["table"] == tname and filehint.lower() in v["file"].lower():
                return v
        return None

    targets = [
        ("Object", find("ThingTemplate::s_objectFieldParseTable", "ThingTemplate.cpp")),
        ("Weapon", find("WeaponTemplate::TheWeaponTemplateFieldParseTable", "Weapon.cpp")),
        ("Locomotor", find("TheFieldParse", "Locomotor.cpp")),
        ("PlayerTemplate", find("TheFieldParseTable", "PlayerTemplate.cpp")),
    ]

    print("Coverage of ZH's content model. THEIR schema is the target; ours adapts to it.")
    print("Presentation fields are excluded from the denominator — we do not inherit art.\n")
    print(f"  {'content type':16s} {'sim':>5s} {'have':>5s} {'cov':>6s}   {'art':>5s} {'audio':>6s} {'ui':>4s}  total")
    print("  " + "-" * 72)

    grand_sim = grand_have = 0
    gaps = defaultdict(list)
    for label, tbl in targets:
        if not tbl:
            print(f"  {label:16s}  (table not found in extracted schema)")
            continue
        buckets = Counter()
        sim_fields = []
        for f in tbl["fields"]:
            c = classify(f["field"])
            buckets[c] += 1
            if c == "sim":
                sim_fields.append(f["field"])
        mapped = OURS.get(label, {})
        have = sum(1 for f in sim_fields if mapped.get(f))
        for f in sim_fields:
            if not mapped.get(f):
                gaps[label].append(f)
        grand_sim += len(sim_fields); grand_have += have
        cov = 100.0 * have / max(1, len(sim_fields))
        print(f"  {label:16s} {len(sim_fields):5d} {have:5d} {cov:5.1f}%   "
              f"{buckets['art']:5d} {buckets['audio']:6d} {buckets['ui']:4d}  {tbl['fieldCount']:5d}")

    print("  " + "-" * 72)
    print(f"  {'TOTAL':16s} {grand_sim:5d} {grand_have:5d} "
          f"{100.0*grand_have/max(1,grand_sim):5.1f}%")

    if a.gaps:
        print("\nUnimplemented sim fields (the roadmap, in their vocabulary):")
        for label, fs in gaps.items():
            print(f"\n  {label} ({len(fs)}):")
            for i in range(0, len(fs), 4):
                print("     " + "  ".join(f"{x:22s}" for x in fs[i:i + 4]))
    return 0


# ---------------------------------------------------------------- show
# ============================================================================================
# .map — the terrain format
#
# EA's DataChunk container (Common/System/DataChunk.cpp), NOT the W3D one, though the family
# resemblance is close: a symbol table maps chunk names to ids, then (id, version, size)
# records that nest. Two differences worth remembering because both bite:
#   - the size field is honest; there is no high-bit container marker as in W3D. Nesting is
#     implied by the parser that is registered, not by the bytes.
#   - dict KEYS are entries in the same symbol table as chunk names, so the table cannot be
#     written until the body is, and a dict key you never used is not in it.
#
# Files may be refpack-compressed behind an "EAR\0" + uint32-length header. They may equally
# well be raw: CachedFileInputStream::open sniffs and falls through. Several shipped maps are
# raw, which is what lets our writer skip having a compressor at all.
# ============================================================================================

def refpack_decode(src):
    """EA refpack, transcribed from Libraries/Source/Compression/EAC/refdecode.c."""
    out = bytearray()
    t = (src[0] << 8) | src[1]; s = 2
    ssize = 4 if (t & 0x8000) else 3
    if t & 0x100:
        s += ssize                     # a compressed-size field we do not need
    ulen = 0
    for _ in range(ssize):
        ulen = (ulen << 8) | src[s]; s += 1
    while True:
        first = src[s]; s += 1
        if not (first & 0x80):                                   # short form
            second = src[s]; s += 1
            run = first & 3
            out += src[s:s+run]; s += run
            ref = len(out) - 1 - (((first & 0x60) << 3) + second)
            for _ in range(((first & 0x1c) >> 2) + 3):
                out.append(out[ref]); ref += 1
        elif not (first & 0x40):                                 # int form
            second, third = src[s], src[s+1]; s += 2
            run = second >> 6
            out += src[s:s+run]; s += run
            ref = len(out) - 1 - (((second & 0x3f) << 8) + third)
            for _ in range((first & 0x3f) + 4):
                out.append(out[ref]); ref += 1
        elif not (first & 0x20):                                 # very long form
            second, third, forth = src[s], src[s+1], src[s+2]; s += 3
            run = first & 3
            out += src[s:s+run]; s += run
            ref = len(out) - 1 - ((((first & 0x10) >> 4) << 16) + (second << 8) + third)
            for _ in range((((first & 0x0c) >> 2) << 8) + forth + 5):
                out.append(out[ref]); ref += 1
        else:
            run = ((first & 0x1f) << 2) + 4
            if run <= 112:                                       # literal
                out += src[s:s+run]; s += run
                continue
            run = first & 3                                      # eof + 0..3 literal
            out += src[s:s+run]; s += run
            break
    if len(out) != ulen:
        raise ValueError(f"refpack: produced {len(out)} bytes, header claims {ulen}")
    return bytes(out)


def map_load(path):
    """CompressionManager::getCompressionType sniffs a 4-byte magic; anything unrecognised is
    COMPRESSION_NONE and read as-is. We handle the two families that actually ship in maps."""
    d = open(path, "rb").read()
    if d[:4] == b"EAR\0":
        return refpack_decode(d[8:]), "refpack"
    if d[:2] == b"ZL" and d[2:3].isdigit() and d[3:4] == b"\0":
        return zlib.decompress(d[8:]), "zlib"          # ZL1..ZL9, one magic per zlib level
    if d[:4] == b"CkMp":
        return d, "raw"
    raise ValueError(f"{os.path.basename(path)}: not a map ({d[:4]!r})")


class MapReader:
    def __init__(self, b):
        self.b = b; self.p = 0
    def u8(self):  v = self.b[self.p]; self.p += 1; return v
    def u16(self): v, = struct.unpack_from("<H", self.b, self.p); self.p += 2; return v
    def i32(self): v, = struct.unpack_from("<i", self.b, self.p); self.p += 4; return v
    def u32(self): v, = struct.unpack_from("<I", self.b, self.p); self.p += 4; return v
    def f32(self): v, = struct.unpack_from("<f", self.b, self.p); self.p += 4; return v
    def s(self):
        n = self.u16(); v = self.b[self.p:self.p+n].decode("latin-1"); self.p += n; return v
    def toc(self):
        if self.b[self.p:self.p+4] != b"CkMp":
            raise ValueError("missing CkMp tag")
        self.p += 4
        m = {}
        for _ in range(self.i32()):
            n = self.u8(); name = self.b[self.p:self.p+n].decode("latin-1"); self.p += n
            m[self.u32()] = name
        return m
    def dict(self, names):
        out = {}
        for _ in range(self.u16()):
            kt = self.i32(); t = kt & 0xFF; k = names.get(kt >> 8, f"?{kt >> 8}")
            if   t == 0: out[k] = bool(self.u8())
            elif t == 1: out[k] = self.i32()
            elif t == 2: out[k] = round(self.f32(), 4)
            elif t == 3: out[k] = self.s()
            elif t == 4:
                n = self.u16(); out[k] = self.b[self.p:self.p+n*2].decode("utf-16-le"); self.p += n*2
            else: raise ValueError(f"dict type {t}")
        return out


def map_chunks(b):
    """Top-level chunks as {name: (version, offset, size)}, in file order."""
    r = MapReader(b); names = r.toc()
    out = []
    while r.p < len(b):
        cid = r.u32(); ver = r.u16(); size = r.i32()
        out.append((names.get(cid, f"?{cid}"), ver, r.p, size))
        r.p += size
    if r.p != len(b):
        raise ValueError(f"trailing {len(b) - r.p} bytes after last chunk")
    return names, out


def map_parse(b):
    """Field-level parse of the chunks we author. Chunks we only pass through are sized."""
    names, chunks = map_chunks(b)
    m = {"chunks": {n: {"version": v, "size": sz} for n, v, _, sz in chunks},
         "order": [n for n, _, _, _ in chunks]}
    r = MapReader(b)
    for name, ver, off, size in chunks:
        r.p = off
        if name == "HeightMapData":
            w, h, border = r.i32(), r.i32(), r.i32()
            nb = r.i32(); bounds = [(r.i32(), r.i32()) for _ in range(nb)]
            dsz = r.i32(); data = b[r.p:r.p+dsz]
            if dsz != w * h:
                raise ValueError(f"HeightMapData dataSize {dsz} != {w}*{h}")
            m["height"] = {"width": w, "height": h, "border": border, "boundaries": bounds,
                           "min": min(data), "max": max(data),
                           "distinct": len(set(data)), "data": data}
        elif name == "BlendTileData":
            n = r.i32()
            r.p += n * 2 * 4                                   # four int16 index planes
            r.p += (m["height"]["height"]) * ((m["height"]["width"] + 7) // 8)
            nb, nbl, ncl = r.i32(), r.i32(), r.i32()
            ntc = r.i32(); classes = []
            for _ in range(ntc):
                first, cnt, wid, _legacy = r.i32(), r.i32(), r.i32(), r.i32()
                classes.append({"firstTile": first, "numTiles": cnt, "width": wid,
                                "name": r.s()})
            m["blend"] = {"len": n, "numBitmapTiles": nb, "numBlendedTiles": nbl,
                          "numCliffInfo": ncl, "classes": classes}
        elif name == "WorldInfo":
            m["worldInfo"] = r.dict(names)
        elif name == "ObjectsList":
            end = off + size; objs = []
            while r.p < end:
                r.u32(); r.u16(); sz = r.i32(); e = r.p + sz
                x, y, z, ang = r.f32(), r.f32(), r.f32(), r.f32()
                r.i32()
                tmpl = r.s(); d = r.dict(names)
                objs.append({"template": tmpl, "x": x, "y": y, "z": z, "dict": d})
                r.p = e
            m["objects"] = objs
    return m


def map_start_spots(m):
    """Exactly MapUtil.cpp:334 — count Player_N_Start upward from 1, stop at the first gap."""
    have = {o["dict"].get("waypointName") for o in m.get("objects", [])}
    n = 0
    while f"Player_{n + 1}_Start" in have:
        n += 1
    return n


def cmd_map(a):
    if a.action == "scan":
        root = a.path or os.path.join(DEF_GAME, "Maps")
        files = sorted(glob.glob(os.path.join(root, "**", "*.map"), recursive=True))
        hist, vers, store, bad = Counter(), defaultdict(set), Counter(), []
        for f in files:
            try:
                b, how = map_load(f); store[how] += 1
                _, chunks = map_chunks(b)
                for n, v, _, _ in chunks:
                    hist[n] += 1; vers[n].add(v)
            except Exception as e:
                bad.append((os.path.basename(f), str(e)[:60]))
        ok = len(files) - len(bad)
        print(f"  {ok}/{len(files)} maps decoded   storage {dict(store)}")
        for n, c in hist.most_common():
            print(f"    {c:4d}/{ok}  {n:18s} versions {sorted(vers[n])}")
        for n, e in bad:
            print(f"    UNDECODED {n}: {e}")
        return 0

    b, how = map_load(a.path)
    m = map_parse(b)
    if a.action == "read":
        hm = m["height"]
        print(f"  {os.path.basename(a.path)}  {len(b)} bytes uncompressed ({how})")
        print(f"  chunks: " + ", ".join(f"{n} v{m['chunks'][n]['version']}" for n in m["order"]))
        print(f"  heightmap {hm['width']}x{hm['height']} border={hm['border']} "
              f"playable={hm['boundaries']}")
        span = (hm["boundaries"][0][0] * 10, hm["boundaries"][0][1] * 10)
        print(f"  playable span {span[0]}x{span[1]} world units; "
              f"elevation {(hm['max'] - hm['min']) * 10 / 16:.1f} "
              f"({hm['distinct']} distinct height bytes)")
        print(f"  terrain classes: {[c['name'] for c in m['blend']['classes']]}")
        print(f"  worldInfo: {m.get('worldInfo')}")
        print(f"  objects {len(m.get('objects', []))}, start spots {map_start_spots(m)}")
        for o in m.get("objects", []):
            wn = o["dict"].get("waypointName")
            if wn:
                print(f"    waypoint {wn!r} at ({o['x']:.0f}, {o['y']:.0f})")
        return 0

    if a.action == "verify":
        # Assertions a WRITTEN map must satisfy to be loadable and skirmish-playable. Every
        # one of these is a throw or an early-out in their loader, not a matter of taste.
        errs, hm = [], m["height"]
        need = ["HeightMapData", "BlendTileData", "WorldInfo", "SidesList",
                "ObjectsList", "PolygonTriggers", "GlobalLighting", "WaypointsList"]
        for n in need:
            if n not in m["chunks"]:
                errs.append(f"missing chunk {n} (all 149 decodable retail maps carry it)")
        if hm["width"] * hm["height"] != len(hm["data"]):
            errs.append("HeightMapData dataSize != width*height — a hard throw in their parser")
        if m["chunks"].get("GlobalLighting", {}).get("size") != 872:
            errs.append(f"GlobalLighting is {m['chunks'].get('GlobalLighting', {}).get('size')} "
                        f"bytes, not the 872 every shipped map has")
        if m["blend"]["len"] != hm["width"] * hm["height"]:
            errs.append("BlendTileData len != heightmap dataSize — their parser throws")
        if not m["blend"]["classes"]:
            errs.append("no texture class: the map has nothing to draw itself with")
        spots = map_start_spots(m)
        if spots < 2:
            errs.append(f"{spots} start spots; a skirmish map needs Player_1_Start and "
                        f"Player_2_Start, contiguous from 1")
        # A wall only blocks if it clears their slope limit: 9.8 world units over one cell,
        # which is 15.68 height bytes, so the step must be at least 16.
        d, w, h = hm["data"], hm["width"], hm["height"]
        worst = 0
        for y in range(h - 1):
            row, nxt = y * w, (y + 1) * w
            for x in range(w - 1):
                q = (d[row+x], d[row+x+1], d[nxt+x], d[nxt+x+1])
                worst = max(worst, max(q) - min(q))
        cliffy = worst >= 16
        print(f"  chunks: {len(m['chunks'])}/8   heightmap {hm['width']}x{hm['height']} "
              f"border={hm['border']} playable={hm['boundaries'][0]}")
        print(f"  start spots {spots}   terrain {[c['name'] for c in m['blend']['classes']]}")
        print(f"  steepest cell step {worst} bytes ({worst * 10 / 16:.1f} world units) — "
              f"{'clears' if cliffy else 'BELOW'} their 9.8 cliff limit")
        if a.expect_cliff and not cliffy:
            errs.append(f"expected blocking terrain but the steepest step is {worst} bytes "
                        f"(<16): their pathfinder will call all of it walkable")

        # Reachability under THEIR rule, not ours. This is the assertion that catches the
        # failure a chunk-level check cannot see: our grid and their height field have no
        # common cell size, so every map is RESAMPLED, and a resample can quietly close a
        # gate that was open in the authored map. Flood-filling the emitted bytes with
        # setCellCliffFlagFromHeights answers "can their units still get through" directly.
        # The flood fill is confined to the PLAYABLE region, and that is not a tidiness
        # choice: W3DTerrainLogic::getMaximumPathfindExtent returns 0..boundary*MAP_XY_FACTOR,
        # so Pathfinder::newMap allocates cells for the playable rectangle ALONE. The border
        # is flat, walkable-looking and unreachable. A fill that ignores it reports every
        # full-width barrier as leaky, which is what the first version of this check did.
        border = hm["border"]
        pw, ph = hm["boundaries"][0]
        cliff = bytearray(w * h)
        for y in range(h - 1):
            row, nxt = y * w, (y + 1) * w
            for x in range(w - 1):
                q = (d[row+x], d[row+x+1], d[nxt+x], d[nxt+x+1])
                if max(q) - min(q) > 9.8 * 16 / 10:          # PATHFIND_CLIFF_SLOPE_LIMIT_F
                    cliff[row + x] = 1

        def inplay(cx, cy):
            return border <= cx < border + pw and border <= cy < border + ph

        def cell_of(o):
            return (int(o["x"] / 10) + border, int(o["y"] / 10) + border)

        spot = {o["dict"]["waypointName"]: cell_of(o) for o in m.get("objects", [])
                if o["dict"].get("waypointName", "").startswith("Player_")}
        reach = None
        if len(spot) >= 2:
            (sx, sy) = spot["Player_1_Start"]; goal = spot["Player_2_Start"]
            seen = {(sx, sy)}; stack = [(sx, sy)]
            while stack:
                cx, cy = stack.pop()
                if (cx, cy) == goal: break
                for dx, dy in ((1,0),(-1,0),(0,1),(0,-1)):
                    nx, ny = cx + dx, cy + dy
                    if inplay(nx, ny) and (nx, ny) not in seen and not cliff[ny * w + nx]:
                        seen.add((nx, ny)); stack.append((nx, ny))
            reach = goal in seen
            print(f"  start spots {'CONNECTED' if reach else 'SEPARATED'} under their own "
                  f"cliff rule ({sum(cliff)} cliff cells, {pw}x{ph} pathable)")
        if a.expect_connected and reach is not True:
            errs.append("start spots are not reachable from each other: the resample closed "
                        "the route their pathfinder would take")
        if a.expect_separated and reach is not False:
            errs.append("start spots are still connected: the barrier did not survive the "
                        "resample into their height field")
        for e in errs:
            print(f"  FAIL: {e}")
        return 1 if errs else 0


def w3d_index(game):
    """model stem -> (archive, offset, size) for every .w3d in both archive layers."""
    idx = {}
    for arc in all_archives(game):
        if not os.path.basename(arc).lower().startswith("w3d"):
            continue
        for nm, off, size in big_toc(arc):
            if nm.lower().endswith(".w3d"):
                idx.setdefault(os.path.basename(nm).lower()[:-4], (arc, off, size))
    return idx


def w3d_shape(entry):
    """Bounding extents and part names of one archived .w3d, without extracting it.

    MESH_HEADER3's Min/Max are at offsets 76 and 88 — NOT 72 and 84. The struct carries a
    FutureCounts[1] between PrelitVersion and VertexChannels, and omitting it reads four bytes
    early and yields a box whose min exceeds its max, which is how the mistake announces
    itself if you look.
    """
    arc, off, size = entry
    with open(arc, "rb") as f:
        f.seek(off)
        d = f.read(size)
    xs, ys, zs, parts = [], [], [], set()
    for _, name, ctype, sz, payload in w3d_walk(d):
        if ctype == 0x1F and payload is not None and len(payload) >= 100:
            parts.add(payload[8:24].split(b"\0")[0].decode("latin-1").upper())
            mn = struct.unpack_from("<3f", payload, 76)
            mx = struct.unpack_from("<3f", payload, 88)
            xs += [mn[0], mx[0]]; ys += [mn[1], mx[1]]; zs += [mn[2], mx[2]]
        elif ctype == 0x0102 and payload is not None:                      # PIVOTS
            for i in range(len(payload) // 60):
                parts.add(payload[i*60:i*60+16].split(b"\0")[0].decode("latin-1").upper())
    if not xs:
        return None
    return {"halfX": (max(xs) - min(xs)) / 2, "halfY": (max(ys) - min(ys)) / 2,
            "depth": max(zs) - min(zs), "parts": parts}


def cmd_artvalidate(a):
    """Can an art profile be DERIVED from the mesh instead of measured from its users?

    It would be worth a great deal if it could: 2,928 shipped models are referenced by nothing
    and are therefore adoptable, and they have no measured profile for exactly the same reason
    — a profile is measured from the objects that use a mesh, and nothing uses these.

    This answers it by deriving profiles for the meshes that DO have measured ones and
    comparing. Run it before believing any derivation; the numbers are not encouraging.
    """
    prof_path = a.profiles or os.path.join(DEF_OUT, "art-profiles.json")
    if not os.path.exists(prof_path):
        return print(f"  no measured profiles at {prof_path} — run `zhasset artprofile` first")
    prof = json.load(open(prof_path))["models"]
    idx = w3d_index(a.game)
    print(f"  {len(idx)} models in the archives, {len(prof)} with measured profiles")

    import statistics as stats
    geo, rig = [], {k: [0, 0] for k in ("turretBone", "launchBone", "fireFXBone", "muzzleFlash")}
    for name, p in prof.items():
        e = idx.get(name.lower())
        if not e:
            continue
        sh = w3d_shape(e)
        if not sh:
            continue
        if p.get("geometry") == "BOX":
            try:
                maj, mnr, hgt = (float(p[k]) for k in ("majorRadius", "minorRadius", "height"))
                if maj > 0 and mnr > 0 and hgt > 0:
                    geo.append((sh["halfX"] / maj, sh["halfY"] / mnr, sh["depth"] / hgt))
            except (TypeError, KeyError, ValueError):
                pass
        norm = {re.sub(r"\d+$", "", x) for x in sh["parts"]}
        for k in rig:
            v = p.get(k)
            if not v:
                continue
            rig[k][1] += 1
            if v.upper() in sh["parts"] or re.sub(r"\d+$", "", v.upper()) in norm:
                rig[k][0] += 1

    print(f"\n  GEOMETRY, derived from mesh bounds vs measured ({len(geo)} meshes)")
    for i, lbl in enumerate(("majorRadius", "minorRadius", "height")):
        r = sorted(x[i] for x in geo)
        near = 100 * sum(1 for v in r if 0.8 <= v <= 1.2) / len(r)
        print(f"    {lbl:12s} median x{stats.median(r):.2f}   within +/-20%: {near:.0f}%")
    print("    -> gameplay geometry is a DESIGNER-CHOSEN collision size, not a property of the")
    print("       art. The silhouette includes barrels and wings the footprint excludes.")

    print(f"\n  RIG, is the named part even present in the mesh?")
    for k, (hit, tot) in rig.items():
        if tot:
            print(f"    {k:12s} {hit}/{tot} ({100*hit/tot:.0f}%)")
    print("    -> and presence is not identification: several bones are candidates and only")
    print("       the INI says which one the weapon fires from.")
    return 0


# ============================================================================================
# DOSSIER — everything about one object, resolved, with its whole ASSET CLOSURE.
#
# WHY THIS EXISTS
#     `catalogue` gives ten summary fields per object, which answers "what is in the game" and
#     not "how do I make another one of these". The operation an authoring agent actually needs
#     is: find the nearest existing thing, get EVERYTHING it is made of, change some of it, emit
#     it back. That requires the object's full definition AND the transitive closure of the art
#     it names — model, the textures inside that model, animations, death effects, sounds, and
#     the icons, which are a two-hop lookup nobody guesses right first time
#     (SelectPortrait -> MappedImage -> a rectangle in a shared texture page).
#
#     Every hop below is one that has silently failed at least once in this project: a model
#     that resolves to no file, a TerrainType whose texture ships in nothing, a MappedImage with
#     no texture behind it rendering as a blank tile.
# ============================================================================================

def mapped_images(ini):
    """MappedImage name -> {texture, coords}. Two hops from an object's SelectPortrait to a
    rectangle in a shared page, and the middle hop is the one that fails silently."""
    out = {}
    root = os.path.join(ini, "MappedImages")
    if not os.path.isdir(root):
        return out
    for dirpath, _, files in os.walk(root):
        for fn in files:
            if not fn.lower().endswith(".ini"):
                continue
            for kind, name, lines in ini_blocks(os.path.join(dirpath, fn)):
                if kind != "MappedImage":
                    continue
                out[name.lower()] = {"name": name, "texture": field(lines, "Texture"),
                                     "coords": field(lines, "Coords"),
                                     "textureWidth": field(lines, "TextureWidth"),
                                     "textureHeight": field(lines, "TextureHeight")}
    return out


def model_textures(idx, model):
    """The texture files named INSIDE a .w3d. An object's INI never mentions them, so this is
    the only way to know what a mesh actually paints itself with."""
    e = idx.get(model.lower())
    if not e:
        return None
    arc, off, size = e
    with open(arc, "rb") as f:
        f.seek(off)
        d = f.read(size)
    tex, anims = [], []
    for _, name, ctype, sz, payload in w3d_walk(d):
        if name == "TEXTURE_NAME" and payload:
            t = payload.split(b"\0")[0].decode("latin-1")
            if t and t not in tex:
                tex.append(t)
        elif name == "ANIMATION_HEADER" and payload and len(payload) >= 36:
            hier = payload[20:36].split(b"\0")[0].decode("latin-1")
            nm = payload[4:20].split(b"\0")[0].decode("latin-1")
            anims.append(f"{hier}.{nm}")
    return {"textures": tex, "animations": anims}


def draw_states(lines):
    """Model per ModelConditionState, which is where BUILDING ASSEMBLY lives.

    A structure's construction is not a separate asset: it is ModelConditionStates —
    ACTIVELY_BEING_CONSTRUCTED, PARTIALLY_CONSTRUCTED, and the DOOR_n_OPENING states a factory
    plays to let a unit out. A unit list that reports only the default model misses the whole
    build-up sequence and the reason a queue can fill and never drain.
    """
    states, cur = [], None
    for ln in lines:
        st = ln.strip()
        m = re.match(r"(DefaultConditionState|ConditionState)\s*=?\s*(.*)$", st)
        if m:
            cur = {"condition": m.group(2).strip() or "DEFAULT"}
            states.append(cur)
            continue
        if cur is None:
            continue
        for key in ("Model", "Animation", "Turret", "WeaponLaunchBone", "WeaponFireFXBone",
                    "WeaponMuzzleFlash", "HideSubObject", "ShowSubObject"):
            mm = re.match(rf"{key}\s*=\s*(.+)$", st)
            if mm:
                # ASSIGN, never setdefault: the keys were pre-initialised to None once, and
                # setdefault then refused every real value — every state reported model=None
                # while the file plainly named one.
                cur[key[0].lower() + key[1:]] = mm.group(1).strip()
    return states


def cmd_dossier(a):
    """Everything about one object, in the form an agent can clone and edit."""
    cat_path = os.path.join(DEF_OUT, "zh-catalogue.json")
    if not os.path.exists(cat_path):
        return print(f"  no catalogue at {cat_path} — run `zhasset catalogue` first")
    cat = json.load(open(cat_path))

    want = a.object.lower()
    hit = next((k for k in cat["objects"] if k.lower() == want), None)
    if hit is None:
        near = [k for k in cat["objects"] if want in k.lower()][:12]
        return print(f"  no object '{a.object}'." + (f" Did you mean: {', '.join(near)}" if near else ""))

    obj = cat["objects"][hit]

    # The verbatim block, because a clone starts from the real text and not from our summary.
    block = None
    objdir = os.path.join(a.ini, "Object")
    for fn in sorted(os.listdir(objdir)):
        if not fn.lower().endswith(".ini"):
            continue
        for kind, name, lines in ini_blocks(os.path.join(objdir, fn)):
            if kind == "Object" and name == hit:
                block = lines
                break
        if block:
            break
    if block is None:
        return print(f"  '{hit}' is in the catalogue but its block was not found in {objdir}")

    idx = w3d_index(a.game)
    mi = mapped_images(a.ini)

    def resolve_icon(name):
        if not name:
            return None
        e = mi.get(name.lower())
        return {"image": name, **({k: v for k, v in e.items() if k != "name"} if e else
                                 {"MISSING": "no MappedImage declares this name"})}

    models, assets = [], {}
    for st in draw_states(block):
        if st.get("model") and st["model"].lower() not in ("none", "nomodel"):
            models.append(st["model"])
    for m in dict.fromkeys(models):
        assets[m] = model_textures(idx, m) or {"MISSING": "no .w3d ships with this name"}

    weapons = {}
    for slot in re.findall(r"Weapon\s*=\s*(\S+)\s+(\S+)", "\n".join(block)):
        weapons[slot[0]] = {"weapon": slot[1], **cat["weapons"].get(slot[1], {})}

    dossier = {
        "object": hit,
        "file": obj.get("file"),
        "side": obj.get("side"),
        "buildCost": obj.get("buildCost"),
        "buildTime": obj.get("buildTime"),
        "kindOf": obj.get("kindOf"),
        "isStructure": obj.get("isStructure"),
        "commandSet": obj.get("commandSet"),
        "prerequisites": [l.strip() for l in block
                          if re.match(r"\s*(Object|Science)\s*=", l) and "Prereq" not in l][:8],
        "armor": {(m.group(1) if (m := re.search(r"Armor\s*=\s*(\S+)", l)) else None): None
                  for l in block if "Armor" in l and "=" in l}.keys().__iter__().__next__()
                 if any("Armor" in l for l in block) else None,
        "locomotor": next((re.search(r"Locomotor\s*=\s*\S+\s+(\S+)", l).group(1)
                           for l in block if re.match(r"\s*Locomotor\s*=", l)
                           and re.search(r"Locomotor\s*=\s*\S+\s+(\S+)", l)), None),
        "weapons": weapons,
        # Where the build-up and the door animations live.
        "drawStates": draw_states(block),
        # The asset closure: what each model paints itself with, and what it animates.
        "assets": assets,
        "icons": {
            "selectPortrait": resolve_icon(field(block, "SelectPortrait")),
            "buttonImage": resolve_icon(field(block, "ButtonImage")),
        },
        "sounds": {k: field(block, k) for k in
                   ("VoiceSelect", "VoiceMove", "VoiceAttack", "VoiceGuard", "VoiceCreate",
                    "SoundAmbient", "SoundDie", "SoundMoveStart", "UnitSpecificSounds")
                   if field(block, k)},
        # Death: FXList / ObjectCreationList names, i.e. the explosion graph's entry points.
        "death": sorted({m.group(2) for l in block
                         if (m := re.match(r"\s*(FX|OCL|FXList|DeathFX)\s*=\s*(?:\S+\s+)?(\S+)", l))}),
        "buildableBy": [side for side, roster in cat["rosterBySide"].items() if hit in roster],
        # The death effects EXPANDED, not merely named. This is where the closure used to stop:
        # a name like FX_StructureMediumDeath told an author nothing about what to author.
        "deathClosure": None,
        "verbatim": block if a.verbatim else f"{len(block)} lines (pass --verbatim)",
    }

    fx, ps, ocl = fx_index(a.ini)
    dc = {"textures": set(), "models": set(), "sounds": set(), "particles": set(),
          "missing": set()}
    for nm in dossier["death"]:
        fx_flatten(fx_expand(nm, fx, ps, ocl), dc)
    dossier["deathClosure"] = {k: sorted(v) for k, v in dc.items()}
    # Debris models carry their OWN textures, so the closure is not complete until they are
    # walked too — a thrown turret is a mesh like any other.
    for m in dc["models"]:
        if m not in assets:
            assets[m] = model_textures(idx, m) or {"MISSING": "no .w3d ships with this name"}

    if a.json:
        print(json.dumps(dossier, indent=2))
        return 0

    print(f"  {hit}   side={dossier['side']}  cost={dossier['buildCost']}  "
          f"time={dossier['buildTime']}  structure={dossier['isStructure']}")
    print(f"  kindOf: {' '.join((dossier['kindOf'] or [])[:10])}")
    print(f"  commandSet: {dossier['commandSet']}   buildable by: {dossier['buildableBy'] or '-'}")
    print(f"  locomotor: {dossier['locomotor']}   weapons: "
          f"{', '.join(f'{k}={v[chr(39)+chr(39)] if False else v['weapon']}' for k, v in weapons.items()) or '-'}")
    sts = [x["condition"] for x in dossier["drawStates"]]
    print(f"  draw states: {len(sts)}"
          + (f"   construction: {sum('CONSTRUCT' in x for x in sts)}" if any('CONSTRUCT' in x for x in sts) else "")
          + (f"   door: {sum('DOOR' in x for x in sts)}" if any('DOOR' in x for x in sts) else ""))
    for st in dossier["drawStates"][:8]:
        extra = " ".join(f"{k}={v}" for k, v in st.items()
                         if k not in ("condition", "model") and v)
        # An animation-only ConditionState carries no Model of its own — it inherits the
        # previous state's. Infantry are full of them (the Ranger has 44 states over 2 models),
        # and assuming a model key is present crashed the dossier on every one of them.
        print(f"    {st['condition'][:44]:44s} model={st.get('model') or '(inherits)'} {extra}")
    ntex = len({t for v in assets.values() for t in v.get("textures", [])})
    print(f"  assets: {len(assets)} models, {ntex} distinct textures")
    for m, v in list(assets.items())[:6 if not a.json else len(assets)]:
        if "MISSING" in v:
            print(f"    {m:20s} !! {v['MISSING']}")
        else:
            tx = v["textures"]
            shown = ", ".join(tx[:6]) + (f", +{len(tx) - 6} more" if len(tx) > 6 else "")
            print(f"    {m:20s} {len(tx):3d} textures [{shown}]"
                  + (f" anims={v['animations']}" if v["animations"] else ""))
    for k, v in dossier["icons"].items():
        if v:
            print(f"  {k}: {v.get('image')} -> {v.get('texture') or v.get('MISSING')} "
                  f"{v.get('coords') or ''}")
    if dossier["sounds"]:
        print(f"  sounds: {dossier['sounds']}")
    if dossier["death"]:
        d = dossier["deathClosure"]
        print(f"  death: {len(dossier['death'])} FX/OCL -> {len(d['particles'])} particle "
              f"systems, {len(d['textures'])} textures, {len(d['sounds'])} sounds, "
              f"{len(d['models'])} debris models")
        print(f"    {' '.join(dossier['death'][:6])}")
        if d["textures"]:
            print(f"    fx textures: {', '.join(d['textures'][:8])}"
                  + (f", +{len(d['textures'])-8} more" if len(d["textures"]) > 8 else ""))
        if d["models"]:
            print(f"    debris:      {', '.join(d['models'])}")
        if d["missing"]:
            print(f"    MISSING:     {', '.join(d['missing'])}")
    return 0


# ============================================================================================
# TECH TREE — factions, what they build, and what has to exist first.
#
# In ZH this is not one table but a JOIN across five files, and none of them names the graph:
#     PlayerTemplate  startingBuilding, IntrinsicSciences        -> the roots
#     Object          CommandSet, and a Prerequisites sub-block   -> the gates
#     CommandSet      numbered slots -> CommandButton names       -> the edges
#     CommandButton   Command = UNIT_BUILD | PLAYER_UPGRADE | SPECIAL_POWER  -> the targets
#     Science / Rank  purchase costs, prerequisites, skill-point thresholds  -> the second tree
#
# The two trees meet: an Object's Prerequisites can require a Science, and a SPECIAL_POWER
# button can require one, so the superweapons and the experience ladder are the SAME graph
# reached from a different root. That is why this is one command and not three.
# ============================================================================================

def subblock(lines, name):
    """The lines of an indented `<name> ... End` sub-block, e.g. Prerequisites."""
    out, depth = [], 0
    for ln in lines:
        st = ln.strip()
        if depth == 0:
            if re.match(rf"{name}\s*$", st) or re.match(rf"{name}\s+", st):
                depth = 1
            continue
        if st.lower() == "end":
            break
        out.append(st)
    return out


def command_sets(ini):
    out = {}
    for fn in ("CommandSet.ini",):
        path = os.path.join(ini, fn)
        if not os.path.exists(path):
            continue
        for kind, name, lines in ini_blocks(path):
            if kind != "CommandSet":
                continue
            slots = {}
            for ln in lines:
                m = re.match(r"\s*(\d+)\s*=\s*(\S+)", ln)
                if m:
                    slots[int(m.group(1))] = m.group(2)
            out[name] = slots
    return out


def command_buttons(ini):
    out = {}
    path = os.path.join(ini, "CommandButton.ini")
    if not os.path.exists(path):
        return out
    for kind, name, lines in ini_blocks(path):
        if kind != "CommandButton":
            continue
        out[name] = {
            "command": field(lines, "Command"),
            "object": field(lines, "Object"),
            "upgrade": field(lines, "Upgrade"),
            "specialPower": field(lines, "SpecialPower"),
            "science": (field(lines, "Science") or "").split() or None,
            "options": (field(lines, "Options") or "").split() or None,
        }
    return out


def object_prereqs(ini):
    """object -> {objects: [...], sciences: [...]}. An OR is expressed as several names on one
    line; ZH takes any one of them, which is why these stay as lists rather than being
    flattened into a single requirement."""
    out = {}
    objdir = os.path.join(ini, "Object")
    for fn in sorted(os.listdir(objdir)):
        if not fn.lower().endswith(".ini"):
            continue
        for kind, name, lines in ini_blocks(os.path.join(objdir, fn)):
            if kind != "Object":
                continue
            pre = subblock(lines, "Prerequisites")
            if not pre:
                continue
            objs, scis = [], []
            for ln in pre:
                m = re.match(r"(Object|Science)\s*=\s*(.+)$", ln)
                if m:
                    (objs if m.group(1) == "Object" else scis).append(m.group(2).split())
            out[name] = {"objects": objs, "sciences": scis}
    return out


def ranks(ini):
    out = []
    path = os.path.join(ini, "Rank.ini")
    if not os.path.exists(path):
        return out
    for kind, name, lines in ini_blocks(path):
        if kind != "Rank":
            continue
        out.append({
            "rank": int(name) if name.isdigit() else name,
            "skillPointsNeeded": field(lines, "SkillPointsNeeded"),
            "purchasePointsGranted": field(lines, "SciencePurchasePointsGranted"),
            "sciencesGranted": (field(lines, "SciencesGranted") or "").split(),
        })
    return sorted(out, key=lambda r: r["rank"] if isinstance(r["rank"], int) else 0)


def cmd_techtree(a):
    cat_path = os.path.join(DEF_OUT, "zh-catalogue.json")
    if not os.path.exists(cat_path):
        return print(f"  no catalogue at {cat_path} — run `zhasset catalogue` first")
    cat = json.load(open(cat_path))

    csets, cbuttons = command_sets(a.ini), command_buttons(a.ini)
    prereqs, rank_list = object_prereqs(a.ini), ranks(a.ini)
    objects, sciences, powers = cat["objects"], cat["sciences"], cat["specialPowers"]

    def produces(obj_name):
        """What one object's command set offers: units, upgrades, powers."""
        cs = (objects.get(obj_name) or {}).get("commandSet")
        got = {"builds": [], "constructs": [], "upgrades": [], "powers": [], "sciences": []}
        for _, btn in sorted((csets.get(cs) or {}).items()):
            b = cbuttons.get(btn)
            if not b:
                continue
            # The verb is what distinguishes the four kinds of edge, and there are more of them
            # than the obvious one. UNIT_BUILD (259) makes units; DOZER_CONSTRUCT (192) makes
            # STRUCTURES and is why a tree built from UNIT_BUILD alone stops dead at the dozer;
            # PURCHASE_SCIENCE (82) IS the experience tree, spent from rank points;
            # OBJECT_UPGRADE (37) is per-object rather than per-player. Some lines carry a
            # trailing space, so normalise before comparing.
            cmd = (b["command"] or "").strip().upper()
            if cmd == "UNIT_BUILD" and b["object"]:
                got["builds"].append(b["object"])
            elif cmd == "DOZER_CONSTRUCT" and b["object"]:
                got["constructs"].append(b["object"])
            elif cmd in ("PLAYER_UPGRADE", "OBJECT_UPGRADE") and b["upgrade"]:
                got["upgrades"].append(b["upgrade"])
            elif cmd == "PURCHASE_SCIENCE" and b["science"]:
                got["sciences"].extend(b["science"])
            elif cmd.startswith("SPECIAL_POWER") and b["specialPower"]:
                got["powers"].append({"power": b["specialPower"], "science": b["science"]})
        return got

    factions = [f for f in cat["factions"]
                if a.faction.lower() in f.lower()] if a.faction else list(cat["factions"])
    if not factions:
        return print(f"  no faction matching '{a.faction}'. Have: {', '.join(cat['factions'])}")

    trees = {}
    for fid in factions:
        f = cat["factions"][fid]
        root = f.get("startingBuilding")
        # BFS from the starting building through command sets. The DEPTH is the useful part:
        # it is how far into the tree a thing sits, which no file states anywhere.
        depth, order, frontier = {}, [], [root] if root else []
        for r in frontier:
            depth[r] = 0
        while frontier:
            nxt = []
            for cur in frontier:
                order.append(cur)
                p = produces(cur)
                # Both edges advance the tree: a factory BUILDS units, a dozer CONSTRUCTS
                # buildings, and the buildings are what carry the next tier's command sets.
                for child in p["builds"] + p["constructs"]:
                    if child not in depth:
                        depth[child] = depth[cur] + 1
                        nxt.append(child)
            frontier = nxt
        producers = {o: produces(o) for o in order if any(produces(o).values())}
        # Sciences reachable from this faction: intrinsic, rank-granted, and any named by a
        # power button the faction can reach.
        reach_sci = set(f.get("intrinsicSciences") or [])
        for r in rank_list:
            reach_sci.update(r["sciencesGranted"])
        sw = {}
        for o, p in producers.items():
            reach_sci.update(p["sciences"])
            for entry in p["powers"]:
                pw = powers.get(entry["power"], {})
                sw[entry["power"]] = {"fromObject": o, "science": entry["science"],
                                      "requiredScience": pw.get("RequiredScience"),
                                      "reloadTime": pw.get("ReloadTime"),
                                      "enum": pw.get("Enum")}
                for sc in (entry["science"] or []):
                    reach_sci.add(sc)
                if pw.get("RequiredScience"):
                    reach_sci.add(pw["RequiredScience"])
        trees[fid] = {
            "side": f.get("side"), "playable": f.get("playable"),
            "startingBuilding": root,
            "intrinsicSciences": f.get("intrinsicSciences"),
            "depth": depth, "producers": producers, "superweapons": sw,
            "sciences": {k: {**sciences.get(k, {}),
                             "reachable": k in reach_sci} for k in sorted(reach_sci)},
            "prerequisites": {o: prereqs[o] for o in depth if o in prereqs},
        }

    if a.json:
        print(json.dumps({"ranks": rank_list, "factions": trees}, indent=2))
        return 0

    print(f"  rank ladder: " + "  ".join(
        f"{r['rank']}@{r['skillPointsNeeded']}(+{r['purchasePointsGranted']})" for r in rank_list)
        + f"   = {sum(int(r['purchasePointsGranted'] or 0) for r in rank_list)} purchase points a game")
    for fid, t in trees.items():
        print(f"\n  {fid}  side={t['side']}  playable={t['playable']}  root={t['startingBuilding']}")
        if not t["startingBuilding"]:
            print("    (no starting building — nothing is reachable, so no tree)")
            continue
        bytier = {}
        for o, d in t["depth"].items():
            bytier.setdefault(d, []).append(o)
        for d in sorted(bytier):
            names = sorted(bytier[d])
            print(f"    tier {d}: {len(names)}  {', '.join(names[:6])}"
                  + (f", +{len(names)-6} more" if len(names) > 6 else ""))
        upg = sorted({u for p in t["producers"].values() for u in p["upgrades"]})
        print(f"    upgrades purchasable: {len(upg)}   "
              f"purchasable sciences: {len([k for k in t['sciences'] if sciences.get(k, {}).get('SciencePurchasePointCost')])}")
        gated = {o: p for o, p in t["prerequisites"].items() if p["sciences"]}
        if gated:
            print(f"    science-gated objects: " +
                  ", ".join(f"{o}<-{'/'.join(sum(p['sciences'], []))}" for o, p in list(gated.items())[:4]))
        if t["superweapons"]:
            print(f"    superweapons: {len(t['superweapons'])}")
            for pw, v in list(t["superweapons"].items())[:6]:
                print(f"      {pw:34s} from {v['fromObject']:26s} science={v['requiredScience']} "
                      f"reload={v['reloadTime']}")
        print(f"    reachable sciences: {len(t['sciences'])}")
    return 0


# ============================================================================================
# NEAREST — find the closest existing object to clone.
#
# The authoring loop is: pick the nearest existing thing, take everything it is made of
# (`dossier`), change some of it, emit it. This is the first step, and the whole question is
# what makes two units SUBSTITUTABLE.
#
# It is not cost, and it is not stats. It is ROLE — a 900-cost tank and a 900-cost jet share a
# number and nothing else, while a Crusader and a Battlemaster are the same thing wearing
# different flags. Role lives in KindOf, and KindOf is a set, so the role term is a Jaccard
# overlap and it is weighted heaviest. Everything else breaks ties.
#
# Distances are reported PER AXIS rather than as one number, because an agent choosing a
# template has to know WHY something came back nearest — "same role, 12% cheaper, shorter
# ranged" is actionable and "score 0.83" is not.
# ============================================================================================

# KindOf entries that say nothing about role. PRELOAD is a loading hint; SCORE and
# CAN_CAST_REFLECTIONS are bookkeeping and presentation. Leaving them in inflates every
# object's similarity to every other, because almost everything carries them.
KINDOF_NOISE = {"PRELOAD", "SCORE", "CAN_CAST_REFLECTIONS", "SELECTABLE",
                "ATTACK_NEEDS_LINE_OF_SIGHT", "MP_COUNT_FOR_VICTORY", "CLICK_THROUGH"}


def object_rigs(ini):
    """object -> primary weapon, locomotor, armor. Not in the catalogue, and one pass gets it."""
    out = {}
    objdir = os.path.join(ini, "Object")
    for fn in sorted(os.listdir(objdir)):
        if not fn.lower().endswith(".ini"):
            continue
        for kind, name, lines in ini_blocks(os.path.join(objdir, fn)):
            if kind != "Object":
                continue
            body = "\n".join(lines)
            wm = re.search(r"Weapon\s*=\s*PRIMARY\s+(\S+)", body)
            lm = re.search(r"Locomotor\s*=\s*\S+\s+(\S+)", body)
            am = re.search(r"Armor\s*=\s*(\S+)", body)
            out[name] = {"weapon": wm.group(1) if wm else None,
                         "locomotor": lm.group(1) if lm else None,
                         "armor": am.group(1) if am else None}
    return out


def _num(v, default=0.0):
    try:
        return float(str(v).split()[0])
    except (TypeError, ValueError, IndexError):
        return default


def cmd_nearest(a):
    cat_path = os.path.join(DEF_OUT, "zh-catalogue.json")
    if not os.path.exists(cat_path):
        return print(f"  no catalogue at {cat_path} — run `zhasset catalogue` first")
    cat = json.load(open(cat_path))
    objects, weapons, locos = cat["objects"], cat["locomotors"], cat["locomotors"]
    weapons = cat["weapons"]
    rigs = object_rigs(a.ini)

    def feats(name):
        o = objects.get(name) or {}
        r = rigs.get(name) or {}
        w = weapons.get(r.get("weapon") or "", {})
        l = cat["locomotors"].get(r.get("locomotor") or "", {})
        return {
            "cost": _num(o.get("buildCost")),
            "role": {k for k in (o.get("kindOf") or []) if k not in KINDOF_NOISE},
            "structure": bool(o.get("isStructure")),
            "damage": _num(w.get("PrimaryDamage")),
            "range": _num(w.get("AttackRange")),
            "dtype": w.get("DamageType"),
            "speed": _num(l.get("Speed")),
            "surfaces": l.get("Surfaces"),
            "side": o.get("side"),
        }

    # Only things a player could plausibly build are candidates. A cost of 0 is scenery, a
    # cinematic prop or a piece of a larger object, and there are far more of those than units.
    # CINE_ objects are byte-identical cutscene clones — they rank first every time and are
    # useless as a template, since cloning a clone inherits nothing the original does not have.
    # Excluded by default and nameable with --include-cine, because "why is CINE_X my nearest
    # match" is a question worth never having to ask.
    pool = [n for n, o in objects.items()
            if (a.include_cine or not n.upper().startswith("CINE_"))
            and _num(o.get("buildCost")) > 0
            and (not a.side or (o.get("side") or "").lower() == a.side.lower())
            and (a.structures or not o.get("isStructure"))
            and (not a.kindof or a.kindof.upper() in (o.get("kindOf") or []))]

    if a.like:
        hit = next((k for k in objects if k.lower() == a.like.lower()), None)
        if hit is None:
            near = [k for k in objects if a.like.lower() in k.lower()][:10]
            return print(f"  no object '{a.like}'." + (f" Close: {', '.join(near)}" if near else ""))
        target = feats(hit)
        pool = [n for n in pool if n != hit]
    else:
        target = {"cost": _num(a.cost), "role": {k.upper() for k in (a.role or "").split(",") if k},
                  "structure": bool(a.structures), "damage": _num(a.damage), "range": _num(a.range),
                  "dtype": None, "speed": _num(a.speed), "surfaces": None, "side": a.side}
        hit = None

    def ratio(x, y):
        """Symmetric relative gap, 0 = identical. Ratios not differences: 100 vs 200 damage is
        the same distance as 1000 vs 2000, and an absolute diff would call the second far worse."""
        if x <= 0 and y <= 0:
            return 0.0
        if x <= 0 or y <= 0:
            return 1.0
        return abs(x - y) / max(x, y)

    scored = []
    for n in pool:
        f = feats(n)
        if f["structure"] != target["structure"]:
            continue
        jac = (len(f["role"] & target["role"]) / len(f["role"] | target["role"])
               if (f["role"] | target["role"]) else 0.0)
        axes = {
            "role": (1.0 - jac, 3.0),          # heaviest: role is what makes two units swap
            "cost": (ratio(f["cost"], target["cost"]), 1.0),
            "damage": (ratio(f["damage"], target["damage"]), 1.0),
            "range": (ratio(f["range"], target["range"]), 1.0),
            "speed": (ratio(f["speed"], target["speed"]), 0.5),
            "dtype": (0.0 if f["dtype"] == target["dtype"] else 1.0, 0.5),
        }
        score = sum(v * w for v, w in axes.values()) / sum(w for _, w in axes.values())
        scored.append((score, n, f, {k: round(v, 2) for k, (v, _) in axes.items()}))
    scored.sort(key=lambda t: (t[0], t[1]))

    if a.json:
        print(json.dumps({"target": hit or target,
                          "matches": [{"object": n, "score": round(sc, 4), "axes": ax,
                                       "cost": f["cost"], "damage": f["damage"],
                                       "range": f["range"], "speed": f["speed"],
                                       "side": f["side"], "role": sorted(f["role"])}
                                      for sc, n, f, ax in scored[:a.limit]]},
                         indent=2, default=str))
        return 0

    what = hit or (f"cost={target['cost']:.0f} role={','.join(sorted(target['role'])) or '-'}")
    print(f"  nearest to {what}   ({len(scored)} candidates)")
    print(f"  {'object':32s} {'score':>6} {'cost':>6} {'dmg':>6} {'rng':>6} {'spd':>5}  side")
    for sc, n, f, ax in scored[:a.limit]:
        print(f"  {n:32s} {sc:6.3f} {f['cost']:6.0f} {f['damage']:6.0f} {f['range']:6.0f} "
              f"{f['speed']:5.0f}  {f['side']}")
    if scored:
        sc, n, f, ax = scored[0]
        print(f"  why {n}: " + "  ".join(f"{k}={v}" for k, v in sorted(ax.items())))
        print(f"  next: zhasset dossier {n}   # everything it is made of")
    return 0


# ============================================================================================
# FX GRAPH — what an explosion is actually made of.
#
# `dossier` reports a death effect as a NAME: FX_StructureMediumDeath. That is where the asset
# closure stopped, and it is the last category where adopted art is still structurally required
# — an authored mesh dies silently and invisibly because nothing here knows what to author.
#
# The graph is RECURSIVE in three places, and missing any of them truncates the closure:
#     FXList          -> ParticleSystem | Sound | ViewShake | LightPulse | TerrainScorch |
#                        Tracer | FXListAtBonePos  (-> another FXList)
#     ParticleSystem  -> ParticleName (a texture), SlaveSystem, PerParticleAttachedSystem
#                        (-> more ParticleSystems)
#     OCL             -> CreateDebris ModelNames, CreateObject ObjectNames (-> models, objects)
#
# Measured in retail: 863 ParticleSystem entries across the FXLists, 1,087 ParticleName
# textures, 60 SlaveSystem and 119 PerParticleAttachedSystem links. Cycles are possible, so
# every walk carries a seen-set; without one a slave pair recurses forever.
# ============================================================================================

def fx_index(ini):
    """FXLists, ParticleSystems and OCLs, parsed once. Directory scans included, because both
    FXList and ParticleSystem are additive dirs on this build."""
    fx, ps, ocl = {}, {}, {}

    def files(stem):
        out = []
        f = os.path.join(ini, stem + ".ini")
        if os.path.exists(f):
            out.append(f)
        d = os.path.join(ini, stem)
        if os.path.isdir(d):
            for dp, _, fns in os.walk(d):
                out += [os.path.join(dp, x) for x in sorted(fns) if x.lower().endswith(".ini")]
        return out

    for f in files("FXList"):
        for kind, name, lines in ini_blocks(f):
            if kind != "FXList":
                continue
            entries, cur = [], None
            for ln in lines:
                st = ln.strip()
                m = re.match(r"([A-Za-z]+)\s*$", st)
                if m and not re.match(r"(?i)end$", st):
                    cur = {"kind": m.group(1)}
                    entries.append(cur)
                    continue
                if re.match(r"(?i)end$", st):
                    cur = None
                    continue
                if cur is not None:
                    kv = re.match(r"(\w+)\s*=\s*(.+)$", st)
                    if kv:
                        cur[kv.group(1)] = kv.group(2).strip()
            fx[name] = entries

    for f in files("ParticleSystem"):
        for kind, name, lines in ini_blocks(f):
            if kind != "ParticleSystem":
                continue
            ps[name] = {
                "texture": field(lines, "ParticleName"),
                "type": field(lines, "Type"),
                "shader": field(lines, "Shader"),
                "slaves": [v for v in (field(lines, "SlaveSystem"),
                                       field(lines, "PerParticleAttachedSystem")) if v],
            }

    for f in files("ObjectCreationList"):
        for kind, name, lines in ini_blocks(f):
            if kind != "ObjectCreationList":
                continue
            body = "\n".join(lines)
            ocl[name] = {
                "models": sorted({m for ln in re.findall(r"ModelNames\s*=\s*(.+)", body)
                                  for m in ln.split()}),
                "objects": sorted({m for ln in re.findall(r"ObjectNames\s*=\s*(.+)", body)
                                   for m in ln.split()}),
            }
    return fx, ps, ocl


def fx_expand(name, fx, ps, ocl, seen=None):
    """The transitive closure of one FX/OCL name."""
    seen = seen if seen is not None else set()
    if name in seen:
        return {"name": name, "cycle": True}
    seen.add(name)

    if name in ocl:
        o = ocl[name]
        return {"name": name, "kind": "ObjectCreationList",
                "debrisModels": o["models"], "spawnObjects": o["objects"]}
    if name in ps:
        p = ps[name]
        return {"name": name, "kind": "ParticleSystem", "texture": p["texture"],
                "type": p["type"],
                "slaves": [fx_expand(sl, fx, ps, ocl, seen) for sl in p["slaves"]]}
    if name in fx:
        out = {"name": name, "kind": "FXList", "particles": [], "sounds": [],
               "other": [], "nested": []}
        for e in fx[name]:
            k, n = e.get("kind"), e.get("Name")
            if k == "ParticleSystem" and n:
                out["particles"].append(fx_expand(n, fx, ps, ocl, seen))
            elif k == "Sound" and n:
                out["sounds"].append(n)
            elif k == "FXListAtBonePos" and e.get("FX"):
                out["nested"].append(fx_expand(e["FX"], fx, ps, ocl, seen))
            else:
                out["other"].append(k)
        return out
    return {"name": name, "MISSING": "no FXList, ParticleSystem or OCL declares this name"}


def fx_flatten(node, acc=None):
    """Everything the closure actually needs on disk: textures, models, sounds."""
    acc = acc if acc is not None else {"textures": set(), "models": set(), "sounds": set(),
                                       "particles": set(), "missing": set()}
    if "MISSING" in node:
        acc["missing"].add(node["name"])
        return acc
    k = node.get("kind")
    if k == "ParticleSystem":
        acc["particles"].add(node["name"])
        if node.get("texture"):
            acc["textures"].add(node["texture"])
        for sl in node.get("slaves", []):
            fx_flatten(sl, acc)
    elif k == "ObjectCreationList":
        acc["models"].update(node.get("debrisModels", []))
    elif k == "FXList":
        acc["sounds"].update(node.get("sounds", []))
        for child in node.get("particles", []) + node.get("nested", []):
            fx_flatten(child, acc)
    return acc


def cmd_fx(a):
    fx, ps, ocl = fx_index(a.ini)
    if a.stats:
        print(f"  {len(fx)} FXLists, {len(ps)} ParticleSystems, {len(ocl)} OCLs")
        print(f"  {sum(1 for v in ps.values() if v['texture'])} particle systems name a texture; "
              f"{len({v['texture'] for v in ps.values() if v['texture']})} distinct textures")
        print(f"  {sum(len(v['slaves']) for v in ps.values())} slave/attached links")
        return 0
    if not a.name:
        return print("  give an FXList / ParticleSystem / OCL name, or --stats")
    tree = fx_expand(a.name, fx, ps, ocl)
    flat = fx_flatten(tree)
    if a.json:
        print(json.dumps({"tree": tree, "closure": {k: sorted(v) for k, v in flat.items()}},
                         indent=2))
        return 0
    if "MISSING" in tree:
        return print(f"  {a.name}: {tree['MISSING']}")
    print(f"  {a.name}  ({tree['kind']})")
    for pnode in tree.get("particles", []):
        tex = pnode.get("texture") or pnode.get("MISSING", "?")
        sl = f"  slaves={[s['name'] for s in pnode.get('slaves', [])]}" if pnode.get("slaves") else ""
        print(f"    particle {pnode['name']:38s} texture={tex}{sl}")
    for snd in tree.get("sounds", []):
        print(f"    sound    {snd}")
    for other in dict.fromkeys(tree.get("other", [])):
        print(f"    {other.lower()} (no asset)")
    print(f"  closure: {len(flat['particles'])} particle systems, {len(flat['textures'])} "
          f"textures, {len(flat['sounds'])} sounds, {len(flat['models'])} debris models")
    if flat["textures"]:
        print(f"    textures: {', '.join(sorted(flat['textures']))}")
    if flat["models"]:
        print(f"    models:   {', '.join(sorted(flat['models']))}")
    if flat["missing"]:
        print(f"    MISSING:  {', '.join(sorted(flat['missing']))}")
    return 0


# ------------------------------------------------------------------------ audio
#
# The SECOND implementation. `Content/ZhAudio.cs` writes; this reads and grades, and it earns
# that job the way the map reader did — by measuring all 8,638 SHIPPED files before it ever
# judges one of ours. A writer checked by its own reader proves only that the two agree.

# The three closed enums, from theAudioPriorityNames / theSoundTypeNames / theAudioControlNames
# in INIAudioEventInfo.cpp. Checked against the NAME TABLE and never against a grep of the INI:
# retail exercises a subset, and a value that is legal-but-unused reads as an error to a grep
# while a typo that happens to be a substring of a real name reads as fine.
AUDIO_PRIORITIES = ["LOWEST", "LOW", "NORMAL", "HIGH", "CRITICAL"]
AUDIO_TYPES = ["UI", "WORLD", "SHROUDED", "GLOBAL", "VOICE", "PLAYER", "ALLIES", "ENEMIES",
               "EVERYONE"]
AUDIO_CONTROLS = ["LOOP", "RANDOM", "ALL", "POSTDELAY", "INTERRUPT"]

# Priority is parseIndexList (one value); Type and Control are parseBitString32 (a flag SET).
AUDIO_SCALAR = {"priority": AUDIO_PRIORITIES}
AUDIO_BITSET = {"type": AUDIO_TYPES, "control": AUDIO_CONTROLS}


def wav_probe(b):
    """Parse a RIFF/WAVE header. Returns a dict, or {'error': ...}. Deliberately strict about
    the two fields a player never notices and a decoder always does: the RIFF size field and the
    data length, both of which a truncated write leaves plausible-looking and wrong."""
    if len(b) < 44 or b[:4] != b"RIFF" or b[8:12] != b"WAVE":
        return {"error": "not RIFF/WAVE"}
    riff_sz = struct.unpack("<I", b[4:8])[0]
    out = {"riffSizeOk": riff_sz == len(b) - 8}
    p, seen = 12, {}
    while p + 8 <= len(b):
        cid = b[p:p + 4]
        (csz,) = struct.unpack("<I", b[p + 4:p + 8])
        p += 8
        seen[cid] = (p, csz)
        if cid == b"fmt " and csz >= 16:
            tag, ch, sr, _br, ba, bits = struct.unpack("<HHIIHH", b[p:p + 16])
            out.update(tag=tag, channels=ch, rate=sr, bits=bits, blockAlign=ba)
        p += csz + (csz & 1)
    if b"fmt " not in seen:
        return {"error": "no fmt chunk"}
    if b"data" not in seen:
        return {"error": "no data chunk"}
    doff, dsz = seen[b"data"]
    out["dataBytes"] = dsz
    out["dataTruncated"] = doff + dsz > len(b)
    ba = out.get("blockAlign") or 1
    out["seconds"] = dsz / (out.get("rate", 1) * ba) if ba else 0
    out["samples"] = dsz // ba if ba else 0
    return out


def wav_pcm16(b, probe):
    """Mono 16-bit sample list, or None. Only what the seam and clipping checks need."""
    if probe.get("tag") != 1 or probe.get("bits") != 16 or probe.get("channels") != 1:
        return None
    p = 12
    while p + 8 <= len(b):
        cid = b[p:p + 4]
        (csz,) = struct.unpack("<I", b[p + 4:p + 8])
        p += 8
        if cid == b"data":
            n = min(csz, len(b) - p) // 2
            return list(struct.unpack("<%dh" % n, b[p:p + n * 2]))
        p += csz + (csz & 1)
    return None


def audio_census(game):
    """Every audio file in every archive, by format. Headers only — no sample data is read and
    nothing is extracted, which is the same provenance rule the rest of this tool follows."""
    ext, fmts, byarc, bad = Counter(), Counter(), Counter(), []
    total = nbytes = 0
    for arc in all_archives(game):
        try:
            toc = big_toc(arc)
        except Exception:
            continue
        aud = [(n, o, s) for n, o, s in toc
               if os.path.splitext(n)[1].lower() in (".wav", ".mp3", ".ogg", ".aud")]
        if not aud:
            continue
        byarc[os.path.basename(arc)] = len(aud)
        with open(arc, "rb") as f:
            for n, o, s in aud:
                total += 1
                nbytes += s
                e = os.path.splitext(n)[1].lower()
                ext[e] += 1
                if e != ".wav":
                    continue
                f.seek(o)
                pr = wav_probe(f.read(min(s, 256)) + b"\0" * 256)
                if "error" in pr:
                    bad.append(n)
                    continue
                fmts[(pr.get("tag"), pr.get("channels"), pr.get("rate"), pr.get("bits"))] += 1
    return {"files": total, "bytes": nbytes, "ext": ext, "formats": fmts,
            "byArchive": byarc, "unparsed": bad}


def cmd_audio(a):
    if a.census:
        c = audio_census(a.game)
        if not c["files"]:
            print("  no archives found — install absent, skipping")
            return 0
        if a.json:
            print(json.dumps({"files": c["files"], "bytes": c["bytes"],
                              "ext": dict(c["ext"]),
                              "formats": [{"tag": k[0], "channels": k[1], "rate": k[2],
                                           "bits": k[3], "count": v}
                                          for k, v in c["formats"].most_common()],
                              "byArchive": dict(c["byArchive"]),
                              "unparsed": len(c["unparsed"])}, indent=2))
            return 0
        print(f"  {c['files']} audio files, {c['bytes'] / 1e6:.1f} MB")
        print("  " + ", ".join(f"{k} {v}" for k, v in c["ext"].most_common()))
        pcm = sum(v for k, v in c["formats"].items() if k[0] == 1)
        adpcm = sum(v for k, v in c["formats"].items() if k[0] == 17)
        print(f"  wave formats: {len(c['formats'])} distinct — {pcm} plain PCM (tag 1), "
              f"{adpcm} IMA ADPCM (tag 17)")
        for k, v in c["formats"].most_common():
            print(f"    tag={k[0]:2d} ch={k[1]} rate={k[2]:5d} bits={k[3]:2d}   {v:5d}")
        if c["unparsed"]:
            print(f"  NOT RIFF/WAVE: {len(c['unparsed'])}")
        return 0

    root = a.pack
    if not root:
        return print("  give a compiled pack directory, or --census")
    ini_dir = os.path.join(root, "Data", "INI", "SoundEffects")
    snd_dir = os.path.join(root, "Data", "Audio", "Sounds")
    if not os.path.isdir(ini_dir):
        return print(f"  no {ini_dir} — nothing to validate")

    errors, warns, events, waves = [], [], {}, {}
    for fn in sorted(os.listdir(ini_dir)):
        if not fn.lower().endswith(".ini"):
            continue
        for kind, name, lines in ini_blocks(os.path.join(ini_dir, fn)):
            if kind != "AudioEvent":
                continue
            ev = {"sounds": []}
            for key, table in AUDIO_SCALAR.items():
                v = field(lines, key)
                if v is None:
                    continue
                ev[key] = v
                if v.upper() not in table:
                    errors.append(f"{name}: {key} = '{v}' is not in the C++ name table")
            for key, table in AUDIO_BITSET.items():
                v = field(lines, key)
                if v is None:
                    continue
                ev[key] = v
                for bit in v.split():
                    if bit.upper() not in table:
                        errors.append(f"{name}: {key} bit '{bit}' is not in the C++ name table")
            for key in ("sounds", "soundsnight", "soundsevening", "soundsmorning",
                        "attack", "decay"):
                v = field(lines, key)
                if v:
                    ev["sounds"] += v.split()
            if not ev["sounds"]:
                errors.append(f"{name}: no Sounds — the event resolves to no file at all")
            events[name] = ev

    # An AudioEvent never names a path: generateFilenamePrefix composes
    # {AudioRoot}\{SoundsFolder}\{name}.{SoundsExtension}, so a `Sounds` entry IS a base
    # filename under Data/Audio/Sounds. A name with no file there parses cleanly and is silent.
    on_disk = {}
    if os.path.isdir(snd_dir):
        for fn in sorted(os.listdir(snd_dir)):
            stem, ext = os.path.splitext(fn)
            if ext.lower() != ".wav":
                continue
            b = open(os.path.join(snd_dir, fn), "rb").read()
            pr = wav_probe(b)
            on_disk[stem] = pr
            waves[stem] = (b, pr)
            if "error" in pr:
                errors.append(f"{fn}: {pr['error']}")
                continue
            if not pr["riffSizeOk"]:
                errors.append(f"{fn}: RIFF size field disagrees with the file length")
            if pr["dataTruncated"]:
                errors.append(f"{fn}: data chunk runs past the end of the file")
            # We author plain PCM only, and the arm64 build carries no decoder of any kind, so
            # anything else in a compiled pack is either a hand-edit or a bug. tag 17 is IMA
            # ADPCM — legal, shipped 3,236 times, and not something this project writes.
            if pr["tag"] != 1:
                warns.append(f"{fn}: wFormatTag {pr['tag']} — a pack should carry plain PCM "
                             f"(tag 1); {'IMA ADPCM' if pr['tag'] == 17 else 'this'} needs a "
                             f"decoder the target build does not have")

    for name, ev in sorted(events.items()):
        for s in ev["sounds"]:
            if s not in on_disk:
                errors.append(f"{name}: Sounds names '{s}' — no {snd_dir}/{s}.wav")

    # The property the writer CLAIMS, checked rather than trusted: a looping wave must join
    # end-to-start, or it ticks once per repetition.
    #
    # The statistic is the CURVATURE across the wrap — |s[i+1] - 2s[i] + s[i-1]| evaluated
    # circularly at the join — compared against the 99.9th percentile of the same quantity
    # everywhere else in the wave. Self-calibrating on purpose: an absolute threshold has to be
    # guessed per waveform, and this one asks only whether the join looks like the rest of the
    # signal. A plain value test (|s[0] - s[n-1]|) is NOT enough and was the first attempt —
    # truncate a loop at a half cycle and both ends sit at zero with opposite slope, so the values
    # agree and the derivative does not.
    #
    # Measured on the authored engine loop by cutting it at twelve lengths. Intact scores 0.86
    # and whole-cycle cuts score 0.38 and 1.38 — correctly clean, since removing whole cycles
    # leaves a seamless loop. Every partial cut lands between 2.8 and 14.7 EXCEPT the half-cycle
    # one at 1.26, and that exception is a property rather than a hole: every harmonic of a
    # harmonic series returns to zero at half a period, so such a loop genuinely barely clicks.
    # Hence 4x, which sat above two real defects at 2.81 and 3.50 — dropped to 2.5, keeping ~3x
    # headroom over the intact wave.
    loops = [n for n, e in events.items() if "loop" in (e.get("control") or "").lower()]
    for n in loops:
        for s in events[n]["sounds"]:
            if s not in waves:
                continue
            b, pr = waves[s]
            pcm = wav_pcm16(b, pr)
            if not pcm or len(pcm) < 64:
                continue
            m = len(pcm)

            def curv(i):
                return abs(pcm[(i + 1) % m] - 2 * pcm[i] + pcm[(i - 1) % m])

            interior = sorted(curv(i) for i in range(2, m - 2))
            base = max(interior[int(len(interior) * 0.999)], 1)
            wrap = max(curv(0), curv(m - 1))
            if wrap > 2.5 * base:
                errors.append(f"{n}/{s}: loop join is {wrap / base:.1f}x as sharp as the "
                              f"sharpest point in the wave — it will click once per repetition")

    for s, (b, pr) in sorted(waves.items()):
        pcm = wav_pcm16(b, pr)
        if not pcm:
            continue
        clipped = sum(1 for v in pcm if v >= 32767 or v <= -32767)
        if clipped > len(pcm) // 100:
            warns.append(f"{s}: {clipped}/{len(pcm)} samples at full scale — authored too hot")
        dc = sum(pcm) / len(pcm)
        if abs(dc) > 1600:
            warns.append(f"{s}: DC offset {dc:.0f} — wastes headroom and thumps on start/stop")

    if a.json:
        print(json.dumps({"events": len(events), "waves": len(waves),
                          "loops": sorted(loops),
                          "errors": errors, "warnings": warns}, indent=2))
        return 0 if not errors else 1
    print(f"  {len(events)} AudioEvents, {len(waves)} waves, {len(loops)} looping")
    for s, (_b, pr) in sorted(waves.items()):
        if "error" in pr:
            continue
        print(f"    {s:34s} tag={pr['tag']} ch={pr['channels']} rate={pr['rate']} "
              f"bits={pr['bits']} {pr['seconds']:.3f}s")
    for w in warns:
        print(f"  WARN  {w}")
    for e in errors:
        print(f"  ERROR {e}")
    if not errors:
        print("  AUDIO OK")
    return 0 if not errors else 1


# ---------------------------------------------------------------------- strings
#
# The string table, and the one place this tool writes something retail-derived — INTO THE
# PLAYER'S OWN INSTALL, from the player's own files, never into a pack and never into the repo.
# `rts compile` emits `labels.str` holding only the labels a pack invents; the merge below adds
# them to the 6,422 already there and writes the result where the engine will read it.
#
# WHY A MERGE IS THE ONLY OPTION. A faction's name is resolved at INI PARSE TIME —
# `DisplayName` is `INI::parseAndTranslateLabel`, which calls `TheGameText->fetch` as the Object
# files load at boot and stores the resulting string on the template. No per-map channel can
# reach it. And `GameTextManager::init` picks `Data/Generals.str` OR `Data/<lang>/generals.csf`
# in an if/else, with `m_useStringFile = TRUE` in release builds — so a .str does not extend the
# table, it REPLACES it, and a partial one turns all 6,422 retail labels into MISSING.

CSF_MAGIC = (b" FSC", b"CSF ")


def csf_read(b):
    """Decode a compiled string table. Format: a 24-byte header, then one ' LBL' record per
    label carrying its strings. String bytes are UTF-16LE with every byte INVERTED (~x) — the
    obfuscation is the only part that is not obvious, and reading it as plain UTF-16 yields
    mojibake rather than an error."""
    if b[:4] not in CSF_MAGIC:
        raise ValueError("not a CSF (bad magic)")
    ver, nlbl, nstr, _unused, lang = struct.unpack("<IIIII", b[4:24])
    p, out = 24, []
    for _ in range(nlbl):
        while p + 4 <= len(b) and b[p:p + 4] != b" LBL":
            p += 1
        cnt, ln = struct.unpack("<II", b[p + 4:p + 12])
        p += 12
        name = b[p:p + ln].decode("latin-1")
        p += ln
        val = ""
        for i in range(cnt):
            kind = b[p:p + 4]
            p += 4
            (sl,) = struct.unpack("<I", b[p:p + 4])
            p += 4
            text = bytes(255 - x for x in b[p:p + sl * 2]).decode("utf-16-le", "replace")
            p += sl * 2
            if i == 0:
                val = text
            if kind == b"WRTS":                      # a trailing author note; skipped
                (el,) = struct.unpack("<I", b[p:p + 4])
                p += 4 + el
        out.append((name, val))
    return {"version": ver, "language": lang, "labels": out}


# The escape contract, read off GameTextManager rather than guessed. `readToEndOfQuote` runs a
# slash state machine and stops at an UNESCAPED quote; `translateCopy` then converts the pairs.
# Six are recognised and everything else after a backslash is passed through.
STR_ESCAPES = {"\\": "\\", "'": "'", '"': '"', "?": "?", "t": "\t", "n": "\n"}

# COMMENTS ARE `//`, NOT `;`. parseStringFile tests `*(unsigned short*)buffer == 0x2F2F`, so a
# semicolon line is not a comment — it is read as a LABEL, and the line after it as that label's
# text. A `;`-commented header therefore does not annotate the file, it corrupts the first two
# entries and shifts nothing else, which is why it produces no error.
STR_COMMENT = "//"


def str_read(path):
    """Parse a .str: LABEL / "text" / END, repeating. Retail ships these beside its campaign
    maps (MD_GLA02_CINE/Map.str and friends), so the format is theirs, not an invention here."""
    out, label = [], None
    for raw in open(path, encoding="latin-1"):
        line = raw.strip()
        if not line or line.startswith(STR_COMMENT):
            continue
        if label is None:
            label = line
        elif line.lower() == "end":
            label = None
        elif line.startswith('"'):
            out.append((label, str_unescape(str_quoted(line))))
    return out


def str_quoted(line):
    """The text between the opening quote and the first UNESCAPED closing one.

    `line.strip('"')` is the obvious version and it is wrong: 3 of retail's 6,422 labels end in
    an escaped quote (`... <sarcastic> \\"General.\\""`), and strip() removes BOTH trailing
    quote characters, silently truncating the text by one. The engine does not have this bug
    because `readToEndOfQuote` runs a slash state machine; so does this."""
    out, slash = [], False
    for c in line[1:]:
        if slash:
            out.append(c)
            slash = False
        elif c == "\\":
            out.append(c)
            slash = True
        elif c == '"':
            break
        else:
            out.append(c)
    return "".join(out)


def str_unescape(t):
    out, i = [], 0
    while i < len(t):
        c = t[i]
        if c == "\\" and i + 1 < len(t):
            nxt = t[i + 1]
            out.append(STR_ESCAPES.get(nxt, nxt))
            i += 2
        else:
            out.append(c)
            i += 1
    return "".join(out)


def str_escape(t):
    """Inverse of translateCopy for the characters that would otherwise break the file. A real
    newline is the one that MATTERS and the one easy to miss: 772 of retail's 6,422 labels
    contain one, a .str is line-oriented, and an unescaped newline inside a quoted string is
    read as a space — so the text survives looking subtly wrong rather than failing."""
    out = []
    for c in t:
        if c == "\\":
            out.append("\\\\")
        elif c == '"':
            out.append('\\"')
        elif c == "\n":
            out.append("\\n")
        elif c == "\t":
            out.append("\\t")
        elif c == "\r":
            continue
        else:
            out.append(c)
    return "".join(out)


def csf_find(game):
    """The install's own table, wherever it lives — loose first, then the archives.

    THREE copies ship and they are not interchangeable: `English.big` (base Generals, 2,806
    labels), `W3DEnglishZH.big` and `EnglishZH.big` (Zero Hour, 6,422). ZH is a DELTA over base
    Generals, so taking whichever the scan reached last silently halves the table and every
    Zero Hour label reads MISSING — which looks exactly like the bug you were trying to fix.
    Choose by CONTENT instead of by scan order: decode each candidate and keep the richest.
    Empirical, and it cannot be broken by a change in directory ordering."""
    loose = os.path.join(game, "Data", "English", "generals.csf")
    if os.path.isfile(loose):
        return open(loose, "rb").read(), loose
    best = None
    for arc in all_archives(game):
        try:
            toc = big_toc(arc)
        except Exception:
            continue
        for n, o, sz in toc:
            if not n.lower().endswith("generals.csf"):
                continue
            with open(arc, "rb") as f:
                f.seek(o)
                blob = f.read(sz)
            try:
                cnt = len(csf_read(blob)["labels"])
            except Exception:
                continue
            if best is None or cnt > best[2]:
                best = (blob, f"{os.path.basename(arc)}:{n}", cnt)
    return (best[0], best[1]) if best else (None, None)


def cmd_strings(a):
    data, src = csf_find(a.game)
    if data is None:
        return print(f"  no generals.csf under {a.game} — is this an install?")
    try:
        csf = csf_read(data)
    except Exception as e:
        return print(f"  {src}: {e}")

    if not a.merge:
        print(f"  {src}: version={csf['version']} language={csf['language']} "
              f"{len(csf['labels'])} labels")
        if a.grep:
            hits = [(k, v) for k, v in csf["labels"] if a.grep.lower() in k.lower()]
            print(f"  {len(hits)} matching '{a.grep}'")
            for k, v in hits[:a.limit]:
                print(f"    {k} = {v!r}")
        return 0

    pack_str = os.path.join(a.merge, "labels.str")
    if not os.path.isfile(pack_str):
        return print(f"  no {pack_str} — compile the pack first (rts compile --target zh)")
    ours = str_read(pack_str)
    if not ours:
        return print(f"  {pack_str} declares no labels")

    # Retail first, ours second, ours winning a collision. A pack SHOULD NOT collide — every
    # label it emits is pack-prefixed — so a collision is reported rather than absorbed.
    merged, seen = [], {}
    for k, v in csf["labels"]:
        seen[k] = len(merged)
        merged.append((k, v))
    clashes = []
    for k, v in ours:
        if k in seen:
            clashes.append(k)
            merged[seen[k]] = (k, v)
        else:
            merged.append((k, v))

    # Every label's text must survive latin-1: translateCopy widens BYTES to WideChar, so the
    # file's encoding is effectively latin-1 and a character above U+00FF cannot be represented.
    # Measured on this install: 244 of 6,422 labels are non-ASCII and NONE exceed U+00FF, so the
    # table round-trips exactly — but check rather than assume, because a silent substitution
    # here would corrupt a credit line nobody reads until someone does.
    lossy = [k for k, v in merged if any(ord(c) > 255 for c in v)]
    if lossy:
        print(f"  {len(lossy)} labels contain characters a .str cannot hold: {lossy[:3]}")
        return 1

    out = a.out or os.path.join(a.game, "Data", "Generals.str")
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w", encoding="latin-1") as f:
        f.write(f"{STR_COMMENT} Generals.str - MERGED LOCALLY by `zhasset strings --merge`.\n")
        f.write(f"{STR_COMMENT} {len(csf['labels'])} labels from this install's own {src}\n")
        f.write(f"{STR_COMMENT} + {len(ours)} authored by the pack.\n")
        f.write(f"{STR_COMMENT} DERIVED FROM YOUR INSTALL. Not distributable.\n")
        f.write(f"{STR_COMMENT} Delete it to fall back to the shipped generals.csf.\n\n")
        for k, v in merged:
            f.write(f"{k}\n\"{str_escape(v)}\"\nEND\n\n")

    # Read our own output back and compare. A writer verified by nothing is how 772 newline-
    # bearing labels would ship subtly wrong; this costs milliseconds and closes the loop.
    back = dict(str_read(out))
    bad = [k for k, v in merged if back.get(k) != v]
    if bad:
        print(f"  ROUND-TRIP FAILED for {len(bad)} labels, e.g. {bad[:3]}")
        return 1

    print(f"  {out}")
    print(f"  {len(csf['labels'])} retail + {len(ours)} authored = {len(merged)} labels, "
          f"round-tripped")
    if clashes:
        print(f"  {len(clashes)} OVERRODE a retail label: {', '.join(clashes[:5])}")
    print("  (delete Data/Generals.str to revert to the shipped generals.csf)")
    return 0


