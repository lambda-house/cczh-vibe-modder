def cmd_artprofile(a):
    """Measure the CONTRACT that comes with each adoptable mesh.

    A model renders for free. It does not BEHAVE for free: dimensions, weapon bones, the
    muzzle-flash sub-object and whether it has a turret all have to be declared, and every
    one of them fails silently — the pack lints, compiles, boots 42/42 and plays wrong.
    Adopting one model (AVCrusader) hit all four.

    So rather than hand-copy numbers per unit, measure them from the objects that already
    use each mesh. The profile is keyed by MODEL, because the contract belongs to the mesh.

    Output goes to reference/ and is gitignored: this extractor may ship, its extract may not.
    """
    prof = {}
    objdir = os.path.join(a.ini, "Object")
    files = sorted(f for f in os.listdir(objdir) if f.lower().endswith(".ini"))
    for fn in files:
        for kind, name, lines in ini_blocks(os.path.join(objdir, fn)):
            if kind != "Object":
                continue
            body = "\n".join(lines)

            # First model of the first Draw block: the mesh this object presents.
            m = re.search(r"^\s*Model\s*=\s*(\S+)", body, re.M)
            if not m:
                continue
            model = m.group(1)
            if model.lower() in ("none", "nomodel"):
                continue

            geom = field(lines, "Geometry")
            entry = {
                "model": model,
                "geometry": geom,
                "majorRadius": field(lines, "GeometryMajorRadius"),
                "minorRadius": field(lines, "GeometryMinorRadius"),
                "height": field(lines, "GeometryHeight"),
                "isSmall": field(lines, "GeometryIsSmall"),
                # A turret is declared INSIDE AIUpdateInterface, so a plain field lookup
                # misses it; the weapon simply never bears without one.
                # TWO different Turret concepts, and they live in different modules:
                #   AIUpdateInterface { Turret { ... } }  -- the LOGIC turret: turn rate, slots
                #   Draw { DefaultConditionState { Turret = <bone> } } -- the ART bone to spin
                # Declaring only the first gives a unit that aims and fires with a welded
                # turret. Retail carries 516 of the second.
                "turret": bool(re.search(r"^\s*Turret\s*$", body, re.M)),
                "turretBone": (lambda m: m.group(1) if m else None)(
                    re.search(r"^\s*Turret\s*=\s*(\S+)", body, re.M)),
                "launchBone": None, "fireFXBone": None, "muzzleFlash": None,
                "unitCreatePoint": None, "naturalRallyPoint": None,
                # Death presentation is part of the mesh's contract too: OCL_CrusaderTurret
                # throws THIS tank's turret, so it only makes sense on this mesh. Taken from
                # the peer's DEFAULT-death block — the SlowDeathBehavior whose DeathTypes
                # include ALL — because the common ones in the corpus are toxin/crush variants
                # that fire only for those damage types.
                "deathFX": None, "deathOCL": None, "deathFXFinal": None, "deathOCLFinal": None,
                "kind": "structure" if "STRUCTURE" in (field(lines, "KindOf") or "") else "mobile",
                "usedBy": [name],
            }
            for sd in re.finditer(r"Behavior\s*=\s*SlowDeathBehavior(.*?)^\s*End", body, re.S | re.M):
                blk = sd.group(1)
                if not re.search(r"DeathTypes\s*=\s*ALL", blk):
                    continue                                    # a toxin/crush variant, not the default
                for phase, name in re.findall(r"^\s*FX\s*=\s*(\w+)\s+(\S+)", blk, re.M):
                    if phase == "INITIAL": entry["deathFX"] = name
                    if phase == "FINAL": entry["deathFXFinal"] = name
                for phase, name in re.findall(r"^\s*OCL\s*=\s*(\w+)\s+(\S+)", blk, re.M):
                    if phase == "MIDPOINT": entry["deathOCL"] = name
                    if phase == "FINAL": entry["deathOCLFinal"] = name
                break

            for key, dest in (("WeaponLaunchBone", "launchBone"),
                              ("WeaponFireFXBone", "fireFXBone"),
                              ("WeaponMuzzleFlash", "muzzleFlash"),
                              ("UnitCreatePoint", "unitCreatePoint"),
                              ("NaturalRallyPoint", "naturalRallyPoint")):
                mm = re.search(rf"^\s*{key}\s*=\s*(.+)$", body, re.M)
                if mm:
                    v = mm.group(1).strip()
                    # Bone fields are "PRIMARY <bone>"; keep only the bone.
                    if dest.endswith("Bone") or dest == "muzzleFlash":
                        parts = v.split()
                        v = parts[-1] if parts else v
                    entry[dest] = v

            if model in prof:
                # Several objects share a mesh. Keep the FIRST (files and blocks are walked
                # in sorted order, so this is deterministic) and record the rest, because a
                # disagreement between them is exactly the ambiguity an author needs to see.
                prof[model]["usedBy"].append(name)
            else:
                prof[model] = entry

    os.makedirs(a.out, exist_ok=True)
    dest = os.path.join(a.out, "art-profiles.json")

    # PRESERVE AUTHORED ENTRIES. The catalogue is measured for adopted art and DECLARED for
    # art we wrote ourselves (zhasset w3dbox writes its own profile). Regenerating from retail
    # would silently delete every authored mesh's contract, and the compiler would fall back to
    # guessed geometry — which is how a building swallows the units it builds. Found by the
    # objectdiff gate the moment a rebuild clobbered RTSBOX.
    if os.path.exists(dest):
        try:
            old = json.load(open(dest)).get("models", {})
        except (ValueError, OSError):
            old = {}
        kept = {k: v for k, v in old.items() if v.get("kind") == "authored"}
        for k, v in kept.items():
            prof.setdefault(k, v)
        if kept:
            print(f"  preserved {len(kept)} authored profile(s): {', '.join(sorted(kept))}")

    with open(dest, "w") as f:
        json.dump({"models": prof}, f, indent=1, sort_keys=True)

    turreted = sum(1 for v in prof.values() if v["turret"])
    withbone_t = sum(1 for v in prof.values() if v.get("turretBone"))
    withbone = sum(1 for v in prof.values() if v["launchBone"])
    withflash = sum(1 for v in prof.values() if v["muzzleFlash"])
    structures = sum(1 for v in prof.values() if v["kind"] == "structure")
    shared = sum(1 for v in prof.values() if len(v["usedBy"]) > 1)
    print(f"art profiles -> {dest}")
    print(f"  {len(prof)} adoptable meshes measured from {len(files)} Object files")
    print(f"  {structures} structures, {len(prof) - structures} mobile")
    print(f"  {turreted} turreted ({withbone_t} naming an art turret bone), "
          f"{withbone} with a launch bone, {withflash} with a muzzle flash")
    withdeath = sum(1 for v in prof.values() if v.get("deathFX") or v.get("deathFXFinal"))
    print(f"  {withdeath} carry default-death FX/OCL (explosion, debris, thrown turret)")
    print(f"  {shared} meshes are used by more than one object (profile taken from the first)")
    return 0


# ---------------------------------------------------------------- W3D (mesh/skeleton/anim)
# Format is IFF-style chunks: uint32 type, uint32 size whose HIGH BIT means "contains
# subchunks". The authoritative taxonomy is EA's own GPL header,
# Generals/Code/Libraries/Source/WWVegas/WW3D2/w3d_file.h -- engine SOURCE, so it is readable,
# re-implementable, and the reason a from-scratch art pipeline is real rather than reverse
# engineering.
#
# NOT Tools/WW3D/pluglib/w3d_file.h, which is a STALE COPY: its chunk enum stops at 0x600, it
# has no HLOD family at all, and it still calls the mesh header field HierarchyModelName where
# the live one says ContainerName. Everything static we wrote happened not to touch the
# difference; skinning does, because skinning needs HLOD.
W3D_CHUNKS = {
    0x0000: "MESH", 0x0001: "MESH_HEADER", 0x0002: "VERTICES", 0x0003: "VERTEX_NORMALS",
    0x000C: "MESH_USER_TEXT", 0x000E: "VERTEX_INFLUENCES", 0x001F: "MESH_HEADER3",
    0x0020: "TRIANGLES",
    0x0022: "VERTEX_SHADE_INDICES", 0x0023: "PRELIT_UNLIT", 0x0024: "PRELIT_VERTEX",
    0x0028: "MATERIAL_INFO", 0x0029: "SHADERS", 0x002A: "VERTEX_MATERIALS",
    0x002B: "VERTEX_MATERIAL", 0x002C: "VERTEX_MATERIAL_NAME", 0x002D: "VERTEX_MATERIAL_INFO",
    0x0030: "TEXTURES", 0x0031: "TEXTURE", 0x0032: "TEXTURE_NAME", 0x0033: "TEXTURE_INFO",
    0x0038: "MATERIAL_PASS", 0x0039: "VERTEX_MATERIAL_IDS", 0x003A: "SHADER_IDS",
    0x003B: "DCG", 0x003C: "DIG", 0x003E: "SCG", 0x0048: "TEXTURE_STAGE",
    0x0049: "TEXTURE_IDS", 0x004A: "STAGE_TEXCOORDS", 0x004B: "PER_FACE_TEXCOORD_IDS",
    0x0100: "HIERARCHY", 0x0101: "HIERARCHY_HEADER", 0x0102: "PIVOTS", 0x0103: "PIVOT_FIXUPS",
    0x0200: "ANIMATION", 0x0201: "ANIMATION_HEADER", 0x0202: "ANIMATION_CHANNEL",
    0x0203: "BIT_CHANNEL", 0x0280: "COMPRESSED_ANIMATION",
    0x0281: "COMPRESSED_ANIMATION_HEADER", 0x0282: "COMPRESSED_ANIMATION_CHANNEL",
    0x0300: "HMODEL", 0x0301: "HMODEL_HEADER", 0x0700: "HLOD", 0x0701: "HLOD_HEADER",
    0x0702: "HLOD_LOD_ARRAY", 0x0703: "HLOD_SUB_OBJECT_ARRAY_HEADER",
    0x0704: "HLOD_SUB_OBJECT", 0x0740: "BOX", 0x0750: "AGGREGATE",
}


def w3d_walk(buf, off=0, end=None, depth=0, acc=None):
    """Yield (depth, name, type, size, payload) for every chunk, recursing into containers."""
    end = len(buf) if end is None else end
    while off + 8 <= end:
        ctype, raw = struct.unpack_from("<II", buf, off)
        size = raw & 0x7FFFFFFF
        has_sub = bool(raw & 0x80000000)
        body = off + 8
        name = W3D_CHUNKS.get(ctype, f"0x{ctype:04X}")
        yield depth, name, ctype, size, buf[body:body + size]
        if has_sub:
            yield from w3d_walk(buf, body, body + size, depth + 1, acc)
        off = body + size


def w3d_tree(buf, off=0, end=None):
    """Parse into a tree of (type, payload, [children]). Lossless: a container's payload is
    kept as None and rebuilt from children, a leaf keeps its exact bytes."""
    end = len(buf) if end is None else end
    nodes = []
    while off + 8 <= end:
        ctype, raw = struct.unpack_from("<II", buf, off)
        size, has_sub = raw & 0x7FFFFFFF, bool(raw & 0x80000000)
        body = off + 8
        if has_sub:
            nodes.append((ctype, None, w3d_tree(buf, body, body + size)))
        else:
            nodes.append((ctype, buf[body:body + size], []))
        off = body + size
    return nodes


def w3d_emit(nodes):
    """Serialise a tree back to bytes. The high bit of `size` marks a container, so it has to
    be recomputed from the children rather than remembered — which is what makes this a real
    writer and not a memcpy."""
    out = bytearray()
    for ctype, payload, kids in nodes:
        if kids:
            body = w3d_emit(kids)
            out += struct.pack("<II", ctype, len(body) | 0x80000000) + body
        else:
            out += struct.pack("<II", ctype, len(payload)) + payload
    return bytes(out)


def cmd_w3dround(a):
    """Parse a .w3d and write it back. Byte-identical output is the only honest proof that
    the reader understands the container completely — anything less means a re-model built on
    this parser would silently drop chunks the engine needs."""
    src = open(a.file, "rb").read()
    tree = w3d_tree(src)
    out = w3d_emit(tree)
    same = out == src
    print(f"{os.path.basename(a.file)}: {len(src):,} bytes in, {len(out):,} out, "
          f"{'BYTE-IDENTICAL' if same else 'DIFFERS'}")
    if not same:
        for i in range(min(len(src), len(out))):
            if src[i] != out[i]:
                print(f"  first difference at byte {i}: {src[i]:#04x} != {out[i]:#04x}")
                break
        return 1
    if a.write:
        open(a.write, "wb").write(out)
        print(f"  wrote {a.write}")
    return 0


def _shape_box(sx, sy, sz, segs, smooth=False):
    hx, hy, hz = sx / 2.0, sy / 2.0, sz / 2.0
    faces = [
        ([(-hx,-hy, hz), ( hx,-hy, hz), ( hx, hy, hz), (-hx, hy, hz)], ( 0, 0, 1)),
        ([( hx,-hy,-hz), (-hx,-hy,-hz), (-hx, hy,-hz), ( hx, hy,-hz)], ( 0, 0,-1)),
        ([(-hx,-hy,-hz), ( hx,-hy,-hz), ( hx,-hy, hz), (-hx,-hy, hz)], ( 0,-1, 0)),
        ([( hx, hy,-hz), (-hx, hy,-hz), (-hx, hy, hz), ( hx, hy, hz)], ( 0, 1, 0)),
        ([( hx,-hy,-hz), ( hx, hy,-hz), ( hx, hy, hz), ( hx,-hy, hz)], ( 1, 0, 0)),
        ([(-hx, hy,-hz), (-hx,-hy,-hz), (-hx,-hy, hz), (-hx, hy, hz)], (-1, 0, 0)),
    ]
    v, n, uv, t = [], [], [], []
    for fi, (quad, nm) in enumerate(faces):
        b = fi * 4
        v += quad; n += [nm] * 4
        # Two in-plane axes of this face, in world units.
        ax = [k for k in range(3) if abs(nm[k]) < 0.5]
        uv += [(q[ax[0]], q[ax[1]]) for q in quad]
        t += [(b, b+1, b+2), (b, b+2, b+3)]
    return v, n, uv, t


def _shape_cylinder(sx, sy, sz, segs, smooth=True):
    """An n-gon prism. Vertex and triangle counts BOTH scale with segs, which is the point:
    it is only expressible once MESH_HEADER3's counts are rewritten."""
    import math
    rx, ry, h = sx / 2.0, sy / 2.0, sz
    v, n, uv, t = [], [], [], []
    for i in range(segs):
        a0 = 2 * math.pi * i / segs
        a1 = 2 * math.pi * (i + 1) / segs
        x0, y0 = rx * math.cos(a0), ry * math.sin(a0)
        x1, y1 = rx * math.cos(a1), ry * math.sin(a1)
        b = len(v)
        v += [(x0, y0, 0), (x1, y1, 0), (x1, y1, h), (x0, y0, h)]
        if smooth:
            # Each vertex gets its OWN outward radial normal, so the renderer interpolates
            # around the curve and the wall reads as round. Adjacent quads duplicate the edge
            # position but agree on its normal, which is what makes the seam invisible —
            # sharing vertices is not required, agreeing on normals is.
            n0 = (x0 / (math.hypot(x0, y0) or 1.0), y0 / (math.hypot(x0, y0) or 1.0), 0.0)
            n1 = (x1 / (math.hypot(x1, y1) or 1.0), y1 / (math.hypot(x1, y1) or 1.0), 0.0)
            n += [n0, n1, n1, n0]
        else:
            mx, my = (x0 + x1) / 2.0, (y0 + y1) / 2.0
            ln = math.hypot(mx, my) or 1.0
            n += [(mx / ln, my / ln, 0.0)] * 4
        # World-space arc length, not the parametric 0..1. Normalising per-surface gives
        # every face the whole texture regardless of its size, which is why a 251-unit
        # circumference and an 80-unit cap ended up with cells 3x different in world scale.
        arc = 2 * math.pi * ((rx + ry) / 2.0)
        u0, u1 = arc * i / segs, arc * (i + 1) / segs
        uv += [(u0, 0.0), (u1, 0.0), (u1, h), (u0, h)]
        t += [(b, b+1, b+2), (b, b+2, b+3)]
    # Caps: one fan vertex per ring vertex, kept unshared so normals stay flat.
    for z, nz, wind in ((0.0, (0,0,-1), False), (h, (0,0,1), True)):
        c = len(v); v.append((0.0, 0.0, z)); n.append(nz); uv.append((0.0, 0.0))
        ring = []
        for i in range(segs):
            a = 2 * math.pi * i / segs
            ring.append(len(v))
            v.append((rx * math.cos(a), ry * math.sin(a), z)); n.append(nz)
            uv.append((rx * math.cos(a), ry * math.sin(a)))
        for i in range(segs):
            i0, i1 = ring[i], ring[(i + 1) % segs]
            t.append((c, i0, i1) if wind else (c, i1, i0))
    return v, n, uv, t


def _shape_pyramid(sx, sy, sz, segs, smooth=True):
    import math
    rx, ry, h = sx / 2.0, sy / 2.0, sz
    v, n, uv, t = [], [], [], []
    for i in range(segs):
        a0 = 2 * math.pi * i / segs
        a1 = 2 * math.pi * (i + 1) / segs
        p0 = (rx * math.cos(a0), ry * math.sin(a0), 0.0)
        p1 = (rx * math.cos(a1), ry * math.sin(a1), 0.0)
        ap = (0.0, 0.0, h)
        b = len(v); v += [p0, p1, ap]
        ux, uy, uz = p1[0]-p0[0], p1[1]-p0[1], 0.0
        wx, wy, wz = ap[0]-p0[0], ap[1]-p0[1], h
        cx, cy, cz = uy*wz - uz*wy, uz*wx - ux*wz, ux*wy - uy*wx
        ln = math.sqrt(cx*cx + cy*cy + cz*cz) or 1.0
        face = (cx/ln, cy/ln, cz/ln)
        if smooth:
            # Blend the outward radial direction into the face normal at the base corners; the
            # apex keeps the face normal because a cone tip has no single well-defined one.
            def outward(px, py):
                d = math.hypot(px, py) or 1.0
                return (px/d, py/d, 0.0)
            def mix(u, w):
                m = tuple((u[k] + w[k]) / 2.0 for k in range(3))
                d = math.sqrt(sum(c*c for c in m)) or 1.0
                return tuple(c/d for c in m)
            n += [mix(face, outward(p0[0], p0[1])), mix(face, outward(p1[0], p1[1])), face]
        else:
            n += [face] * 3
        import math as _m
        base_len = _m.dist(p0, p1)
        slant = _m.dist(p0, ap)
        uv += [(0.0, 0.0), (base_len, 0.0), (base_len / 2.0, slant)]
        t.append((b, b+1, b+2))
    c = len(v); v.append((0.0,0.0,0.0)); n.append((0,0,-1)); uv.append((0.0, 0.0))
    ring = []
    for i in range(segs):
        a = 2 * math.pi * i / segs
        ring.append(len(v)); v.append((rx*math.cos(a), ry*math.sin(a), 0.0))
        n.append((0,0,-1)); uv.append((rx*math.cos(a), ry*math.sin(a)))
    for i in range(segs):
        t.append((c, ring[(i+1) % segs], ring[i]))
    return v, n, uv, t


SHAPES = {"box": _shape_box, "cylinder": _shape_cylinder, "pyramid": _shape_pyramid}


def _obj_keys(body):
    """Every INI key an Object block sets, at any depth, plus the module CLASSES it declares.

    Depth is deliberately flattened. Retail's indentation is inconsistent enough that tracking
    nesting is fragile, and the bugs that actually bit us — InitialHealth inside Body, Turret
    inside DefaultConditionState — are all "is this key present anywhere", which a flat set
    answers reliably.
    """
    keys, mods = set(), set()
    for line in body.split("\n"):
        line = line.split(";")[0].strip()
        if not line or line.lower() == "end":
            continue
        m = re.match(r"(\w+)\s*=\s*(.*)$", line)
        if m:
            key, val = m.group(1), m.group(2).strip()
            keys.add(key)
            if key in ("Behavior", "Draw", "Body", "ClientUpdate"):
                cls = val.split()[0] if val else ""
                if cls:
                    mods.add(f"{key}:{cls}")
        else:
            # A bare block header, e.g. `Turret` or `DefaultConditionState`.
            if re.match(r"^\w+$", line):
                keys.add(line)
    return keys, mods


def cmd_objectdiff(a):
    """Compare our EMITTED objects against the retail objects that use the same mesh.

    Four bugs in a row were the same shape: a field whose absence is SILENT and whose default
    is wrong for our case. InitialHealth defaults to 0, not MaxHealth. The art-side
    `Turret = <bone>` defaults to no bone, not "find one named TURRET". ProductionUpdate and
    PhysicsBehavior are simply absent. None error, none warn, and each was found only by
    someone playing the game and noticing.

    So stop finding them one bug report at a time: for every object we emit, look up the retail
    objects that share its mesh and report what they set that we do not. Frequency across those
    objects is the priority signal — a key every one of them sets is far more likely to matter
    than one that a single unit uses.
    """
    ours = {}
    for fn in sorted(os.listdir(a.emitted)):
        if not fn.lower().endswith(".ini"):
            continue
        t = open(os.path.join(a.emitted, fn), encoding="latin-1").read().replace("\r", "")
        for m in re.finditer(r"^Object (\S+)$(.*?)^End$", t, re.S | re.M):
            name, body = m.group(1), m.group(2)
            mm = re.search(r"^\s*Model\s*=\s*(\S+)", body, re.M)
            ours[name] = (mm.group(1) if mm else None, *_obj_keys(body))

    # Retail, indexed by the mesh each object presents.
    by_model = defaultdict(list)
    objdir = os.path.join(a.ini, "Object")
    for fn in sorted(os.listdir(objdir)):
        t = open(os.path.join(objdir, fn), encoding="latin-1").read().replace("\r", "")
        for m in re.finditer(r"^Object (\S+)$(.*?)^End$", t, re.S | re.M):
            name, body = m.group(1), m.group(2)
            mm = re.search(r"^\s*Model\s*=\s*(\S+)", body, re.M)
            if not mm:
                continue
            by_model[mm.group(1).upper()].append((name, *_obj_keys(body)))

    # Triage, because the raw diff is noise: peers are variants of the SAME unit, so every
    # quirk of that unit (a medic's healing, a drone's slaving, a truck's tyre bones) shows up
    # as "all peers set it". What matters is which absences change BEHAVIOUR.
    BEHAVIOUR = {
        "ExperienceValue", "ExperienceRequired", "IsTrainable",      # veterancy cannot progress
        "CrusherLevel", "CrushableLevel",                            # who can drive over whom
        "TransportSlotCount",                                        # can it be carried
        "GeometryIsSmall",                                           # selection and collision
        "RadarPriority",                                             # appears on radar at all
        "BuildVariations",
    }
    # Known false positives, excluded deliberately rather than left to be re-triaged:
    #   Prerequisites   a unit with none legitimately omits the block
    #   MaxQueueEntries lives on ProductionUpdate and defaults to 9, which is fine
    COSMETIC = {"Shadow", "ShadowSizeX", "ShadowSizeY", "ShadowTexture", "DisplayName",
                "ConditionState", "OkToChangeModelColor", "DamageFX", "DeathFX", "FX", "OCL",
                "TrackMarks", "Dust", "DirtSpray", "ReallyDamagedFXList1",
                "ReallyDamagedParticleSystem1", "AflameDuration", "AflameDamageAmount",
                "AflameDamageDelay", "UpgradeCameo1", "UpgradeCameo2", "UpgradeCameo3",
                "UpgradeCameo4", "UpgradeCameo5"}

    total_missing = Counter()
    for name in sorted(ours):
        model, okeys, omods = ours[name]
        peers = by_model.get((model or "").upper(), [])
        if not peers:
            print(f"\n{name}  (mesh {model}: no retail object uses it — nothing to compare)")
            continue
        # A key counts as missing only if EVERY peer sets it; one unit's quirk is not a gap.
        common_keys = set.intersection(*[p[1] for p in peers])
        common_mods = set.intersection(*[p[2] for p in peers])
        miss_k = sorted(common_keys - okeys)
        miss_m = sorted(common_mods - omods)
        print(f"\n{name}  (mesh {model}, {len(peers)} retail peer(s): {', '.join(p[0] for p in peers[:3])})")
        if miss_m:
            print(f"  modules ALL peers have and we do not: {', '.join(miss_m)}")
        beh = [k for k in miss_k if k in BEHAVIOUR]
        cos = [k for k in miss_k if k in COSMETIC]
        other = [k for k in miss_k if k not in BEHAVIOUR and k not in COSMETIC]
        if beh:
            print(f"  BEHAVIOUR gaps: {', '.join(beh)}")
        if cos and a.verbose:
            print(f"  cosmetic:       {', '.join(cos)}")
        if other and a.verbose:
            print(f"  peer-specific:  {', '.join(other[:12])}{' …' if len(other) > 12 else ''}")
        if not beh and not miss_m:
            print("  no behaviour gaps")
        for k in beh: total_missing[k] += 1

    if total_missing:
        print("\nBEHAVIOUR gaps across our objects, most common first:")
        for k, n in total_missing.most_common(15):
            print(f"  {n:2}x  {k}")
    else:
        print("\nno behaviour gaps in any emitted object")
    return 0


def cmd_tga(a):
    """Author a texture. Uncompressed 24-bit TGA, which is the one image format here that can
    be written with no library at all: an 18-byte header then BGR triples, bottom-up.

    Retail is 3,496 .dds against 50 .tga, so .dds is the house format — but .tga is shipped and
    supported, and it is the format a from-scratch pipeline can emit today without pulling in a
    DXT compressor. The grid pattern is deliberate: a flat colour would prove the file loads,
    while a grid also proves the UV layout the mesh writer generates is CORRECT, because wrong
    UVs show up as smeared or repeated cells rather than squares.
    """
    if a.sheet:
        return tga_icon_sheet(a)
    w = h = a.size
    cell = max(1, w // a.cells)
    px = bytearray()
    for y in range(h):                                  # bottom-up, per the TGA descriptor
        for x in range(w):
            edge = x < 2 or y < 2 or x >= w - 2 or y >= h - 2
            checker = ((x // cell) + (y // cell)) % 2 == 0
            if edge:
                r, g, b = 255, 96, 0                    # orange border marks the UV extent
            elif checker:
                r, g, b = a.rgb
            else:
                r, g, b = (int(c * 0.45) for c in a.rgb)
            px += bytes((b, g, r))                      # TGA is BGR

    hdr = struct.pack("<BBBHHBHHHHBB",
                      0,      # id length
                      0,      # no colour map
                      2,      # uncompressed true-colour
                      0, 0, 0,
                      0, 0,   # origin
                      w, h,
                      24,     # bits per pixel
                      0)      # descriptor: origin bottom-left
    open(a.out, "wb").write(hdr + bytes(px))
    print(f"authored {a.out}  {18 + len(px):,} bytes")
    print(f"  {w}x{h} 24-bit uncompressed, {a.cells}x{a.cells} grid, rgb{tuple(a.rgb)}, "
          f"orange border marking the UV extent")
    return 0


def tga_write(path, w, h, rows):
    """rows[y][x] = (r,g,b), y ascending from the BOTTOM — TGA's own origin."""
    px = bytearray()
    for y in range(h):
        for x in range(w):
            r, g, b = rows[y][x]
            px += bytes((b, g, r))
    hdr = struct.pack("<BBBHHBHHHHBB", 0, 0, 2, 0, 0, 0, 0, 0, w, h, 24, 0)
    open(path, "wb").write(hdr + bytes(px))
    return 18 + len(px)


def tga_icon_sheet(a):
    """Author a CONTROL BAR icon sheet: one texture, a grid of visually distinct cells, each
    addressed by a MappedImage's Coords rectangle.

    This is how retail does it and the reason is bandwidth, not taste: SAUserInterface512.tga
    is one 512x512 page holding hundreds of button images, and every MappedImage is a
    rectangle into it. Emitting one .tga per icon would work and would also mean a texture
    bind per button.

    Cells are given distinct hues by index so a wrong Coords rectangle is VISIBLE rather than
    merely wrong — two buttons showing the same colour means two entries point at one cell.
    Each carries a darker inset border, which is what makes an off-by-one rectangle legible as
    a sliver of the neighbour rather than as nothing at all.
    """
    n, cell = a.cells, a.size // a.cells
    w = h = cell * n
    rows = [[(18, 20, 26)] * w for _ in range(h)]
    for idx in range(n * n):
        cx, cy = idx % n, idx // n
        # Golden-ratio hue stepping: adjacent indices are far apart in hue, so neighbouring
        # cells never read as the same colour however many there are.
        hue = (idx * 0.6180339887) % 1.0
        i = int(hue * 6); f = hue * 6 - i
        v, p, q, t = 235, 60, int(235 - 175 * f), int(60 + 175 * f)
        rgb = [(v,t,p),(q,v,p),(p,v,t),(p,q,v),(t,p,v),(v,p,q)][i % 6]
        dark = tuple(int(c * 0.35) for c in rgb)
        for y in range(cell):
            for x in range(cell):
                edge = x < 2 or y < 2 or x >= cell - 2 or y >= cell - 2
                rows[cy * cell + y][cx * cell + x] = dark if edge else rgb
    size = tga_write(a.out, w, h, rows)
    print(f"authored {a.out}  {size:,} bytes")
    print(f"  {w}x{h} 24-bit uncompressed icon sheet, {n}x{n} = {n*n} cells of {cell}x{cell}")
    return 0


def cmd_w3dbox(a):
    """Author NEW GEOMETRY into a real mesh: the first step of re-modelling.

    Not a copy and not a scale. Vertices, normals, triangles and texture coordinates are all
    computed here from box dimensions, then written into a template whose MATERIAL / SHADER /
    TEXTURE chunks are kept. That split is deliberate for a first writer: geometry is the part
    we can generate confidently, and material state is a pile of flag words whose defaults are
    not documented anywhere we can verify. New shape on a known-good surface scaffold.

    A 24-vertex / 12-triangle template is a box already, so counts are unchanged and
    MESH_HEADER3's NumVertices / NumTris stay valid — only the bounds have to be recomputed.
    Authoring a different TOPOLOGY means rewriting those counts too, which is the next step.
    """
    src = open(a.template, "rb").read()
    tree = w3d_tree(src)

    sx, sy, sz = a.size
    # Flat for a box (hard edges are correct), smooth for curved surfaces unless overridden.
    smooth = (a.shape != "box") if a.smooth is None else a.smooth
    verts, norms, uvs, tris = SHAPES[a.shape](sx, sy, sz, a.segments, smooth)

    # UVs come out of the generators in WORLD UNITS. Normalise by one global span so texel
    # density is the same everywhere: dividing each surface by its own size is what made the
    # cylinder's side cells 3.1x wider than its cap cells. One divisor keeps the ratio honest
    # and keeps every coordinate inside 0..1, so no texture wrapping is required -- the
    # template's sampler may well clamp, and relying on wrap would be an unverified assumption.
    span = max(max(abs(u) for u, _ in uvs), max(abs(t) for _, t in uvs)) or 1.0
    lo_u = min(u for u, _ in uvs); lo_v = min(t for _, t in uvs)
    uvs = [((u - lo_u) / span, (t - lo_v) / span) for u, t in uvs]

    nbuf = b"".join(struct.pack("<3f", *n) for n in norms)
    tbuf = b"".join(struct.pack("<2f", *t) for t in uvs)
    # One shade index per vertex; the template carries a uint32 array of them.
    sbuf = b"".join(struct.pack("<I", 0) for _ in verts)
    # W3dTriStruct: uint32 Vindex[3], uint32 Attributes, W3dVectorStruct Normal, float32 Dist.
    vbuf = b"".join(struct.pack("<3f", *v) for v in verts)
    fbuf = b""
    for (i0, i1, i2) in tris:
        # The GEOMETRIC plane normal, from the winding — not a vertex normal. These coincide
        # under flat shading, which is why reusing norms[i0] worked until smooth normals made
        # per-vertex normals deliberately differ from the face they sit on. This chunk feeds
        # culling and the plane distance, so it has to be the real face normal.
        p0, p1, p2 = verts[i0], verts[i1], verts[i2]
        ux, uy, uz = (p1[k] - p0[k] for k in range(3))
        vx, vy, vz = (p2[k] - p0[k] for k in range(3))
        cx, cy, cz = uy * vz - uz * vy, uz * vx - ux * vz, ux * vy - uy * vx
        ln = (cx * cx + cy * cy + cz * cz) ** 0.5 or 1.0
        fn = (cx / ln, cy / ln, cz / ln)
        dist = sum(fn[k] * p0[k] for k in range(3))
        fbuf += struct.pack("<3II3ff", i0, i1, i2, 0, *fn, dist)

    # SKINNING. Each vertex is assigned a bone, and its position is rewritten into that bone's
    # LOCAL bind-pose space — the exporter does `pos * Inverse(boneBindWorldTransform)`, and the
    # loader does `world = boneCurrentTransform * stored`. Store world-space positions and the
    # mesh would be displaced by the bone transform the moment it animated.
    # Our skeleton is a pure Z-translation chain, so the inverse is a subtraction.
    bone_of = None
    if a.skin:
        bone_of = []
        split = (mx[2] + mn[2]) / 2.0 if False else None      # placeholder, set after bounds
    xs = [v[0] for v in verts]; ys = [v[1] for v in verts]; zs = [v[2] for v in verts]
    mn = (min(xs), min(ys), min(zs)); mx = (max(xs), max(ys), max(zs))
    ctr = tuple((mn[i] + mx[i]) / 2.0 for i in range(3))
    rad = max(sum((v[i] - ctr[i]) ** 2 for i in range(3)) for v in verts) ** 0.5

    if a.skin:
        # Split at the bone-2 origin: everything above it rides the rotating bone, everything
        # below stays on bone 1. An obvious, checkable division rather than a smooth weight map,
        # because W3D skinning is ONE BONE PER VERTEX with no weights at all.
        split = a.skin_split
        bone_of = [2 if v[2] >= split else 1 for v in verts]
        moved = []
        for v, b in zip(verts, bone_of):
            moved.append((v[0], v[1], v[2] - split) if b == 2 else v)
        verts = moved
        vbuf = b"".join(struct.pack("<3f", *v) for v in verts)
        # Face normals in the TRIANGLES chunk are recomputed below from these same positions,
        # so the bone-local shift stays self-consistent.

    def patch(nodes):
        out = []
        for ctype, payload, kids in nodes:
            if ctype == 0x001F and payload is not None:          # MESH_HEADER3
                h = bytearray(payload)
                if a.name:
                    h[8:24] = a.name.encode("latin-1")[:15].ljust(16, b"\0")
                if a.skin:
                    # Geometry-type bits, not the legacy 0x2 flag the live header calls
                    # obsolete. ContainerName at offset 24 must match what the HLOD sub-object
                    # names, because the render object is looked up as "Container.MeshName".
                    attrs = struct.unpack_from("<I", h, 4)[0]
                    attrs = (attrs & ~0x00FF0000) | 0x00020000
                    struct.pack_into("<I", h, 4, attrs)
                    h[24:40] = (a.name or "SKIN").encode("latin-1")[:15].ljust(16, b"\0")
                # ARBITRARY TOPOLOGY lives here: the counts are what stop a template being
                # anything but the shape it already was. Offsets from W3dMeshHeader3Struct,
                # with W3D_NAME_LEN 16 -- Version, Attributes, MeshName[16], Hierarchy[16].
                struct.pack_into("<I", h, 40, len(tris))          # NumTris
                struct.pack_into("<I", h, 44, len(verts))         # NumVertices
                struct.pack_into("<3f", h, 76, *mn)               # Min
                struct.pack_into("<3f", h, 88, *mx)               # Max
                struct.pack_into("<3f", h, 100, *ctr)             # SphCenter
                struct.pack_into("<f",  h, 112, rad)              # SphRadius
                payload = bytes(h)
            elif ctype == 0x0032 and a.texture:                   # TEXTURE_NAME
                # Null-terminated; the writer recomputes chunk sizes, so a different-length
                # name is fine. The engine resolves the extension itself -- retail meshes name
                # ".tga" for files that ship as ".dds".
                payload = a.texture.encode("latin-1") + b"\0"
            elif ctype == 0x0002: payload = vbuf                  # VERTICES
            elif ctype == 0x0003: payload = nbuf                  # VERTEX_NORMALS
            elif ctype == 0x0020: payload = fbuf                  # TRIANGLES
            elif ctype == 0x0022: payload = sbuf                  # VERTEX_SHADE_INDICES
            elif ctype == 0x004A: payload = tbuf                  # STAGE_TEXCOORDS
            out.append((ctype, payload, patch(kids) if kids else []))
        return out

    tree = patch(tree)

    if a.skin:
        # One W3dVertInfStruct per vertex: uint16 BoneIdx + 6 pad bytes = 8. The loader reads
        # exactly NumVertices entries, so the chunk size IS the contract.
        inf = b"".join(struct.pack("<H6x", b) for b in bone_of)
        out = []
        for ctype, payload, kids in tree:
            if ctype == 0x0000 and kids:                      # MESH
                kids = kids + [(W3D_VERTEX_INFLUENCES, inf, [])]
            out.append((ctype, payload, kids))
        tree = out

        # HLOD is NOT optional for a skin: it is what binds the mesh to a skeleton by NAME, and
        # without it the render object has no HTree and cannot deform. BoneIndex 0 for a skinned
        # sub-object matches every shipped example — deformation comes from the per-vertex
        # influences, not from this field.
        sub = struct.pack("<I", 0) + f"{a.name}.{a.name}".encode("latin-1")[:31].ljust(32, b"\0")
        lod = _chunk(W3D_HLOD_SUBOBJ_HEADER, struct.pack("<If", 1, 3.4028235e38)) \
              + _chunk(W3D_HLOD_SUBOBJ, sub)
        hl = _chunk(W3D_HLOD_HEADER,
                    struct.pack("<II", 0x00010000, 1) + _name16(a.name) + _name16(a.skin)) \
             + _chunk(W3D_HLOD_LOD_ARRAY, lod, container=True)
        tree.append((W3D_HLOD, None, w3d_tree(hl)))

    data = w3d_emit(tree)
    open(a.out, "wb").write(data)
    print(f"authored {a.out}  {len(data):,} bytes")
    print(f"  {a.shape} {sx} x {sy} x {sz} (segs {a.segments}, "
          f"{'smooth' if smooth else 'flat'} normals): {len(verts)} vertices, "
          f"{len(tris)} triangles, {len(uvs)} texcoords — all computed, not copied")
    print(f"  template {os.path.basename(a.template)} supplied MATERIAL_INFO / SHADERS / "
          f"TEXTURES / MATERIAL_PASS unchanged")

    # An AUTHORED mesh knows its own contract — we chose the dimensions — so write the profile
    # alongside it. Otherwise `rts compile` warns that geometry is guessed and falls back to
    # AmericaWarFactory's numbers, which is how a unit ends up inside its own building. The
    # catalogue is measured for adopted art and DECLARED for authored art; either way the
    # compiler gets one answer.
    if a.name:
        cat = os.path.join(a.out_dir or DEF_OUT, "art-profiles.json")
        data = {"models": {}}
        if os.path.exists(cat):
            data = json.load(open(cat))
        data.setdefault("models", {})[a.name] = {
            "model": a.name, "geometry": "BOX",
            "majorRadius": f"{max(mx[0], -mn[0]):.1f}", "minorRadius": f"{max(mx[1], -mn[1]):.1f}",
            "height": f"{mx[2] - mn[2]:.1f}", "isSmall": None, "turret": False,
            "launchBone": None, "fireFXBone": None, "muzzleFlash": None,
            "unitCreatePoint": None, "naturalRallyPoint": None,
            "kind": "authored", "usedBy": ["(authored by zhasset w3dbox)"],
        }
        os.makedirs(os.path.dirname(cat), exist_ok=True)
        json.dump(data, open(cat, "w"), indent=1, sort_keys=True)
        print(f"  profile declared in {cat}: BOX "
              f"{max(mx[0], -mn[0]):.1f} x {max(mx[1], -mn[1]):.1f} x {mx[2]-mn[2]:.1f}")
    return 0


# ---------------------------------------------------------------- skinning + animation
# Struct layouts byte-verified against AIHERO_SKL/SKN/ISTA. Sizes are load-bearing: the loader
# derives element counts by dividing chunk size by struct size, so a wrong size silently yields
# the wrong number of bones, vertices or frames rather than an error.
W3D_HIERARCHY, W3D_HIER_HEADER, W3D_PIVOTS = 0x0100, 0x0101, 0x0102
W3D_VERTEX_INFLUENCES = 0x000E
W3D_HLOD, W3D_HLOD_HEADER, W3D_HLOD_LOD_ARRAY = 0x0700, 0x0701, 0x0702
W3D_HLOD_SUBOBJ_HEADER, W3D_HLOD_SUBOBJ = 0x0703, 0x0704
W3D_ANIMATION, W3D_ANIM_HEADER, W3D_ANIM_CHANNEL = 0x0200, 0x0201, 0x0202
# Geometry-type bits, NOT the legacy W3D_MESH_FLAG_SKIN 0x2 which the live header marks
# "obsolete as of 4.1".
W3D_MESH_GEOMETRY_TYPE_MASK = 0x00FF0000
W3D_MESH_GEOMETRY_TYPE_SKIN = 0x00020000
ANIM_CHANNEL_Q = 6


def _name16(s):
    return s.encode("latin-1")[:15].ljust(16, b"\0")


def _chunk(ctype, payload, container=False):
    return struct.pack("<II", ctype, len(payload) | (0x80000000 if container else 0)) + payload


def cmd_w3dskel(a):
    """Author a SKELETON: W3D_CHUNK_HIERARCHY with a chain of pivots.

    Pivot 0 is always ROOTTRANSFORM with ParentIdx 0xFFFFFFFF — every shipped skeleton does
    this, and the loader asserts the single parentless pivot is index 0. Remaining bones chain
    upward, each translated by its own segment length in its PARENT's space.

    EulerAngles and PIVOT_FIXUPS are both written by the real exporter and both IGNORED by the
    loader (read_pivots builds its transform from Translation + the Rotation quaternion only),
    so this emits neither and stays byte-legal.
    """
    n = a.bones
    pivots = b""
    pivots += _name16("ROOTTRANSFORM") + struct.pack("<I", 0xFFFFFFFF) \
              + struct.pack("<3f", 0, 0, 0) + struct.pack("<3f", 0, 0, 0) \
              + struct.pack("<4f", 0, 0, 0, 1)
    for i in range(1, n):
        # Each bone sits `segment` above its parent, so a rotation on bone k swings everything
        # above k — which is what makes the animation visible.
        dz = 0.0 if i == 1 else a.segment
        pivots += _name16(f"BONE{i:02d}") + struct.pack("<I", i - 1) \
                  + struct.pack("<3f", 0, 0, dz) + struct.pack("<3f", 0, 0, 0) \
                  + struct.pack("<4f", 0, 0, 0, 1)

    hdr = struct.pack("<I", 0x00040001) + _name16(a.name) + struct.pack("<I", n) \
          + struct.pack("<3f", 0, 0, 0)
    body = _chunk(W3D_HIER_HEADER, hdr) + _chunk(W3D_PIVOTS, pivots)
    open(a.out, "wb").write(_chunk(W3D_HIERARCHY, body, container=True))
    print(f"authored {a.out}  skeleton '{a.name}', {n} pivots "
          f"(ROOTTRANSFORM + {n-1} chained {a.segment} apart)")
    return 0


def cmd_w3danim(a):
    """Author an ANIMATION: quaternion rotation of one pivot over N frames.

    UNCOMPRESSED (0x200), deliberately. The compressed flavours need time-code packet maths or
    adaptive-delta nibble quantisation against a 256-entry filter table; uncompressed is a flat
    float array behind a 12-byte header, and it is what the shipped AIHERO_ISTA.W3D uses, so it
    is known to load.

    The registered name is HierarchyName + "." + Name, built by HRawAnimClass::Load_W3D — which
    is exactly the `SKELETON.ANIM` form the INI references. The skeleton must ALREADY be loaded
    under that name or the animation drops silently.
    """
    import math
    frames = a.frames
    hdr = struct.pack("<I", 0x00040001) + _name16(a.name) + _name16(a.skeleton) \
          + struct.pack("<II", frames, a.fps)

    # Pivot indices are RAW indices into the skeleton's pivot array — never names. A channel
    # whose pivot is out of range is dropped with a debug warning, so a wrong-but-in-range
    # index animates the wrong bone rather than failing.
    quats = b""
    for f in range(frames):
        ang = 2.0 * math.pi * f / frames * a.turns
        half = ang / 2.0
        ax, ay, az = a.axis
        ln = math.sqrt(ax*ax + ay*ay + az*az) or 1.0
        sn = math.sin(half)
        quats += struct.pack("<4f", ax/ln*sn, ay/ln*sn, az/ln*sn, math.cos(half))

    chan = struct.pack("<6H", 0, frames - 1, 4, ANIM_CHANNEL_Q, a.pivot, 0) + quats
    body = _chunk(W3D_ANIM_HEADER, hdr) + _chunk(W3D_ANIM_CHANNEL, chan)
    open(a.out, "wb").write(_chunk(W3D_ANIMATION, body, container=True))
    print(f"authored {a.out}  '{a.skeleton}.{a.name}': {frames} frames @ {a.fps}fps, "
          f"pivot {a.pivot} rotating {a.turns} turn(s) about {tuple(a.axis)}")
    return 0


def cmd_w3d(a):
    """Explain one .w3d: what a model IS, in chunks, so it can be re-authored not just adopted.

    Answers the practical question directly — mesh, motion and textures are three SEPARATE
    concerns in three chunk families, and a re-model has to satisfy all three:
      geometry   VERTICES / VERTEX_NORMALS / TRIANGLES / TEXCOORDS
      skinning   VERTEX_INFLUENCES (vertex -> bone), against a HIERARCHY in a _SKL file
      motion     ANIMATION / COMPRESSED_ANIMATION channels keyed per pivot
      surface    TEXTURES -> TEXTURE_NAME, a plain .dds/.tga filename resolved at load
      assembly   HLOD ties a mesh to its skeleton and names its SUB_OBJECTs
    """
    buf = open(a.file, "rb").read()
    counts, textures, subobjs, bones, verts, tris, anim = Counter(), [], [], 0, 0, 0, {}
    for depth, name, ctype, size, payload in w3d_walk(buf):
        counts[name] += 1
        if a.verbose:
            print(f"{'  ' * depth}{name:34} {size:>8,} bytes")
        if name == "TEXTURE_NAME":
            textures.append(payload.split(b"\0")[0].decode("latin-1"))
        elif name == "VERTICES":
            verts += size // 12                                    # 3 floats
        elif name == "TRIANGLES":
            tris += size // 32                                     # W3dTriStruct
        elif name == "HIERARCHY_HEADER":
            # name[16], numPivots, center -- pivots are the BONES a skin binds to.
            bones = struct.unpack_from("<I", payload, 4 + 16)[0]
        elif name == "HLOD_SUB_OBJECT":
            subobjs.append(payload[4:].split(b"\0")[0].decode("latin-1"))
        elif name == "ANIMATION_HEADER":
            anim = {"name": payload[4:20].split(b"\0")[0].decode("latin-1"),
                    "frames": struct.unpack_from("<I", payload, 4 + 16 + 16)[0]}

    print(f"{os.path.basename(a.file)}  {len(buf):,} bytes")
    print(f"  chunk kinds : {len(counts)}   total chunks: {sum(counts.values())}")
    if verts or tris:
        print(f"  geometry    : {verts:,} vertices, {tris:,} triangles")
    if bones:
        print(f"  skeleton    : {bones} pivots (bones a skin binds to)")
    if anim:
        print(f"  motion      : '{anim['name']}' {anim['frames']} frames")
    if textures:
        print(f"  textures    : {len(textures)} -> {', '.join(sorted(set(textures))[:6])}")
    if subobjs:
        print(f"  sub-objects : {len(subobjs)} -> {', '.join(subobjs[:8])}")
    unknown = [k for k in counts if k.startswith("0x")]
    if unknown:
        print(f"  unmapped    : {', '.join(sorted(unknown))}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="zhasset", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--game", default=DEF_GAME)
    p.add_argument("--ini", default=DEF_INI)
    p.add_argument("--src", default=DEF_SRC)
    p.add_argument("--out", default=DEF_OUT)
    sub = p.add_subparsers(dest="cmd", required=True)

    ar = sub.add_parser("archives", help="inspect the .big layer")
    ar.add_argument("action", choices=["list", "tree", "names", "extract"])
    ar.add_argument("--archive"); ar.add_argument("--glob"); ar.add_argument("--dest", default="/tmp/zh")
    ar.set_defaults(fn=cmd_archives)

    sc = sub.add_parser("schema", help="content types + fields from the GPL FieldParse tables")
    sc.set_defaults(fn=cmd_schema)

    ca = sub.add_parser("catalogue", help="resolved retail catalogue")
    ca.set_defaults(fn=cmd_catalogue)

    de = sub.add_parser("deps", help="INI -> art resolution, both directions")
    de.add_argument("-v", "--verbose", action="store_true")
    de.set_defaults(fn=cmd_deps)

    cv = sub.add_parser("coverage", help="how much of THEIR model do we implement")
    cv.add_argument("--gaps", action="store_true", help="list the unimplemented sim fields")
    cv.set_defaults(fn=cmd_coverage)

    ap = sub.add_parser("artprofile", help="measure the contract each adoptable mesh carries")
    ap.set_defaults(fn=cmd_artprofile)

    w3 = sub.add_parser("w3d", help="explain one .w3d model: mesh, motion, textures")
    w3.add_argument("file"); w3.add_argument("-v", "--verbose", action="store_true")
    w3.set_defaults(fn=cmd_w3d)

    wr = sub.add_parser("w3dround", help="parse a .w3d and re-emit it; proves the reader is lossless")
    wr.add_argument("file"); wr.add_argument("--write")
    wr.set_defaults(fn=cmd_w3dround)

    wb = sub.add_parser("w3dbox", help="author new geometry (any topology) into a mesh template")
    wb.add_argument("--template", required=True); wb.add_argument("--out", required=True)
    wb.add_argument("--name"); wb.add_argument("--size", type=float, nargs=3, default=[20, 20, 20])
    wb.add_argument("--out-dir", dest="out_dir", help="where to write art-profiles.json")
    wb.add_argument("--texture", help="replace TEXTURE_NAME, e.g. RTSGRID.tga")
    wb.add_argument("--skin", help="bind to this skeleton name; emits VERTEX_INFLUENCES + HLOD")
    wb.add_argument("--skin-split", dest="skin_split", type=float, default=70.0,
                    help="Z above which vertices bind to bone 2 instead of bone 1")
    wb.add_argument("--shape", choices=sorted(SHAPES), default="box")
    wb.add_argument("--segments", type=int, default=12, help="radial segments for cylinder/pyramid")
    wb.add_argument("--smooth", dest="smooth", action="store_true", default=None,
                    help="per-vertex normals on curved surfaces (default: on unless --shape box)")
    wb.add_argument("--flat", dest="smooth", action="store_false", help="force per-face normals")
    wb.set_defaults(fn=cmd_w3dbox)

    od = sub.add_parser("objectdiff", help="diff our emitted objects against retail peers sharing a mesh")
    od.add_argument("--emitted", required=True, help="a compiled Data/INI/Object directory")
    od.add_argument("-v", "--verbose", action="store_true", help="also list cosmetic/peer-specific gaps")
    od.set_defaults(fn=cmd_objectdiff)

    sk = sub.add_parser("w3dskel", help="author a skeleton (HIERARCHY + PIVOTS)")
    sk.add_argument("--out", required=True); sk.add_argument("--name", required=True)
    sk.add_argument("--bones", type=int, default=3); sk.add_argument("--segment", type=float, default=40.0)
    sk.set_defaults(fn=cmd_w3dskel)

    an = sub.add_parser("w3danim", help="author an animation rotating one pivot")
    an.add_argument("--out", required=True); an.add_argument("--name", required=True)
    an.add_argument("--skeleton", required=True)
    an.add_argument("--frames", type=int, default=60); an.add_argument("--fps", type=int, default=30)
    an.add_argument("--pivot", type=int, default=2); an.add_argument("--turns", type=float, default=1.0)
    an.add_argument("--axis", type=float, nargs=3, default=[0, 0, 1])
    an.set_defaults(fn=cmd_w3danim)

    tg = sub.add_parser("tga", help="author an uncompressed TGA texture from scratch")
    tg.add_argument("--out", required=True); tg.add_argument("--size", type=int, default=128)
    tg.add_argument("--cells", type=int, default=8)
    tg.add_argument("--rgb", type=int, nargs=3, default=[40, 170, 220])
    tg.add_argument("--sheet", action="store_true",
                    help="author a control-bar ICON SHEET: --cells x --cells distinct cells")
    tg.set_defaults(fn=cmd_tga)

    mp = sub.add_parser("map", help="read, scan or verify Zero Hour .map terrain files")
    mp.add_argument("action", choices=["read", "scan", "verify"])
    mp.add_argument("path", nargs="?")
    mp.add_argument("--expect-cliff", action="store_true",
                    help="verify: require terrain steep enough that THEIR pathfinder blocks it")
    mp.add_argument("--expect-connected", action="store_true",
                    help="verify: the two start spots must be mutually reachable")
    mp.add_argument("--expect-separated", action="store_true",
                    help="verify: the two start spots must NOT be mutually reachable")
    mp.set_defaults(fn=cmd_map)

    av = sub.add_parser("artvalidate",
                        help="can an art profile be DERIVED from the mesh? (measured answer: no)")
    av.add_argument("--profiles")
    av.set_defaults(fn=cmd_artvalidate)

    sh = sub.add_parser("show", help="explain one unit/weapon/faction/terrain type")
    sh.add_argument("thing")
    sh.set_defaults(fn=cmd_show)

    a = p.parse_args()
    return a.fn(a) or 0


if __name__ == "__main__":
    sys.exit(main())
