        "StartingUnit0": "faction.startingUnits", "StartingUnit1": "faction.startingUnits",
        "StartingUnit2": "faction.startingUnits", "StartingUnit3": "faction.startingUnits",
        "StartingUnit4": "faction.startingUnits", "StartingUnit5": "faction.startingUnits",
        "StartingUnit6": "faction.startingUnits", "StartingUnit7": "faction.startingUnits",
        "StartingUnit8": "faction.startingUnits", "StartingUnit9": "faction.startingUnits",
        "StartMoney": "faction.startMoney",
        "PlayableSide": "faction.isStartable",
        "IntrinsicSciences": None, "PurchaseScienceCommandSetRank1": None},
    "Science": {"PrerequisiteSciences": "tech.requires",
                "SciencePurchasePointCost": None, "IsGrantable": None},
    "Upgrade": {"BuildCost": None, "BuildTime": None, "Type": None},
    "SpecialPower": {"ReloadTime": None, "RequiredScience": None, "SharedSyncedTimer": None},
}

TARGET_TABLES = {
    "Object": "ThingTemplate::s_objectFieldParseTable",
    "Weapon": "WeaponTemplate::TheWeaponTemplateFieldParseTable",
    "Locomotor": "TheFieldParse",
    "PlayerTemplate": "TheFieldParseTable",
}


CAMEL_RE = re.compile(r'[A-Z]+(?![a-z])|[A-Z][a-z0-9]*|[a-z0-9]+')


def words(name):
    """Split a CamelCase field name into lowercase words.

    Naive substring matching is wrong here and it was wrong in a way that FLATTERED us:
    "StartingBuilding", "StartMoney" and StartingUnit0-9 all contain the substring "art"
    (St-art-ing), so twelve of the most load-bearing PlayerTemplate fields were being
    classified as art and dropped from the sim denominator. A smaller denominator is a
    higher coverage percentage, so the bug inflated the only number we steer by.
    """
    return [w.lower() for w in CAMEL_RE.findall(name)]


def classify(name):
    ws = set(words(name))
    if ws & AUDIO_HINTS: return "audio"
    if ws & UI_HINTS: return "ui"
    if ws & ART_HINTS: return "art"
    return "sim"


def cmd_coverage(a):
    schema = json.load(open(os.path.join(a.out, "zh-schema.json")))
    tables = schema["tables"]

    def find(tname, filehint):
        for k, v in tables.items():
            if v["table"] == tname and filehint.lower() in v["file"].lower():
                return v
        return None

    targets = [
        ("Object", find("ThingTemplate::s_objectFieldParseTable", "ThingTemplate.cpp")),
        ("Weapon", find("WeaponTemplate::TheWeaponTemplateFieldParseTable", "Weapon.cpp")),
        ("Locomotor", find("TheFieldParse", "Locomotor.cpp")),
        ("PlayerTemplate", find("TheFieldParseTable", "PlayerTemplate.cpp")),
    ]

    print("Coverage of ZH's content model. THEIR schema is the target; ours adapts to it.")
    print("Presentation fields are excluded from the denominator — we do not inherit art.\n")
    print(f"  {'content type':16s} {'sim':>5s} {'have':>5s} {'cov':>6s}   {'art':>5s} {'audio':>6s} {'ui':>4s}  total")
    print("  " + "-" * 72)

    grand_sim = grand_have = 0
    gaps = defaultdict(list)
    for label, tbl in targets:
        if not tbl:
            print(f"  {label:16s}  (table not found in extracted schema)")
            continue
        buckets = Counter()
        sim_fields = []
        for f in tbl["fields"]:
            c = classify(f["field"])
            buckets[c] += 1
            if c == "sim":
                sim_fields.append(f["field"])
        mapped = OURS.get(label, {})
        have = sum(1 for f in sim_fields if mapped.get(f))
        for f in sim_fields:
            if not mapped.get(f):
                gaps[label].append(f)
        grand_sim += len(sim_fields); grand_have += have
        cov = 100.0 * have / max(1, len(sim_fields))
        print(f"  {label:16s} {len(sim_fields):5d} {have:5d} {cov:5.1f}%   "
              f"{buckets['art']:5d} {buckets['audio']:6d} {buckets['ui']:4d}  {tbl['fieldCount']:5d}")

    print("  " + "-" * 72)
    print(f"  {'TOTAL':16s} {grand_sim:5d} {grand_have:5d} "
          f"{100.0*grand_have/max(1,grand_sim):5.1f}%")

    if a.gaps:
        print("\nUnimplemented sim fields (the roadmap, in their vocabulary):")
        for label, fs in gaps.items():
            print(f"\n  {label} ({len(fs)}):")
            for i in range(0, len(fs), 4):
                print("     " + "  ".join(f"{x:22s}" for x in fs[i:i + 4]))
    return 0


# ---------------------------------------------------------------- show
def cmd_show(a):
    cat = json.load(open(os.path.join(a.out, "zh-catalogue.json")))
    q = a.thing
    for section in ("objects", "weapons", "locomotors", "upgrades", "sciences",
                    "specialPowers", "terrain", "factions", "armor"):
        d = cat.get(section, {})
        if q in d:
            print(f"== {q}  ({section})")
            print(json.dumps(d[q], indent=2))
            if section == "objects" and d[q].get("side"):
                mates = cat["rosterBySide"].get(d[q]["side"], [])
                print(f"\n   side '{d[q]['side']}' has {len(mates)} objects")
            return 0
    hits = [(s, k) for s in cat if isinstance(cat[s], dict)
            for k in cat[s] if q.lower() in k.lower()][:20]
    if hits:
        print(f"no exact match for '{q}'; did you mean:")
        for s, k in hits:
            print(f"   {k}   ({s})")
    else:
        print(f"'{q}' not found. Build the catalogue first: zhasset catalogue")
    return 1


# ---------------------------------------------------------------- main
def main():
    p = argparse.ArgumentParser(prog="zhasset", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--game", default=DEF_GAME)
    p.add_argument("--ini", default=DEF_INI)
    p.add_argument("--src", default=DEF_SRC)
    p.add_argument("--out", default=DEF_OUT)
    sub = p.add_subparsers(dest="cmd", required=True)

    ar = sub.add_parser("archives", help="inspect the .big layer")
    ar.add_argument("action", choices=["list", "tree", "names", "extract"])
    ar.add_argument("--archive"); ar.add_argument("--glob"); ar.add_argument("--dest", default="/tmp/zh")
    ar.set_defaults(fn=cmd_archives)

    sc = sub.add_parser("schema", help="content types + fields from the GPL FieldParse tables")
    sc.set_defaults(fn=cmd_schema)

    ca = sub.add_parser("catalogue", help="resolved retail catalogue")
    ca.set_defaults(fn=cmd_catalogue)

    de = sub.add_parser("deps", help="INI -> art resolution, both directions")
    de.add_argument("-v", "--verbose", action="store_true")
    de.set_defaults(fn=cmd_deps)

    cv = sub.add_parser("coverage", help="how much of THEIR model do we implement")
    cv.add_argument("--gaps", action="store_true", help="list the unimplemented sim fields")
    cv.set_defaults(fn=cmd_coverage)

    sh = sub.add_parser("show", help="explain one unit/weapon/faction/terrain type")
    sh.add_argument("thing")
    sh.set_defaults(fn=cmd_show)

    a = p.parse_args()
    return a.fn(a) or 0


if __name__ == "__main__":
    sys.exit(main())
