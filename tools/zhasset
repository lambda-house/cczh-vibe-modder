        "StartingUnit0": "faction.startingUnits", "StartingUnit1": "faction.startingUnits",
        "StartingUnit2": "faction.startingUnits", "StartingUnit3": "faction.startingUnits",
        "StartingUnit4": "faction.startingUnits", "StartingUnit5": "faction.startingUnits",
        "StartingUnit6": "faction.startingUnits", "StartingUnit7": "faction.startingUnits",
        "StartingUnit8": "faction.startingUnits", "StartingUnit9": "faction.startingUnits",
        "StartMoney": "faction.startMoney",
        "PlayableSide": "faction.isStartable",
        "IntrinsicSciences": None, "PurchaseScienceCommandSetRank1": None},
    "Science": {"PrerequisiteSciences": "tech.requires",
                "SciencePurchasePointCost": None, "IsGrantable": None},
    "Upgrade": {"BuildCost": None, "BuildTime": None, "Type": None},
    "SpecialPower": {"ReloadTime": None, "RequiredScience": None, "SharedSyncedTimer": None},
}

TARGET_TABLES = {
    "Object": "ThingTemplate::s_objectFieldParseTable",
    "Weapon": "WeaponTemplate::TheWeaponTemplateFieldParseTable",
    "Locomotor": "TheFieldParse",
    "PlayerTemplate": "TheFieldParseTable",
}


CAMEL_RE = re.compile(r'[A-Z]+(?![a-z])|[A-Z][a-z0-9]*|[a-z0-9]+')


def words(name):
    """Split a CamelCase field name into lowercase words.

    Naive substring matching is wrong here and it was wrong in a way that FLATTERED us:
    "StartingBuilding", "StartMoney" and StartingUnit0-9 all contain the substring "art"
    (St-art-ing), so twelve of the most load-bearing PlayerTemplate fields were being
    classified as art and dropped from the sim denominator. A smaller denominator is a
    higher coverage percentage, so the bug inflated the only number we steer by.
    """
    return [w.lower() for w in CAMEL_RE.findall(name)]


def classify(name):
    ws = set(words(name))
    if ws & AUDIO_HINTS: return "audio"
    if ws & UI_HINTS: return "ui"
    if ws & ART_HINTS: return "art"
    return "sim"


def cmd_coverage(a):
    schema = json.load(open(os.path.join(a.out, "zh-schema.json")))
    tables = schema["tables"]

    def find(tname, filehint):
        for k, v in tables.items():
            if v["table"] == tname and filehint.lower() in v["file"].lower():
                return v
        return None

    targets = [
        ("Object", find("ThingTemplate::s_objectFieldParseTable", "ThingTemplate.cpp")),
        ("Weapon", find("WeaponTemplate::TheWeaponTemplateFieldParseTable", "Weapon.cpp")),
        ("Locomotor", find("TheFieldParse", "Locomotor.cpp")),
        ("PlayerTemplate", find("TheFieldParseTable", "PlayerTemplate.cpp")),
    ]

    print("Coverage of ZH's content model. THEIR schema is the target; ours adapts to it.")
    print("Presentation fields are excluded from the denominator — we do not inherit art.\n")
    print(f"  {'content type':16s} {'sim':>5s} {'have':>5s} {'cov':>6s}   {'art':>5s} {'audio':>6s} {'ui':>4s}  total")
    print("  " + "-" * 72)

    grand_sim = grand_have = 0
    gaps = defaultdict(list)
    for label, tbl in targets:
        if not tbl:
            print(f"  {label:16s}  (table not found in extracted schema)")
            continue
        buckets = Counter()
        sim_fields = []
        for f in tbl["fields"]:
            c = classify(f["field"])
            buckets[c] += 1
            if c == "sim":
                sim_fields.append(f["field"])
        mapped = OURS.get(label, {})
        have = sum(1 for f in sim_fields if mapped.get(f))
        for f in sim_fields:
            if not mapped.get(f):
                gaps[label].append(f)
        grand_sim += len(sim_fields); grand_have += have
        cov = 100.0 * have / max(1, len(sim_fields))
        print(f"  {label:16s} {len(sim_fields):5d} {have:5d} {cov:5.1f}%   "
              f"{buckets['art']:5d} {buckets['audio']:6d} {buckets['ui']:4d}  {tbl['fieldCount']:5d}")

    print("  " + "-" * 72)
    print(f"  {'TOTAL':16s} {grand_sim:5d} {grand_have:5d} "
          f"{100.0*grand_have/max(1,grand_sim):5.1f}%")

    if a.gaps:
        print("\nUnimplemented sim fields (the roadmap, in their vocabulary):")
        for label, fs in gaps.items():
            print(f"\n  {label} ({len(fs)}):")
            for i in range(0, len(fs), 4):
                print("     " + "  ".join(f"{x:22s}" for x in fs[i:i + 4]))
    return 0


# ---------------------------------------------------------------- show
def cmd_show(a):
    cat = json.load(open(os.path.join(a.out, "zh-catalogue.json")))
    q = a.thing
    for section in ("objects", "weapons", "locomotors", "upgrades", "sciences",
                    "specialPowers", "terrain", "factions", "armor"):
        d = cat.get(section, {})
        if q in d:
            print(f"== {q}  ({section})")
            print(json.dumps(d[q], indent=2))
            if section == "objects" and d[q].get("side"):
                mates = cat["rosterBySide"].get(d[q]["side"], [])
                print(f"\n   side '{d[q]['side']}' has {len(mates)} objects")
            return 0
    hits = [(s, k) for s in cat if isinstance(cat[s], dict)
            for k in cat[s] if q.lower() in k.lower()][:20]
    if hits:
        print(f"no exact match for '{q}'; did you mean:")
        for s, k in hits:
            print(f"   {k}   ({s})")
    else:
        print(f"'{q}' not found. Build the catalogue first: zhasset catalogue")
    return 1


# ---------------------------------------------------------------- main
def cmd_artprofile(a):
    """Measure the CONTRACT that comes with each adoptable mesh.

    A model renders for free. It does not BEHAVE for free: dimensions, weapon bones, the
    muzzle-flash sub-object and whether it has a turret all have to be declared, and every
    one of them fails silently — the pack lints, compiles, boots 42/42 and plays wrong.
    Adopting one model (AVCrusader) hit all four.

    So rather than hand-copy numbers per unit, measure them from the objects that already
    use each mesh. The profile is keyed by MODEL, because the contract belongs to the mesh.

    Output goes to reference/ and is gitignored: this extractor may ship, its extract may not.
    """
    prof = {}
    objdir = os.path.join(a.ini, "Object")
    files = sorted(f for f in os.listdir(objdir) if f.lower().endswith(".ini"))
    for fn in files:
        for kind, name, lines in ini_blocks(os.path.join(objdir, fn)):
            if kind != "Object":
                continue
            body = "\n".join(lines)

            # First model of the first Draw block: the mesh this object presents.
            m = re.search(r"^\s*Model\s*=\s*(\S+)", body, re.M)
            if not m:
                continue
            model = m.group(1)
            if model.lower() in ("none", "nomodel"):
                continue

            geom = field(lines, "Geometry")
            entry = {
                "model": model,
                "geometry": geom,
                "majorRadius": field(lines, "GeometryMajorRadius"),
                "minorRadius": field(lines, "GeometryMinorRadius"),
                "height": field(lines, "GeometryHeight"),
                "isSmall": field(lines, "GeometryIsSmall"),
                # A turret is declared INSIDE AIUpdateInterface, so a plain field lookup
                # misses it; the weapon simply never bears without one.
                "turret": bool(re.search(r"^\s*Turret\s*$", body, re.M)),
                "launchBone": None, "fireFXBone": None, "muzzleFlash": None,
                "unitCreatePoint": None, "naturalRallyPoint": None,
                "kind": "structure" if "STRUCTURE" in (field(lines, "KindOf") or "") else "mobile",
                "usedBy": [name],
            }
            for key, dest in (("WeaponLaunchBone", "launchBone"),
                              ("WeaponFireFXBone", "fireFXBone"),
                              ("WeaponMuzzleFlash", "muzzleFlash"),
                              ("UnitCreatePoint", "unitCreatePoint"),
                              ("NaturalRallyPoint", "naturalRallyPoint")):
                mm = re.search(rf"^\s*{key}\s*=\s*(.+)$", body, re.M)
                if mm:
                    v = mm.group(1).strip()
                    # Bone fields are "PRIMARY <bone>"; keep only the bone.
                    if dest.endswith("Bone") or dest == "muzzleFlash":
                        parts = v.split()
                        v = parts[-1] if parts else v
                    entry[dest] = v

            if model in prof:
                # Several objects share a mesh. Keep the FIRST (files and blocks are walked
                # in sorted order, so this is deterministic) and record the rest, because a
                # disagreement between them is exactly the ambiguity an author needs to see.
                prof[model]["usedBy"].append(name)
            else:
                prof[model] = entry

    os.makedirs(a.out, exist_ok=True)
    dest = os.path.join(a.out, "art-profiles.json")
    with open(dest, "w") as f:
        json.dump({"models": prof}, f, indent=1, sort_keys=True)

    turreted = sum(1 for v in prof.values() if v["turret"])
    withbone = sum(1 for v in prof.values() if v["launchBone"])
    withflash = sum(1 for v in prof.values() if v["muzzleFlash"])
    structures = sum(1 for v in prof.values() if v["kind"] == "structure")
    shared = sum(1 for v in prof.values() if len(v["usedBy"]) > 1)
    print(f"art profiles -> {dest}")
    print(f"  {len(prof)} adoptable meshes measured from {len(files)} Object files")
    print(f"  {structures} structures, {len(prof) - structures} mobile")
    print(f"  {turreted} turreted, {withbone} with a launch bone, {withflash} with a muzzle flash")
    print(f"  {shared} meshes are used by more than one object (profile taken from the first)")
    return 0


# ---------------------------------------------------------------- W3D (mesh/skeleton/anim)
# Format is IFF-style chunks: uint32 type, uint32 size whose HIGH BIT means "contains
# subchunks". The authoritative taxonomy is EA's own GPL header,
# Generals/Code/Tools/WW3D/pluglib/w3d_file.h -- 69 chunk ids with their structs. That header
# is engine SOURCE, so it is readable, re-implementable, and the reason a from-scratch art
# pipeline is a real option rather than reverse engineering.
W3D_CHUNKS = {
    0x0000: "MESH", 0x0001: "MESH_HEADER", 0x0002: "VERTICES", 0x0003: "VERTEX_NORMALS",
    0x000C: "MESH_USER_TEXT", 0x000E: "VERTEX_INFLUENCES", 0x001F: "MESH_HEADER3",
    0x0020: "TRIANGLES",
    0x0022: "VERTEX_SHADE_INDICES", 0x0023: "PRELIT_UNLIT", 0x0024: "PRELIT_VERTEX",
    0x0028: "MATERIAL_INFO", 0x0029: "SHADERS", 0x002A: "VERTEX_MATERIALS",
    0x002B: "VERTEX_MATERIAL", 0x002C: "VERTEX_MATERIAL_NAME", 0x002D: "VERTEX_MATERIAL_INFO",
    0x0030: "TEXTURES", 0x0031: "TEXTURE", 0x0032: "TEXTURE_NAME", 0x0033: "TEXTURE_INFO",
    0x0038: "MATERIAL_PASS", 0x0039: "VERTEX_MATERIAL_IDS", 0x003A: "SHADER_IDS",
    0x003B: "DCG", 0x003C: "DIG", 0x003E: "SCG", 0x0048: "TEXTURE_STAGE",
    0x0049: "TEXTURE_IDS", 0x004A: "STAGE_TEXCOORDS", 0x004B: "PER_FACE_TEXCOORD_IDS",
    0x0100: "HIERARCHY", 0x0101: "HIERARCHY_HEADER", 0x0102: "PIVOTS", 0x0103: "PIVOT_FIXUPS",
    0x0200: "ANIMATION", 0x0201: "ANIMATION_HEADER", 0x0202: "ANIMATION_CHANNEL",
    0x0203: "BIT_CHANNEL", 0x0280: "COMPRESSED_ANIMATION",
    0x0281: "COMPRESSED_ANIMATION_HEADER", 0x0282: "COMPRESSED_ANIMATION_CHANNEL",
    0x0300: "HMODEL", 0x0301: "HMODEL_HEADER", 0x0700: "HLOD", 0x0701: "HLOD_HEADER",
    0x0702: "HLOD_LOD_ARRAY", 0x0703: "HLOD_SUB_OBJECT_ARRAY_HEADER",
    0x0704: "HLOD_SUB_OBJECT", 0x0740: "BOX", 0x0750: "AGGREGATE",
}


def w3d_walk(buf, off=0, end=None, depth=0, acc=None):
    """Yield (depth, name, type, size, payload) for every chunk, recursing into containers."""
    end = len(buf) if end is None else end
    while off + 8 <= end:
        ctype, raw = struct.unpack_from("<II", buf, off)
        size = raw & 0x7FFFFFFF
        has_sub = bool(raw & 0x80000000)
        body = off + 8
        name = W3D_CHUNKS.get(ctype, f"0x{ctype:04X}")
        yield depth, name, ctype, size, buf[body:body + size]
        if has_sub:
            yield from w3d_walk(buf, body, body + size, depth + 1, acc)
        off = body + size


def cmd_w3d(a):
    """Explain one .w3d: what a model IS, in chunks, so it can be re-authored not just adopted.

    Answers the practical question directly — mesh, motion and textures are three SEPARATE
    concerns in three chunk families, and a re-model has to satisfy all three:
      geometry   VERTICES / VERTEX_NORMALS / TRIANGLES / TEXCOORDS
      skinning   VERTEX_INFLUENCES (vertex -> bone), against a HIERARCHY in a _SKL file
      motion     ANIMATION / COMPRESSED_ANIMATION channels keyed per pivot
      surface    TEXTURES -> TEXTURE_NAME, a plain .dds/.tga filename resolved at load
      assembly   HLOD ties a mesh to its skeleton and names its SUB_OBJECTs
    """
    buf = open(a.file, "rb").read()
    counts, textures, subobjs, bones, verts, tris, anim = Counter(), [], [], 0, 0, 0, {}
    for depth, name, ctype, size, payload in w3d_walk(buf):
        counts[name] += 1
        if a.verbose:
            print(f"{'  ' * depth}{name:34} {size:>8,} bytes")
        if name == "TEXTURE_NAME":
            textures.append(payload.split(b"\0")[0].decode("latin-1"))
        elif name == "VERTICES":
            verts += size // 12                                    # 3 floats
        elif name == "TRIANGLES":
            tris += size // 32                                     # W3dTriStruct
        elif name == "HIERARCHY_HEADER":
            # name[16], numPivots, center -- pivots are the BONES a skin binds to.
            bones = struct.unpack_from("<I", payload, 4 + 16)[0]
        elif name == "HLOD_SUB_OBJECT":
            subobjs.append(payload[4:].split(b"\0")[0].decode("latin-1"))
        elif name == "ANIMATION_HEADER":
            anim = {"name": payload[4:20].split(b"\0")[0].decode("latin-1"),
                    "frames": struct.unpack_from("<I", payload, 4 + 16 + 16)[0]}

    print(f"{os.path.basename(a.file)}  {len(buf):,} bytes")
    print(f"  chunk kinds : {len(counts)}   total chunks: {sum(counts.values())}")
    if verts or tris:
        print(f"  geometry    : {verts:,} vertices, {tris:,} triangles")
    if bones:
        print(f"  skeleton    : {bones} pivots (bones a skin binds to)")
    if anim:
        print(f"  motion      : '{anim['name']}' {anim['frames']} frames")
    if textures:
        print(f"  textures    : {len(textures)} -> {', '.join(sorted(set(textures))[:6])}")
    if subobjs:
        print(f"  sub-objects : {len(subobjs)} -> {', '.join(subobjs[:8])}")
    unknown = [k for k in counts if k.startswith("0x")]
    if unknown:
        print(f"  unmapped    : {', '.join(sorted(unknown))}")
    return 0


def main():
    p = argparse.ArgumentParser(prog="zhasset", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--game", default=DEF_GAME)
    p.add_argument("--ini", default=DEF_INI)
    p.add_argument("--src", default=DEF_SRC)
    p.add_argument("--out", default=DEF_OUT)
    sub = p.add_subparsers(dest="cmd", required=True)

    ar = sub.add_parser("archives", help="inspect the .big layer")
    ar.add_argument("action", choices=["list", "tree", "names", "extract"])
    ar.add_argument("--archive"); ar.add_argument("--glob"); ar.add_argument("--dest", default="/tmp/zh")
    ar.set_defaults(fn=cmd_archives)

    sc = sub.add_parser("schema", help="content types + fields from the GPL FieldParse tables")
    sc.set_defaults(fn=cmd_schema)

    ca = sub.add_parser("catalogue", help="resolved retail catalogue")
    ca.set_defaults(fn=cmd_catalogue)

    de = sub.add_parser("deps", help="INI -> art resolution, both directions")
    de.add_argument("-v", "--verbose", action="store_true")
    de.set_defaults(fn=cmd_deps)

    cv = sub.add_parser("coverage", help="how much of THEIR model do we implement")
    cv.add_argument("--gaps", action="store_true", help="list the unimplemented sim fields")
    cv.set_defaults(fn=cmd_coverage)

    ap = sub.add_parser("artprofile", help="measure the contract each adoptable mesh carries")
    ap.set_defaults(fn=cmd_artprofile)

    w3 = sub.add_parser("w3d", help="explain one .w3d model: mesh, motion, textures")
    w3.add_argument("file"); w3.add_argument("-v", "--verbose", action="store_true")
    w3.set_defaults(fn=cmd_w3d)

    sh = sub.add_parser("show", help="explain one unit/weapon/faction/terrain type")
    sh.add_argument("thing")
    sh.set_defaults(fn=cmd_show)

    a = p.parse_args()
    return a.fn(a) or 0


if __name__ == "__main__":
    sys.exit(main())
