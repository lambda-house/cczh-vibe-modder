#!/usr/bin/env python3
"""zhasset — inspect and extract the Zero Hour asset set.

WHY THIS EXISTS
    Our platform needs a reference model of what a ZH-like game is made of. That model
    has to be DATA (queryable, diffable, machine-checkable), not prose in a markdown file.
    This tool extracts it from two sources that are already on disk, and it is
    deterministic and re-runnable — no transcription, no hand-copied numbers.

WHAT MAY BE COMMITTED
    This tool: yes. Its OUTPUT: no.
    EA's GPL v3 release covers the engine SOURCE. It does not cover Data/INI, the .big
    archives, generals.csf, the maps or the art — those stay EA-copyrighted. So
    reference/ is generated locally and gitignored. Ship the extractor, never the extract.

COMMANDS
    archives list|tree|names|extract    the .big layer
    schema                              content types + fields, from the GPL FieldParse tables
    catalogue                           the resolved retail catalogue (factions/units/...)
    deps                                INI -> art reference resolution, both directions
    show <thing>                        explain one unit / weapon / faction / terrain type
"""
import argparse, fnmatch, json, os, re, struct, sys
from collections import Counter, defaultdict

HOME = os.path.expanduser("~")
DEF_GAME = f"{HOME}/GeneralsX/GeneralsZH"
DEF_INI = f"{HOME}/work/oss/zh-retail/Data/INI"
DEF_SRC = f"{HOME}/work/oss/CnC_Generals_Zero_Hour/GeneralsMD/Code"
DEF_OUT = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "reference")


# ---------------------------------------------------------------- .big archives
def big_toc(path):
    """BIGF container. Format per Win32BIGFileSystem.cpp:104-155."""
    with open(path, "rb") as f:
        if f.read(4) != b"BIGF":
            raise ValueError(f"{path}: not a BIGF archive")
        f.read(4)                                     # archive size, stored unswapped
        (count,) = struct.unpack(">I", f.read(4))
        f.read(4)                                     # first-file offset
        f.seek(0x10)
        out = []
        for _ in range(count):
            off, size = struct.unpack(">II", f.read(8))
            name = bytearray()
            while (b := f.read(1)) not in (b"", b"\0"):
                name += b
            out.append((name.decode("latin-1").replace("\\", "/"), off, size))
        return out


def all_archives(game):
    """Both layers. The ZH archives are a DELTA over base Generals in ZH_Generals/;
    counting only the top level undercounts the art by roughly half."""
    out = []
    for d in (game, os.path.join(game, "ZH_Generals")):
        if os.path.isdir(d):
            out += sorted(os.path.join(d, f) for f in os.listdir(d) if f.lower().endswith(".big"))
    return out


def cmd_archives(a):
    arcs = all_archives(a.game) if not a.archive else [a.archive]
    if a.action == "list":
        tf = tb = 0
        for arc in arcs:
            try:
                e = big_toc(arc)
            except Exception as ex:
                print(f"  {os.path.basename(arc)}: {ex}"); continue
            b = sum(x[2] for x in e); tf += len(e); tb += b
            layer = "base" if "ZH_Generals" in arc else "zh"
            print(f"  {layer:4s} {os.path.basename(arc):24s} {len(e):6d} files  {b/1e6:8.1f} MB")
        print(f"\n  {len(arcs)} archives · {tf:,} files · {tb/1e9:.2f} GB")
    elif a.action == "tree":
        hist = defaultdict(lambda: [0, 0])
        for arc in arcs:
            try:
                e = big_toc(arc)
            except Exception:
                continue
            for n, _o, s in e:
                k = os.path.splitext(n)[1].lower() or "(none)"
                hist[k][0] += 1; hist[k][1] += s
        for ext, (c, b) in sorted(hist.items(), key=lambda kv: -kv[1][1])[:20]:
            print(f"  {ext:10s} {c:7,d}  {b/1e6:9.1f} MB")
    elif a.action == "names":
        for arc in arcs:
            try:
                e = big_toc(arc)
            except Exception:
                continue
            for n, _o, s in e:
                if not a.glob or fnmatch.fnmatch(n.lower(), a.glob.lower()):
                    print(f"{s:10d}  {n}")
    elif a.action == "extract":
        n = 0
        for arc in arcs:
            try:
                entries = big_toc(arc)
            except Exception:
                continue
            with open(arc, "rb") as f:
                for name, off, size in entries:
                    if a.glob and not fnmatch.fnmatch(name.lower(), a.glob.lower()):
                        continue
                    p = os.path.join(a.dest, name)
                    os.makedirs(os.path.dirname(p), exist_ok=True)
                    f.seek(off)
                    open(p, "wb").write(f.read(size))
                    n += 1
        print(f"extracted {n} files -> {a.dest}")


# ---------------------------------------------------------------- schema (GPL source)
# Every INI block type in this engine declares a static FieldParse table:
#     { "FieldName", INI::parseReal, NULL, offsetof(Foo, m_bar) },
# That table IS the schema: legal keys, and a parser function that implies the type.
FIELD_RE = re.compile(r'\{\s*"([A-Za-z_][A-Za-z_0-9]*)"\s*,\s*([A-Za-z_:][\w:<>\.]*)', re.M)
# Table names are often class-qualified (ThingTemplate::s_objectFieldParseTable), and the
# declaration may or may not be static/extern-const. Matching only \w+ silently drops the
# biggest tables in the engine, which is exactly the ones that matter.
TABLE_RE = re.compile(
    r'(?:static\s+|extern\s+)?const\s+FieldParse\s+([\w:]+)\s*\[\s*\]\s*=\s*\{(.*?)\n\s*\}\s*;', re.S)

PARSER_TYPES = {
    "parseReal": "real", "parseInt": "int", "parseUnsignedInt": "uint",
    "parseUnsignedShort": "ushort", "parseUnsignedByte": "byte", "parseBool": "bool",
    "parseAsciiString": "string", "parseQuotedAsciiString": "string",
    "parseAsciiStringVector": "string[]", "parseAngleReal": "angle",
    "parsePercentToReal": "percent", "parseVelocityReal": "velocity/tick",
    "parseAccelerationReal": "accel/tick^2", "parseDurationReal": "ticks(ceil)",
    "parseDurationUnsignedInt": "ticks(ceil)", "parseDurationUnsignedShort": "ticks(ceil)",
    "parseBitString32": "bitflags", "parseIndexList": "enum", "parseIndexListOrNone": "enum?",
    "parseCoord3D": "coord3", "parseCoord2D": "coord2", "parseRGBColor": "rgb",
    "parseBitInInt32": "bit",
}


def cmd_schema(a):
    """Walk the GPL source, harvest every FieldParse table, emit the schema as JSON."""
    tables = {}
    for root, _d, files in os.walk(a.src):
        for fn in files:
            if not fn.endswith((".cpp", ".h")):
                continue
            p = os.path.join(root, fn)
            try:
                text = open(p, encoding="latin-1").read()
            except Exception:
                continue
            for tname, body in TABLE_RE.findall(text):
                fields = []
                for fname, parser in FIELD_RE.findall(body):
                    short = parser.split("::")[-1]
                    fields.append({"field": fname, "parser": short,
                                   "type": PARSER_TYPES.get(short, short)})
                if not fields:
                    continue
                rel = os.path.relpath(p, a.src)
                key = f"{rel}::{tname}"
                tables[key] = {"table": tname, "file": rel, "fieldCount": len(fields),
                               "fields": fields}

    total = sum(t["fieldCount"] for t in tables.values())
    doc = {
        "_provenance": "derived from EA's GPL v3 engine source FieldParse tables; "
                       "regenerate with tools/zhasset schema. Not for redistribution.",
        "source": a.src,
        "tableCount": len(tables),
        "fieldCount": total,
        "tables": tables,
    }
    os.makedirs(a.out, exist_ok=True)
    dest = os.path.join(a.out, "zh-schema.json")
    json.dump(doc, open(dest, "w"), indent=1)
    print(f"  {len(tables)} FieldParse tables · {total} fields -> {dest}")
    big = sorted(tables.values(), key=lambda t: -t["fieldCount"])[:12]
    for t in big:
        print(f"    {t['fieldCount']:4d}  {t['table']:32s} {t['file']}")


# ---------------------------------------------------------------- catalogue (retail INI)
BLOCK_RE = re.compile(r"^(\w+)\s+([^\s;]+)", re.M)


def ini_blocks(path):
    """Yield (kind, name, [lines]) for every column-0 block ... End in an INI file."""
    kind = name = None
    buf = []
    for raw in open(path, encoding="latin-1", errors="replace"):
        line = raw.split(";")[0].rstrip("\n")
        if kind is None:
            m = BLOCK_RE.match(line)
            if m and not line.startswith(" ") and not line.startswith("\t"):
                kind, name = m.group(1), m.group(2)
                buf = []
        else:
            if line.strip().lower() == "end" and not line.startswith((" ", "\t")):
                yield kind, name, buf
                kind = name = None
            else:
                buf.append(line)


def field(lines, key, default=None):
    k = key.lower()
    for l in lines:
        s = l.strip()
        if "=" in s and s.split("=")[0].strip().lower() == k:
            return s.split("=", 1)[1].strip()
    return default


def cmd_catalogue(a):
    ini = a.ini
    cat = {"_provenance": "derived from EA-copyrighted retail Data/INI; local artifact only, "
                          "never redistribute. Regenerate with tools/zhasset catalogue.",
           "source": ini}

    # factions
    factions = {}
    pt = os.path.join(ini, "PlayerTemplate.ini")
    if os.path.exists(pt):
        for kind, name, lines in ini_blocks(pt):
            if kind.lower() != "playertemplate":
                continue
            factions[name] = {
                "side": field(lines, "Side", ""),
                "baseSide": field(lines, "BaseSide"),
                "playable": (field(lines, "PlayableSide", "No") or "No").lower() == "yes",
                "startingBuilding": field(lines, "StartingBuilding"),
                "intrinsicSciences": (field(lines, "IntrinsicSciences", "") or "").split(),
            }

    # objects -> roster by Side
    units, roster = {}, defaultdict(list)
    objdir = os.path.join(ini, "Object")
    if os.path.isdir(objdir):
        for fn in sorted(os.listdir(objdir)):
            if not fn.lower().endswith(".ini"):
                continue
            for kind, name, lines in ini_blocks(os.path.join(objdir, fn)):
                if kind.lower() not in ("object", "objectreskin"):
                    continue
                cost = field(lines, "BuildCost")
                side = field(lines, "Side")
                kindof = (field(lines, "KindOf", "") or "")
                rec = {
                    "file": fn, "reskin": kind.lower() == "objectreskin",
                    "side": side, "buildCost": int(cost) if cost and cost.isdigit() else None,
                    "buildTime": field(lines, "BuildTime"),
                    "kindOf": kindof.split(),
                    "isStructure": "STRUCTURE" in kindof.upper(),
                    "commandSet": field(lines, "CommandSet"),
                    "vision": field(lines, "VisionRange"),
                    "lines": len(lines),
                }
                units[name] = rec
                if side:
                    roster[side].append(name)

    def simple(fn, kindname, keys):
        out = {}
        p = os.path.join(ini, fn)
        if not os.path.exists(p):
            return out
        for kind, name, lines in ini_blocks(p):
            if kind.lower() != kindname:
                continue
            out[name] = {k: field(lines, k) for k in keys}
        return out

    cat["factions"] = factions
    cat["rosterBySide"] = {k: sorted(v) for k, v in sorted(roster.items())}
    cat["objects"] = units
    cat["weapons"] = simple("Weapon.ini", "weapon",
                            ["PrimaryDamage", "DamageType", "AttackRange", "DelayBetweenShots",
                             "PrimaryDamageRadius", "ClipSize", "ClipReloadTime"])
    cat["locomotors"] = simple("Locomotor.ini", "locomotor",
                               ["Surfaces", "Speed", "TurnRate", "Acceleration", "Appearance"])
    cat["upgrades"] = simple("Upgrade.ini", "upgrade", ["Type", "BuildCost", "BuildTime"])
    cat["sciences"] = simple("Science.ini", "science",
                             ["PrerequisiteSciences", "SciencePurchasePointCost", "IsGrantable"])
    cat["specialPowers"] = simple("SpecialPower.ini", "specialpower",
                                  ["Enum", "ReloadTime", "RequiredScience", "SharedSyncedTimer"])
    cat["terrain"] = simple("Terrain.ini", "terrain", ["Texture", "Class"])

    # armor: damageType -> multiplier, per armor set
    armor = {}
    ap = os.path.join(ini, "Armor.ini")
    if os.path.exists(ap):
        for kind, name, lines in ini_blocks(ap):
            if kind.lower() != "armor":
                continue
            row = {}
            for l in lines:
                s = l.strip()
                if s.lower().startswith("armor") and "=" in s:
                    rhs = s.split("=", 1)[1].split()
                    if len(rhs) >= 2:
                        row[rhs[0]] = rhs[1]
            armor[name] = row
    cat["armor"] = armor

    os.makedirs(a.out, exist_ok=True)
    dest = os.path.join(a.out, "zh-catalogue.json")
    json.dump(cat, open(dest, "w"), indent=1)

    buildable = sum(1 for u in units.values() if u["buildCost"])
    structures = sum(1 for u in units.values() if u["buildCost"] and u["isStructure"])
    print(f"  factions      {len(factions):6d}  ({sum(1 for f in factions.values() if f['playable'])} playable)")
    print(f"  objects       {len(units):6d}  ({buildable} buildable = {buildable-structures} units + {structures} structures)")
    print(f"  weapons       {len(cat['weapons']):6d}")
    print(f"  armor sets    {len(armor):6d}")
    print(f"  locomotors    {len(cat['locomotors']):6d}")
    print(f"  upgrades      {len(cat['upgrades']):6d}")
    print(f"  sciences      {len(cat['sciences']):6d}")
    print(f"  powers        {len(cat['specialPowers']):6d}")
    print(f"  terrain types {len(cat['terrain']):6d}")
    print(f"  -> {dest}")


# ---------------------------------------------------------------- dependency resolution
ART_RE = re.compile(r"^\s*(?:Model|DefaultModel|ModelName)\s*=\s*([A-Za-z0-9_]+)", re.M | re.I)


def cmd_deps(a):
    """Resolve INI art references against the archives, both directions."""
    referenced = Counter()
    for root, _d, files in os.walk(a.ini):
        for fn in files:
            if fn.lower().endswith(".ini"):
                text = open(os.path.join(root, fn), encoding="latin-1", errors="replace").read()
                for m in ART_RE.findall(text):
                    if m.upper() != "NONE":
                        referenced[m.lower()] += 1

    shipped = set()
    for arc in all_archives(a.game):
        try:
            for n, _o, _s in big_toc(arc):
                if n.lower().endswith(".w3d"):
                    shipped.add(os.path.splitext(os.path.basename(n))[0].lower())
        except Exception:
            pass

    refs = set(referenced)
    hit = refs & shipped
    print(f"  models referenced by INI : {len(refs):,}")
    print(f"  models shipped           : {len(shipped):,}")
    print(f"  resolved                 : {len(hit):,}  ({100*len(hit)/max(1,len(refs)):.1f}% of references)")
    print(f"  DANGLING (ref, no file)  : {len(refs-shipped):,}")
    print(f"  ORPHANED (file, no ref)  : {len(shipped-refs):,}  ({100*len(shipped-refs)/max(1,len(shipped)):.1f}% of shipped)")
    if a.verbose:
        for m in sorted(refs - shipped)[:25]:
            print(f"     dangling: {m}")


# ---------------------------------------------------------------- coverage
# ZH's schema is the TARGET model: we adapt to it rather than grow our own in parallel.
# Coverage is therefore "how much of their model do we implement", per content type.
#
# Most of their surface is presentation, which we do not inherit and must not count as
# debt. Classify mechanically so the split is reproducible rather than an opinion.
# Whole WORDS after CamelCase splitting, never substrings — see words() below.
ART_HINTS = {"model", "models", "anim", "animation", "particle", "particles", "fx", "shadow",
             "draw", "bone", "bones", "texture", "image", "images", "portrait", "cameo",
             "cameo1", "art", "sprite", "trail", "smoke", "flash", "render", "wireframe",
             "tint", "color", "colour", "opacity", "condition", "conditionstate",
             "transition", "shroud", "occlusion", "watermark", "medallion"}
AUDIO_HINTS = {"sound", "sounds", "voice", "audio", "speech", "music", "eva", "noise"}
UI_HINTS = {"displayname", "description", "button", "buttons", "tooltip", "commandset",
            "radar", "editorsorting", "selectportrait", "hotkey", "window", "screen",
            "name", "label"}

# What our content model expresses today, keyed to THEIR field names. This is an authored
# correspondence table, not generated: it records a decision per field.
OURS = {
    "Object": {
        "BuildCost": "unit.cost", "BuildTime": "unit.buildSeconds",
        # Object prerequisites, not just tech: the prototype must be ALIVE, so a levelled
