        "PrimaryDamage": "weapon.damage", "DamageType": "weapon.damageType",
        "AttackRange": "weapon.range", "DelayBetweenShots": "weapon.cooldownTicks",
        "ScatterRadius": "weapon.spread",
        # Splash as ZH models it: two-band step function, no falloff.
        "PrimaryDamageRadius": "weapon.primaryDamageRadius",
        "SecondaryDamage": "weapon.secondaryDamage",
        "SecondaryDamageRadius": "weapon.secondaryDamageRadius",
        "ClipSize": "weapon.clipSize", "ClipReloadTime": "weapon.clipReloadSeconds",
        "MinimumAttackRange": "weapon.minimumAttackRange",
        "WeaponSpeed": None, "DeathType": None,
        "ProjectileObject": None, "RadiusDamageAffects": None,
    },
    "Armor": {"Armor": "damageVsArmor"},
    "Locomotor": {"Speed": "unit.components.Mobile.speed", "Surfaces": None,
                  "TurnRate": None, "Acceleration": None, "Braking": None,
                  "MinSpeed": None, "SpeedDamaged": None, "Appearance": None},
    "PlayerTemplate": {
        "Side": "faction.id",
        "StartingBuilding": "faction.startingBuilding",
        # ZH declares StartingUnit0..9 as ten separate #define-capped fields and then uses
