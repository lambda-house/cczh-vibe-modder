#!/usr/bin/env python3
"""zhdrive — observe and drive the running Zero Hour client.

WHY THIS EXISTS
    Every bug this project has shipped to a human tester was a SILENT one: the file parses,
    the engine boots 42/42, and something simply never happens. The catalogue in CLAUDE.md is
    long — InitialHealth 0, a welded turret, a missing ProductionUpdate, a black map from a
    TerrainType whose texture does not ship — and each was found by somebody noticing
    something in a match, which is the slowest and least reliable detector we have.

    Two of the three failures in the last round were findable without a human: the map was
    black because a texture is absent from every archive, and "did our MappedImages load" is
    a line in a log nobody was capturing. This closes that loop.

WHAT IT CAN AND CANNOT DO
    observe   screenshots and the engine's own log. Needs no permissions beyond Screen
              Recording, and answers every LOAD-TIME question.
    act       clicks and keys, via cliclick. Needs macOS Accessibility for the process that
              runs it, which is a human decision and cannot be scripted around.

    The split matters: load-time correctness is where every bug so far has actually lived, so
    `observe` alone is most of the value. `act` buys the rest — "click build and see".

COORDINATES
    screencapture reports PHYSICAL pixels; cliclick takes LOGICAL points. On a Retina display
    those differ by 2x, so a coordinate read off a screenshot and fed straight to a click
    lands at twice the intended offset — off-screen, or on the wrong control. Everything here
    goes through `logical()`, and `shot` prints the scale so a hand-read coordinate can be
    converted the same way.
"""
import json, os, re, shutil, struct, subprocess, sys, time

GAME_DIR = os.path.expanduser("~/GeneralsX/GeneralsZH")
LOG = os.path.join(GAME_DIR, "logs", "latest.log")
CLICLICK = shutil.which("cliclick")


def png_size(path):
    with open(path, "rb") as f:
        return struct.unpack(">II", f.read(24)[16:24])


def capture(out, width=900):
    """Full-screen grab, downscaled for reading. Returns (physical, scaled, scale)."""
    subprocess.run(["screencapture", "-x", "-D", "1", "-t", "png", out], check=True)
    phys = png_size(out)
    small = out.replace(".png", "_s.png")
    subprocess.run(["sips", "-Z", str(width), out, "--out", small],
                   check=True, capture_output=True)
    return phys, png_size(small), small


_SCALE = None


def logical_scale():
    """Physical pixels per logical point on the MAIN display.

    Measured, not assumed — this machine has a 2x Retina panel and two 1x externals, so a
    hardcoded 2 is right on one display and wrong on the others.

    It deliberately does NOT ask Finder. `osascript -e 'tell application "Finder" to get
    bounds of window of desktop'` is the usual recipe and it HUNG this tool: AppleScript
    blocks on an app that is busy or not scriptable at that moment, with no timeout, and an
    agent waiting on it just stops. system_profiler is slower and answers unconditionally.
    """
    global _SCALE
    if _SCALE is not None:
        return _SCALE
    out = subprocess.run(["system_profiler", "SPDisplaysDataType", "-json"],
                         capture_output=True, text=True, timeout=30).stdout
    for gpu in json.loads(out).get("SPDisplaysDataType", []):
        for m in gpu.get("spdisplays_ndrvs", []):
            lw = int(re.match(r"\s*(\d+)", m.get("_spdisplays_resolution", "")).group(1))
            phys = re.search(r"(\d+)x\d+", m.get("spdisplays_pixelresolution", "") or "")
            _SCALE = (int(phys.group(1)) / lw) if phys else 1.0
            return _SCALE
    _SCALE = 1.0
    return _SCALE


def require_cliclick():
    if not CLICLICK:
        sys.exit("cliclick not installed:  brew install cliclick")
    probe = subprocess.run([CLICLICK, "p"], capture_output=True, text=True)
    if "Accessibility" in probe.stderr:
        sys.exit(
            "cliclick lacks Accessibility. Grant it to the process that RUNS it — for an\n"
            "agent session that is the claude binary itself, not Terminal:\n"
            f"  {os.path.realpath('/proc/self/exe') if os.path.exists('/proc/self/exe') else 'see: ps -o args= -p <ppid>'}\n"
            "System Settings > Privacy & Security > Accessibility > + > Cmd+Shift+G > path")


def wait_for_log(pattern, timeout=90, since=0):
    """Block until a regex appears in the engine log. This is the honest alternative to
    sleeping a guessed number of seconds: boot time varies with disk cache by a factor of
    three, and a fixed sleep is either slow or flaky, usually both."""
    rx = re.compile(pattern)
    deadline = time.time() + timeout
    while time.time() < deadline:
        if os.path.exists(LOG):
            with open(LOG, "rb") as f:
                f.seek(since)
                for line in f.read().decode("latin-1", "replace").splitlines():
                    if rx.search(line):
                        return line
        time.sleep(0.5)
    return None


def cmd_shot(a):
    phys, small, path = capture(a.out, a.width)
    scale = phys[0] / small[0]
    print(f"  {path}  physical {phys[0]}x{phys[1]}  scaled {small[0]}x{small[1]}")
    print(f"  multiply a coordinate read off the scaled image by {scale:.3f} for physical,")
    print(f"  by {scale / logical_scale():.3f} for the LOGICAL points cliclick wants")


def cmd_click(a):
    require_cliclick()
    # Input is in SCALED-IMAGE coordinates, because that is what a coordinate read off a
    # screenshot actually is. Converting here means no call site ever has to remember.
    s = logical_scale()
    phys, small, _ = capture("/tmp/_zhdrive_click.png", a.width)
    f = (phys[0] / small[0]) / s
    x, y = round(a.x * f), round(a.y * f)
    print(f"  click ({a.x},{a.y}) in a {small[0]}px image -> logical ({x},{y})")
    subprocess.run([CLICLICK, f"m:{x},{y}"], check=True)
    time.sleep(0.15)
    subprocess.run([CLICLICK, f"c:{x},{y}"], check=True)


def cmd_key(a):
    require_cliclick()
    subprocess.run([CLICLICK, f"kp:{a.name}"], check=True)


def cmd_wait(a):
    line = wait_for_log(a.pattern, a.timeout)
    if line is None:
        print(f"  TIMEOUT after {a.timeout}s waiting for /{a.pattern}/")
        return 1
    print(f"  {line.strip()[:160]}")
    return 0


def cmd_log(a):
    if not os.path.exists(LOG):
        sys.exit(f"no log at {LOG} — launch with ./run-logged.sh")
    text = open(LOG, "rb").read().decode("latin-1", "replace")
    if a.errors:
        rx = r"ERROR|exception|FAIL|Missing|not found|Unknown"
        hits = [l for l in text.splitlines() if re.search(rx, l, re.I)]
        seen, out = set(), []
        for h in hits:
            k = re.sub(r"[0-9]+", "N", h)
            if k not in seen:
                seen.add(k)
                out.append(h)
        print(f"  {len(hits)} error-ish lines, {len(out)} distinct shapes")
        for h in out[:a.limit]:
            print("   ", h.strip()[:170])
        return 0
    if a.dirs:
        d = sorted(set(re.findall(r"load(?:File)?Directory\('Data.INI.([A-Za-z]+)'\)", text)))
        print(f"  {len(d)} additive directories scanned by THIS build:")
        print("   ", " ".join(d))
        return 0
    for line in text.splitlines():
        if re.search(a.pattern, line):
            print("  " + line.strip()[:170])
    return 0


# --- the game's OWN coordinate space -------------------------------------------------------
# Hardcoding screen coordinates is what made the first hand-driven run fragile: the window
# moves, the display changes, and every target silently points at the wrong thing. The window
# content is exactly 800x600 — the same space ControlBarScheme authors in
# (ScreenCreationRes X:800 Y:600) — so a target expressed there is stable no matter where the
# window sits, and can be read straight off retail's own UI layouts.

GAME_W, GAME_H = 800, 600
TITLEBAR = 32   # window is 800x632; the extra is the macOS title bar above the content


_WIN_CACHE = None


def window(timeout=90, refresh=False):
    """Content-area origin and size of the game window, in logical points.

    RETRIED, not asked once: System Events blocks and then times out while the game is still
    loading — the window exists but the process is not answering AX queries yet — and a single
    call is the difference between a driver that works from a warm start and one that dies on
    a cold one. Cached because every pixel probe needs it and the window rarely moves.
    """
    global _WIN_CACHE
    if _WIN_CACHE and not refresh:
        return _WIN_CACHE
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            out = subprocess.run(
                ["osascript", "-e",
                 'tell application "System Events" to tell process "GeneralsXZH" '
                 'to get {position, size} of window 1'],
                capture_output=True, text=True, timeout=8)
            if out.returncode == 0 and out.stdout.strip():
                x, y, w, h = (int(v) for v in out.stdout.strip().split(", "))
                _WIN_CACHE = (x, y + TITLEBAR, w, h - TITLEBAR)
                return _WIN_CACHE
        except subprocess.TimeoutExpired:
            pass
        time.sleep(2)
    sys.exit("game window never answered — is GeneralsXZH running, and Accessibility granted?")


def to_screen(gx, gy):
    wx, wy, ww, wh = window()
    return round(wx + gx * ww / GAME_W), round(wy + gy * wh / GAME_H)


# Dead centre of the play area. The cursor is PARKED here after every click, and that is not
# tidiness: an RTS scrolls the camera whenever the pointer rests near a screen edge, and the
# driver leaves the pointer wherever it last clicked. A build button at the bottom of the
# command bar sits inside the scroll margin, so clicking one and then thinking for thirty
# seconds silently pans the world out from under every subsequent world-space coordinate.
# This was diagnosed after a factory wandered off the top of the screen between two commands.
PARK = (400, 300)


def ui_click(gx, gy, settle=1.2, park=True):
    """Click a point in the game's 800x600 UI space, then park the cursor off the edges."""
    x, y = to_screen(gx, gy)
    subprocess.run([CLICLICK, f"m:{x},{y}"], check=True)
    time.sleep(0.2)
    subprocess.run([CLICLICK, f"c:{x},{y}"], check=True)
    if park:
        px, py = to_screen(*PARK)
        subprocess.run([CLICLICK, f"m:{px},{py}"], check=True)
    time.sleep(settle)
    return x, y


# Targets in 800x600 game space, measured from a real session rather than guessed.
UI = {
    "solo_play": (643, 132),
    "skirmish":  (642, 293),
    "play_game": (180, 530),
    "back":      (643, 374),
    "build_1":   (248, 514),   # first build button in the command bar
}


def pixel(gx, gy):
    """RGB at a point in the game's 800x600 space.

    The engine logs menu layout pushes but nothing about the intro MOVIE, and the movie
    swallows input until it is dismissed — so there is no log signal for "the menu is
    interactive now" and the screen is the only source of truth. Sleeping a guess instead is
    what made the first scripted run fire all three clicks into the intro.

    PNG needs a decoder; BMP does not. sips converts, and the pixel is three bytes at the
    header's stated offset.
    """
    wx, wy, ww, wh = window()
    x = round(wx + gx * ww / GAME_W)
    y = round(wy + gy * wh / GAME_H)
    subprocess.run(["screencapture", "-x", "-R", f"{x},{y},2,2", "-t", "png", "/tmp/_zhpx.png"],
                   check=True)
    subprocess.run(["sips", "-s", "format", "bmp", "/tmp/_zhpx.png", "--out", "/tmp/_zhpx.bmp"],
                   check=True, capture_output=True)
    d = open("/tmp/_zhpx.bmp", "rb").read()
    off = struct.unpack_from("<I", d, 10)[0]
    return d[off + 2], d[off + 1], d[off]


def wait_pixel(gx, gy, test, timeout=60, poke=None, desc=""):
    """Poll a pixel until `test(rgb)` passes, optionally doing `poke()` each round."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        rgb = pixel(gx, gy)
        if test(rgb):
            return rgb
        if poke:
            poke()
        time.sleep(1.0)
    sys.exit(f"  TIMEOUT waiting for {desc or f'pixel {gx},{gy}'} (last rgb={pixel(gx, gy)})")


def cmd_pixel(a):
    print(f"  game({a.x},{a.y}) rgb={pixel(a.x, a.y)}")


def cmd_ui(a):
    require_cliclick()
    gx, gy = UI[a.target] if a.target in UI else (int(a.target.split(",")[0]),
                                                  int(a.target.split(",")[1]))
    print(f"  {a.target} -> game({gx},{gy}) -> screen{ui_click(gx, gy)}")


def column(gx, y0=100, y1=430):
    """Every pixel down a 1-point-wide strip of the game's UI, as [(y, (r,g,b))].

    ONE screencapture, not one per pixel: probing points individually costs ~0.3s each, so a
    300-row profile would take a minute and a half. BMP because PNG needs a decoder.
    """
    wx, wy, ww, wh = window()
    x = round(wx + gx * ww / GAME_W)
    ytop = round(wy + y0 * wh / GAME_H)
    ybot = round(wy + y1 * wh / GAME_H)
    subprocess.run(["screencapture", "-x", "-R", f"{x},{ytop},1,{ybot - ytop}",
                    "-t", "png", "/tmp/_zhcol.png"], check=True)
    subprocess.run(["sips", "-s", "format", "bmp", "/tmp/_zhcol.png",
                    "--out", "/tmp/_zhcol.bmp"], check=True, capture_output=True)
    return _bmp_rows("/tmp/_zhcol.bmp", y0, y1)


def _bmp_rows(path, y0, y1):
    """Decode a BMP strip into [(y, rgb)], RESPECTING the row order.

    A negative height means top-down, and sips writes top-down. Assuming bottom-up mirrors
    every read vertically — which stayed invisible for a long time because the first consumer
    only COUNTED cyan runs, and a mirrored column has exactly as many. It surfaced only when a
    search for the tallest building on screen kept returning a point near the bottom.
    """
    d = open(path, "rb").read()
    off = struct.unpack_from("<I", d, 10)[0]
    w, h = struct.unpack_from("<ii", d, 18)
    top_down = h < 0
    h = abs(h)
    bypp = struct.unpack_from("<H", d, 28)[0] // 8
    stride = ((w * bypp + 3) // 4) * 4
    out = []
    for row in range(h):
        o = off + (row if top_down else h - 1 - row) * stride
        out.append((y0 + (y1 - y0) * row / h, (d[o + 2], d[o + 1], d[o])))
    return out


def menu_buttons(gx=643):
    """How many shell buttons are stacked in the menu column.

    Counting is what makes menu detection robust. A single probe point encodes a guess about
    the LAYOUT — where a row happens to fall — and the main menu (6 buttons) and the Solo Play
    submenu (7) are offset from each other, so one screen's text pixel is the next screen's
    border. The border cyan is unique on screen, so counting its runs identifies the menu
    regardless of where it sits.
    """
    runs, prev = 0, False
    for _, (r, g, b) in column(gx):
        cyan = b > 180 and g > 120 and r < 80
        if cyan and not prev:
            runs += 1
        prev = cyan
    # Each button draws a top AND a bottom border, so the runs come in pairs — the main menu
    # profiles as 12, not 6. Counting runs directly is off by exactly 2x, which is the kind of
    # error that looks like a plausible button count and silently matches the wrong screen.
    return round(runs / 2)


def focus_game(timeout=30):
    """Raise the game window and CONFIRM it is frontmost."""
    deadline = time.time() + timeout
    while time.time() < deadline:
        # Both calls are wrapped: System Events blocks and then times out while the game is
        # mid-load, and an unhandled TimeoutExpired kills the whole drive at the one moment
        # it is most likely to happen — the first attempt on a cold start.
        try:
            subprocess.run(["osascript", "-e",
                            'tell application "System Events" to set frontmost of '
                            'process "GeneralsXZH" to true'], capture_output=True, timeout=10)
            time.sleep(0.8)
            who = subprocess.run(
                ["osascript", "-e", 'tell application "System Events" to return name of '
                                    'first process whose frontmost is true'],
                capture_output=True, text=True, timeout=10).stdout.strip()
            if who == "GeneralsXZH":
                return True
        except subprocess.TimeoutExpired:
            pass
        time.sleep(1.5)
    sys.exit("  could not bring the game to the front")


def log_size():
    return os.path.getsize(LOG) if os.path.exists(LOG) else 0


def shell_is_up():
    """Any shell menu is showing. The button borders are a saturated cyan nothing else uses."""
    r, g, b = pixel(643, 150)
    return b > 180 and g > 120 and r < 80


MAIN_MENU_BUTTONS = 6      # SOLO PLAY, MULTIPLAYER, LOAD, OPTIONS, CREDITS, EXIT GAME
SOLO_MENU_BUTTONS = 7      # USA, GLA, CHINA, CHALLENGE, SKIRMISH, CUSTOM, BACK


def at_main_menu():
    """Specifically the TOP menu, not the Solo Play submenu and not Credits.

    Distinguishing them matters and cost two wasted runs to learn. Clicking Solo Play can
    silently fail, and the next click — aimed at SKIRMISH on the submenu — then lands on
    CREDITS on the still-showing main menu. Worse, esc does NOT back out of the submenu, so a
    retry that only presses esc waits forever on a screen it cannot leave.

    There is no log signal: Solo Play swaps the button set WITHIN MainMenu.wnd rather than
    pushing a layout, so the shell logs nothing at all.
    """
    return menu_buttons() == MAIN_MENU_BUTTONS


def region_grid(gx, gy, gw, gh, cols=64, rows=40):
    """A coarse grid of pixels over a rectangle of the game view, as [(gx, gy, (r,g,b))].

    One screencapture downscaled by sips, then read as BMP — the same trick as column(), in
    two dimensions. Sampling this by individual probes would be 2,560 screenshots.
    """
    x, y = to_screen(gx, gy)
    x2, y2 = to_screen(gx + gw, gy + gh)
    subprocess.run(["screencapture", "-x", "-R", f"{x},{y},{x2 - x},{y2 - y}",
                    "-t", "png", "/tmp/_zhgrid.png"], check=True)
    subprocess.run(["sips", "-z", str(rows), str(cols), "/tmp/_zhgrid.png",
                    "--out", "/tmp/_zhgrid_s.png"], check=True, capture_output=True)
    subprocess.run(["sips", "-s", "format", "bmp", "/tmp/_zhgrid_s.png",
                    "--out", "/tmp/_zhgrid.bmp"], check=True, capture_output=True)
    d = open("/tmp/_zhgrid.bmp", "rb").read()
    off = struct.unpack_from("<I", d, 10)[0]
    w, h = struct.unpack_from("<ii", d, 18)
    top_down = h < 0          # sips writes top-down; see _bmp_rows
    h = abs(h)
    bypp = struct.unpack_from("<H", d, 28)[0] // 8
    stride = ((w * bypp + 3) // 4) * 4
    out = []
    for ry in range(h):
        o0 = off + (ry if top_down else h - 1 - ry) * stride
        for rx in range(w):
            o = o0 + rx * bypp
            out.append((gx + gw * (rx + 0.5) / w, gy + gh * (ry + 0.5) / h,
                        (d[o + 2], d[o + 1], d[o])))
    return out


def find_structure():
    """Locate the player's starting building on screen, by COLOUR rather than coordinate.

    The start position is randomised per match — the same map put the factory at game (512,139)
    one run and (297,165) the next — so any hardcoded coordinate is right about half the time
    and silently selects empty ground the rest. The authored mesh is strongly blue and the
    desert terrain is tan, so the building is the bluest thing in the world view by a wide
    margin. Returns the centroid of the bluest cluster, or None.
    """
    # y stops at 350, well clear of the command bar. The bar's own cyan outline is a near
    # perfect match for the authored mesh's teal — it was the "bluest thing on screen" on the
    # first attempt, and the search happily selected a point on the HUD.
    samples = region_grid(40, 60, 720, 290)
    best = max(samples, key=lambda s: s[2][2] - s[2][0])
    x, y, c = best
    if c[2] - c[0] < 40:
        return None
    # The PEAK, not a centroid. A weighted centroid was the first attempt and it read 150
    # game-units low: the unlit map border is dark blue too, and there is far more of it than
    # there is building, so the mass dragged the answer onto empty ground.
    return round(x), round(y)


def cmd_find(a):
    where = find_structure()
    print(f"  structure at game {where}" if where else "  no structure found")


def region_digest(gx, gy, gw, gh):
    """A cheap hash of a rectangle of the UI, in game space.

    For asserting that something CHANGED when the exact value cannot be read. The money
    readout is rendered text and there is no OCR here, but "the number is different after
    clicking build" is the assertion that actually matters: it proves the button is live and
    the order was accepted. Comparing a digest is honest about what it checks — it cannot say
    the cost was 800, only that a cost was charged.
    """
    x, y = to_screen(gx, gy)
    x2, y2 = to_screen(gx + gw, gy + gh)
    subprocess.run(["screencapture", "-x", "-R", f"{x},{y},{x2 - x},{y2 - y}",
                    "-t", "png", "/tmp/_zhreg.png"], check=True)
    return hash(open("/tmp/_zhreg.png", "rb").read())


def saturated(rgb):
    """An authored icon cell: vivid. A blank tile or an unlit panel is dark and grey, which is
    exactly what a MappedImage whose texture failed to load renders as — with no error."""
    r, g, b = rgb
    return max(rgb) > 150 and (max(rgb) - min(rgb)) > 60


# In-match targets, measured with the factory selected at the start position.
MATCH = {
    "factory":  (512, 139),   # the player's starting structure, centred by the initial camera
    "build_1":  (248, 514),
    "portrait": (630, 505),
    "money":    (360, 437, 80, 18),
}


def cmd_verify_pack(a):
    """Assert that a compiled pack is PLAYABLE, not merely parseable.

    Every check here corresponds to a failure that actually shipped and was found by a human
    noticing something in a match: blank command-bar tiles, a build button that renders and
    does nothing, a portrait that silently falls back to nothing at all.
    """
    require_cliclick()
    focus_game()
    fails = []

    # Selecting can miss, and a missed click looks EXACTLY like broken icons — an unlit
    # portrait either way. Retry the selection before believing the pack is at fault, or the
    # gate reports a content bug for an input one.
    portrait = button = (0, 0, 0)
    for sel in range(1, 4):
        where = find_structure()
        if where is None:
            print("  FAIL: no structure visible — the match did not start as expected")
            return 1
        ui_click(*where, settle=2.0)
        portrait = pixel(*MATCH["portrait"])
        button = pixel(*MATCH["build_1"])
        if saturated(portrait) or saturated(button):
            print(f"  selected the structure at game {where}")
            break
        print(f"  selection attempt {sel} found nothing lit, retrying")

    if not saturated(portrait):
        fails.append(f"SelectPortrait did not resolve: portrait is {portrait}, an unlit panel. "
                     f"A MappedImage whose texture is missing renders exactly like this.")
    else:
        print(f"  portrait is an authored icon {portrait}")

    if not saturated(button):
        fails.append(f"CommandButton ButtonImage did not resolve: build slot is {button}")
    else:
        print(f"  build button is an authored icon {button}")

    if saturated(portrait) and saturated(button):
        # Distinct hues are the point of the sheet's golden-ratio stepping: two entries
        # pointing at ONE cell is otherwise invisible.
        if max(abs(p - q) for p, q in zip(portrait, button)) < 40:
            fails.append(f"portrait {portrait} and button {button} are the same colour — "
                         f"two MappedImages are addressing one cell")
        else:
            print("  the two icons address different cells")

    before = region_digest(*MATCH["money"])
    ui_click(*MATCH["build_1"], settle=3.0)
    after = region_digest(*MATCH["money"])
    if before == after:
        fails.append("clicking build charged nothing: the button renders and does nothing, "
                     "which is what a missing ProductionUpdate looks like")
    else:
        print("  clicking build charged the player — production accepted the order")

    for f in fails:
        print(f"  FAIL: {f}")
    return 1 if fails else 0


def cmd_skirmish(a):
    """Launch and drive all the way into a running match.

    Every step is CONFIRMED before the next one runs. The first scripted version slept fixed
    intervals and fired all three clicks into the intro movie, reporting "in match (probably)"
    — which was honest and useless. A click that silently does nothing is the normal failure
    here, not the exceptional one.
    """
    require_cliclick()
    if subprocess.run(["pgrep", "-x", "GeneralsXZH"], capture_output=True).returncode != 0:
        print("  launching...")
        # -quickstart = -nologo + -noshellmap + no window animation. parseNoLogo sets
        # m_playIntro=FALSE, which is the supported way to skip the intro movie — pressing
        # esc at it was always a workaround, and it is what made the first drives flaky.
        subprocess.Popen(["./run-logged.sh", "-win", "-quickstart"], cwd=GAME_DIR,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if not wait_for_log(r"TheGameResultsQueue.*END", timeout=180):
            sys.exit("  boot never completed")
        print("  booted")

    for attempt in range(1, 5):
        # Focus FIRST, every attempt. macOS eats the first click on an unfocused window to
        # activate it — which is why attempt 1 failed every single run, deterministically
        # rather than flakily, and that determinism is the tell. Doing it once before the
        # loop is not enough: this raise silently no-ops if the game is still loading, and
        # anything that steals focus mid-drive (a browser, a notification) puts every
        # subsequent click and PIXEL READ onto the wrong window — the reads are the nastier
        # half, because they return another app's colours rather than failing.
        focus_game()
        # Re-establish a KNOWN state before every attempt. esc backs out of a submenu or the
        # credits screen; without this the retry compounds a missed click into a wrong one.
        # esc leaves Credits and Options but NOT the Solo Play submenu, which only has a
        # BACK button. Poke with whichever the current screen actually responds to.
        def back_out():
            if menu_buttons() == SOLO_MENU_BUTTONS:
                ui_click(*UI["back"], settle=1.0)
            else:
                subprocess.run([CLICLICK, "kp:esc"], check=True)

        deadline = time.time() + 60
        while not at_main_menu():
            if time.time() > deadline:
                sys.exit(f"  stuck: {menu_buttons()} buttons on screen, expected "
                         f"{MAIN_MENU_BUTTONS}")
            back_out()
            time.sleep(1.0)
        ui_click(*UI["solo_play"], settle=2.0)
        mark = log_size()
        ui_click(*UI["skirmish"], settle=1.0)
        if wait_for_log(r"SkirmishGameOptionsMenu\.wnd", timeout=15, since=mark):
            print(f"  at the skirmish setup screen (attempt {attempt})")
            break
        print(f"  attempt {attempt}: clicks did not land, backing out and retrying")
    else:
        sys.exit("  never reached the skirmish screen")

    ui_click(*UI["play_game"], settle=2.0)
    # Leaving the shell is the signal a match started: the menu cyan is gone and stays gone.
    gone = 0
    deadline = time.time() + 90
    while time.time() < deadline and gone < 3:
        gone = gone + 1 if not shell_is_up() else 0
        time.sleep(1.0)
    if gone < 3:
        sys.exit("  still in the shell — the match never started")
    time.sleep(6)
    capture("/tmp/zhdrive_match.png")
    print("  IN MATCH — /tmp/zhdrive_match_s.png")
    return 0


